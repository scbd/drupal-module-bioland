{
    "name": "scbd/bioland",
    "version": "1.0.12",
    "description": "Bioland Drupal module: field visibility, additional fields, auto summary, translation defaults.",
    "type": "drupal-module",
    "license": "MIT",
    "keywords": [
        "drupal",
        "module",
        "bioland",
        "scbd",
        "fields",
        "summary"
    ],
    "homepage": "https://github.com/scbd/drupal-module-bioland",
    "support": {
        "issues": "https://github.com/scbd/drupal-module-bioland/issues",
        "source": "https://github.com/scbd/drupal-module-bioland"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\bioland\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\": "tests/stubs/Drupal/",
            "Drupal\\Tests\\bioland\\Unit\\": "tests/Unit/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-0.0.1-alpha": "0.0.x-dev"
        }
    }
}