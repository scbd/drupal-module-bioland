<?php

/**
 * @file
 * Main module file for Drupal Module Bioland.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\bioland\Form\BiolandComponentMenuLinkForm;
use Drupal\bioland\Service\BiolandComponentMenuFormMode;

/**
 * Implements hook_menu_links_discovered_alter().
 *
 * Hides auto_node_translate menu items from the admin menu.
 */
function bioland_menu_links_discovered_alter(&$links) {
  // Menu items to hide (system-defined menu links).
  $menus_to_hide = [
    'auto_node_translate.translators',
    'auto_node_translate_amazon.settings',
    'auto_node_translate_deepl.settings',
    'auto_node_translate.my_memory_settings',
  ];
  
  foreach ($menus_to_hide as $menu_id) {
    if (isset($links[$menu_id])) {
      // Remove the menu link from discovery.
      unset($links[$menu_id]);
    }
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Attaches the bulk actions hiding JS for contributor role users
 * and home widget settings to all pages.
 */
function bioland_page_attachments(array &$attachments) {
  // Always attach the library - JavaScript will check user roles and hide appropriately
  $attachments['#attached']['library'][] = 'bioland/hide_bulk_actions';
  
  // Attach home widgets library to make settings available frontend-wide
  $attachments['#attached']['library'][] = 'bioland/home_widgets';
  
  // Pass current user roles to JavaScript
  $current_user = \Drupal::currentUser();
  $roles = $current_user->getRoles();
  
  $attachments['#attached']['drupalSettings']['user']['roles'] = $roles;
  
  // Attach home widget settings (with country map defaults) to all pages
  $settingsManager = \Drupal::service('bioland.settings_manager');
  $homeWidgetSettings = $settingsManager->getHomeWidgetSettings();
  $attachments['#attached']['drupalSettings']['bioland']['homeWidgets'] = $homeWidgetSettings;
}

/**
 * Implements hook_form_alter().
 *
 * Adds comprehensive SCBD field functionality based on settings.
 */
function bioland_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Hide Lolspeak from translation overview for non-administrators.
  if ($form_id === 'content_translation_overview') {
    $current_user = \Drupal::currentUser();
    if (!$current_user->hasPermission('administer site configuration')) {
      if (isset($form['languages']['en-x-lolspeak'])) {
        $form['languages']['en-x-lolspeak']['#access'] = FALSE;
      }
    }
  }

  // Hide Lolspeak from auto-translate form for non-administrators.
  if ($form_id === 'auto_node_translate_form') {
    $current_user = \Drupal::currentUser();
    if (!$current_user->hasPermission('administer site configuration')) {
      if (isset($form['languages']['en-x-lolspeak'])) {
        unset($form['languages']['en-x-lolspeak']);
      }
    }
  }

  // Hide Lolspeak from language selectors in entity forms for non-administrators.
  $current_user = \Drupal::currentUser();
  if (!$current_user->hasPermission('administer site configuration')) {
    // Check for language selection fields and remove Lolspeak option.
    if (isset($form['langcode']['widget'][0]['value']['#options']['en-x-lolspeak'])) {
      unset($form['langcode']['widget'][0]['value']['#options']['en-x-lolspeak']);
    }
    
    // Also check for content_translation_language_widget.
    if (isset($form['content_translation']['widget'][0]['value']['#options']['en-x-lolspeak'])) {
      unset($form['content_translation']['widget'][0]['value']['#options']['en-x-lolspeak']);
    }
  }

  // Get the field functionality manager service
  $fieldFunctionalityManager = \Drupal::service('bioland.field_functionality_manager');

  // Handle menu link content forms - add custom submit handler for cache busting.
  if (strpos($form_id, 'menu_link_content_') === 0) {
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#submit'][] = 'bioland_menu_link_form_submit';
    }
    
    // Hide menu_parent field on translation forms (non-source language).
    // Menu structure should only be managed from the source language.
    // This applies to:
    // 1. Translation add forms: /fr/admin/structure/menu/item/190/edit/translations/add/en/fr
    // 2. Editing in non-source language: /nl/admin/structure/menu/item/190/edit
    $hide_menu_parent = FALSE;
    
    // Check if this is a content_translation_add form (always a translation).
    $route_name = \Drupal::routeMatch()->getRouteName();
    if ($route_name && strpos($route_name, 'content_translation_add') !== FALSE) {
      $hide_menu_parent = TRUE;
    }
    else {
      // Check if we're editing in a non-source language.
      $form_object = $form_state->getFormObject();
      if ($form_object && method_exists($form_object, 'getEntity')) {
        $entity = $form_object->getEntity();
        if ($entity) {
          // Method 1: Check isDefaultTranslation if available.
          if (method_exists($entity, 'isDefaultTranslation') && !$entity->isDefaultTranslation()) {
            $hide_menu_parent = TRUE;
          }
          // Method 2: Compare current language with entity's source language.
          elseif (method_exists($entity, 'getUntranslated')) {
            $current_langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
            $source_langcode = $entity->getUntranslated()->language()->getId();
            if ($current_langcode !== $source_langcode) {
              $hide_menu_parent = TRUE;
            }
          }
        }
      }
    }
    
    if ($hide_menu_parent) {
      // Hide menu_parent dropdown.
      if (isset($form['menu_parent'])) {
        $form['menu_parent']['#access'] = FALSE;
      }
      // Hide display settings (weight, expanded checkbox).
      if (isset($form['menu_link_display_settings'])) {
        $form['menu_link_display_settings']['#access'] = FALSE;
      }
    }

    // Mega-menu Component mode. The service owns the single dispatcher; it
    // declines every form reachable today (the "component" form operation does
    // not exist yet and BiolandComponentMenuFormMode::EDIT_DETECTION is FALSE),
    // so this call is inert and regular menu link forms stay byte-identical.
    //
    // ORDERING PIN - do not move this into a form class's form() method.
    // menu_link_attributes' entity builder rebuilds
    // link.options.attributes from its own form values on every save, so the
    // bioland builder that merges the picked component token back MUST be
    // registered after it. bioland_module_implements_alter() below moves this
    // hook_form_alter last, after menu_link_attributes' base-form alter, and
    // #entity_builders run in array order - so appending from here, and only
    // from here, is what guarantees the token survives the save. A form()
    // method runs before all alters and would lose it silently. Pinned by
    // BiolandComponentMenuFormModeTest.
    $bioland_component_mode = \Drupal::service('bioland.component_menu_form_mode');
    if ($bioland_component_mode->applies($form_state)) {
      $bioland_component_mode->apply($form, $form_state);
    }
  }

  // Change "Save (this translation)" to just "Save" for all node content forms.
  // This must happen during form build (hook_form_alter), NOT in #after_build:
  // Drupal matches the submitted "op" value against the button's build-time
  // #value to determine the triggering element. Renaming in #after_build only
  // changed the rendered label, so on edit forms the browser submitted
  // op="Save" while the build-time value was "Save (this translation)" - no
  // match, the media-library button became the trigger, and the form silently
  // rebuilt without saving. bioland_module_implements_alter() moves this hook
  // after content_translation's so the rename sticks.
  if (strpos($form_id, 'node_content_') === 0 || $form_id === 'node_content_form') {
    if (isset($form['actions']['submit']['#value'])) {
      $form['actions']['submit']['#value'] = t('Save');
    }
  }

  // Only attach to node_content_form and node_content_edit_form.
  if (!in_array($form_id, ['node_content_form', 'node_content_edit_form'])) {
    return;
  }

  // Align the CKEditor 5 editing surface with the public (Nuxt) frontend:
  // heading sizes and the primary-coloured underline on h3/h4/h5. CKEditor 5
  // renders inline in the page DOM, so a stylesheet scoped to .ck-content
  // styles the live editing area. Fonts are intentionally left untouched.
  $form['#attached']['library'][] = 'bioland/ckeditor_content_styles';

  // The underline colour is the per-site primary, which a shared CSS file
  // cannot know, so the stylesheet bakes in a default and this overrides it.
  // primaryColor() has already validated the value down to six hex digits and
  // fallen back to this flavor's network default, so nothing arbitrary from
  // config reaches the style element. Emitted unconditionally rather than only
  // when it differs from the baked-in default: one always-present declaration
  // is cheaper to reason about than a comparison against a literal duplicated
  // out of the CSS file.
  //
  // The selector MUST out-specify the stylesheet's `.ck.ck-content` (0,2,0):
  // html_head renders at <head-placeholder>, BEFORE <css-placeholder>, in
  // core, Claro and default_admin html.html.twig alike, so at equal
  // specificity the later library stylesheet wins and this override would be
  // inert. `body .ck.ck-content` (0,2,1) wins deterministically regardless of
  // head order.
  $bioland_primary = \Drupal::service('bioland.component_menu_form_mode')->primaryColor();
  $form['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'style',
      '#value' => 'body .ck.ck-content{--bs-primary:' . $bioland_primary . ';}',
    ],
    'bioland-ckeditor-primary',
  ];

  // Defensive cache metadata: the style above is read from bioland.settings,
  // so a cached copy of this form must be invalidated by a Theme tab save.
  // Today the form is never dynamic-page-cached anyway (the CSRF form_token
  // carries max-age 0 for authenticated users), so this is cheap insurance,
  // not a live dependency. Same precedent as
  // BiolandComponentMenuFormMode::apply().
  $form['#cache']['tags'][] = 'config:bioland.settings';

  // Add custom submit handler to redirect with query parameter.
  $form['actions']['submit']['#submit'][] = 'bioland_node_content_form_submit';

  // Gather JS settings to know which features are enabled.
  $jsSettings = $fieldFunctionalityManager->getJavaScriptSettings();

  $anyAttached = FALSE;

  // Attach libraries per feature based on settings.
  if (!empty($jsSettings['enableFieldVisibility'])) {
    $form['#attached']['library'][] = 'bioland/field_visibility';
    $anyAttached = TRUE;
  }

  if (!empty($jsSettings['enableAdditionalFields'])) {
    $form['#attached']['library'][] = 'bioland/additional_fields';
    $anyAttached = TRUE;
  }

  if (!empty($jsSettings['enableAutoSummary'])) {
    $form['#attached']['library'][] = 'bioland/auto_summary';
    $anyAttached = TRUE;
  }

  if (!empty($jsSettings['enableHelpComments'])) {
    $form['#attached']['library'][] = 'bioland/help_comments';
    $anyAttached = TRUE;
  }

  // Pass settings to JavaScript if any feature is attached.
  if ($anyAttached) {
    $form['#attached']['drupalSettings']['bioland'] = $jsSettings;
  }

  // Ensure the advanced sidebar exists for our custom elements.
  if (!isset($form['advanced'])) {
    $form['advanced'] = [
      '#type' => 'vertical_tabs',
      '#weight' => 99,
    ];
  }

  // Move langcode field to the sidebar (advanced group).
  if (isset($form['langcode'])) {
    // Hide the default langcode field position.
    $form['langcode']['#access'] = FALSE;
    
    // Try to get language options from the widget, or fall back to language manager.
    $langcode_options = NULL;
    $default_langcode = NULL;
    
    // Try structure: langcode[widget][0][value] (standard language_select widget).
    if (isset($form['langcode']['widget'][0]['value']['#options'])) {
      $langcode_options = $form['langcode']['widget'][0]['value']['#options'];
      $default_langcode = $form['langcode']['widget'][0]['value']['#default_value'] ?? NULL;
    }
    // Try structure: langcode[widget][0] directly (some widget configurations).
    elseif (isset($form['langcode']['widget'][0]['#options'])) {
      $langcode_options = $form['langcode']['widget'][0]['#options'];
      $default_langcode = $form['langcode']['widget'][0]['#default_value'] ?? NULL;
    }
    // Try structure: langcode[widget] directly.
    elseif (isset($form['langcode']['widget']['#options'])) {
      $langcode_options = $form['langcode']['widget']['#options'];
      $default_langcode = $form['langcode']['widget']['#default_value'] ?? NULL;
    }
    // Fallback: get languages from the language manager.
    else {
      $language_manager = \Drupal::languageManager();
      $languages = $language_manager->getLanguages();
      $langcode_options = [];
      foreach ($languages as $langcode => $language) {
        $langcode_options[$langcode] = $language->getName();
      }
      // Get default from the entity or current language.
      $entity = $form_state->getFormObject()->getEntity();
      if ($entity && method_exists($entity, 'language')) {
        $default_langcode = $entity->language()->getId();
      }
      else {
        $default_langcode = $language_manager->getCurrentLanguage()->getId();
      }
    }

    // Re-create the language select in the sidebar if we have options.
    if (!empty($langcode_options)) {
      // Create a language selection wrapper in the sidebar.
      $form['language_selection_wrapper'] = [
        '#type' => 'details',
        '#title' => t('Language'),
        '#group' => 'advanced',
        '#weight' => -100,
        '#open' => FALSE,
        '#attributes' => ['class' => ['bioland-language-wrapper']],
      ];

      $form['language_selection_wrapper']['langcode_select'] = [
        '#type' => 'select',
        '#title' => t('Content language'),
        '#options' => $langcode_options,
        '#default_value' => $default_langcode,
        '#description' => t('Select the language for this content.'),
        '#attributes' => [
          'id' => 'bioland-langcode-select',
          'data-current-path' => \Drupal::request()->getPathInfo(),
        ],
      ];
      
      // Attach the language redirect library.
      $form['#attached']['library'][] = 'bioland/language_redirect';
    }
  }

  // Move field_order to the sidebar (advanced group) and rename it.
  if (isset($form['field_order'])) {
    $form['order_override_wrapper'] = [
      '#type' => 'details',
      '#title' => t('Order Override'),
      '#group' => 'advanced',
      '#weight' => 90, // Place above Promotion options (usually 95).
      '#open' => FALSE,
      '#optional' => TRUE,
    ];

    // Help text is added via JavaScript (bioland-help-comments-1-1-6.js)
    // to provide close button, cookie persistence, and info icon toggle.

    $form['field_order']['#group'] = 'order_override_wrapper';
  }

  // Wrap the meta section in a proper collapsible details element.
  // The meta section contains "Last saved" and "Author" information.
  if (isset($form['meta'])) {
    // Create a new wrapper for the meta content.
    $form['meta_wrapper'] = [
      '#type' => 'details',
      '#title' => t('Meta'),
      '#group' => 'advanced',
      '#weight' => isset($form['meta']['#weight']) ? $form['meta']['#weight'] : -99,
      '#open' => FALSE,
      '#attributes' => ['class' => ['bioland-meta-wrapper']],
    ];

    // Move meta content into the wrapper.
    $form['meta']['#group'] = 'meta_wrapper';
    // Remove the accordion class that prevents proper collapse behavior.
    if (isset($form['meta']['#attributes']['class'])) {
      $form['meta']['#attributes']['class'] = array_filter(
        (array) $form['meta']['#attributes']['class'],
        function ($class) {
          return strpos($class, 'accordion') === FALSE;
        }
      );
    }
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function bioland_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Change field_url label from "URL" or "Link" to just "URL".
  if (isset($form['field_url'])) {
    // Handle link field widget structure.
    if (isset($form['field_url']['widget'][0]['uri']['#title'])) {
      $form['field_url']['widget'][0]['uri']['#title'] = t('URL');
    }
    // Also try the top-level title for the field group.
    if (isset($form['field_url']['widget']['#title'])) {
      $form['field_url']['widget']['#title'] = t('URL');
    }
    // Try setting the field label directly.
    if (isset($form['field_url']['#title'])) {
      $form['field_url']['#title'] = t('URL');
    }
  }
}

/**
 * Implements hook_entity_type_alter().
 *
 * Registers the "component" entity-form operation on menu_link_content, which
 * is the activation signal for mega-menu Component mode. Until this ran, the
 * operation did not exist and BiolandComponentMenuFormMode::applies() could
 * never see it, leaving the whole mode inert.
 *
 * The registered class adds no behaviour of its own — see
 * BiolandComponentMenuLinkForm's docblock for why the mode must be applied at
 * form-alter time and never from a form class. Nothing here touches the
 * default operation, so core's "Add link" and edit forms are unchanged.
 *
 * @param \Drupal\Core\Entity\EntityTypeInterface[] $entity_types
 *   The entity type definitions, keyed by entity type id.
 *
 * @see \Drupal\bioland\Controller\BiolandMenuController::addComponentLink()
 */
function bioland_entity_type_alter(array &$entity_types) {
  $entity_type_id = BiolandComponentMenuFormMode::ENTITY_TYPE;
  if (isset($entity_types[$entity_type_id])) {
    $entity_types[$entity_type_id]->setFormClass(
      BiolandComponentMenuFormMode::OPERATION,
      BiolandComponentMenuLinkForm::class
    );
  }
}

/**
 * Implements hook_entity_insert().
 */
function bioland_entity_insert(EntityInterface $entity) {
  // Only process content entities.
  if (!$entity instanceof ContentEntityInterface) {
    return;
  }

  // Use the translation manager service to handle translation creation.
  \Drupal::service('bioland.translation_manager')->createTranslations($entity, 'insert');
}

/**
 * Implements hook_entity_update().
 */
function bioland_entity_update(EntityInterface $entity) {
  // Only process content entities.
  if (!$entity instanceof ContentEntityInterface) {
    return;
  }

  // Use the translation manager service to handle translation creation.
  \Drupal::service('bioland.translation_manager')->createTranslations($entity, 'update');
}

/**
 * Helper function to check if an entity is translatable.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to check.
 *
 * @return bool
 *   TRUE if the entity is translatable, FALSE otherwise.
 */
function bioland_entity_is_translatable(ContentEntityInterface $entity) {
  return $entity->isTranslatable();
}

/**
 * Helper function to get translatable field values from an entity.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to get values from.
 *
 * @return array
 *   Array of field values keyed by field name.
 */
function bioland_get_translatable_field_values(ContentEntityInterface $entity) {
  $values = [];

  foreach ($entity->getFieldDefinitions() as $field_name => $field_definition) {
    if ($field_definition->isTranslatable()) {
      $field_value = $entity->get($field_name)->getValue();
      if (!empty($field_value)) {
        $values[$field_name] = $field_value;
      }
    }
  }

  return $values;
}

/**
 * Helper function to check if an entity has SCBD thesaurus fields.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to check.
 *
 * @return bool
 *   TRUE if the entity has SCBD fields, FALSE otherwise.
 */
function bioland_entity_has_scbd_fields(ContentEntityInterface $entity) {
  foreach ($entity->getFieldDefinitions() as $field_definition) {
    if ($field_definition->getType() === 'scbd_field_thesaurus') {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Helper function to get SCBD field values from an entity.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to get values from.
 *
 * @return array
 *   Array of field values keyed by field name.
 */
function bioland_get_scbd_field_values(ContentEntityInterface $entity) {
  $values = [];

  foreach ($entity->getFieldDefinitions() as $field_name => $field_definition) {
    if ($field_definition->getType() === 'scbd_field_thesaurus') {
      $field_value = $entity->get($field_name)->getValue();
      if (!empty($field_value)) {
        $values[$field_name] = $field_value;
      }
    }
  }

  return $values;
}

/**
 * Implements hook_theme().
 *
 * Defines custom theme templates for Bioland.
 */
function bioland_theme() {
  return [
    'bioland_settings_summary' => [
      'variables' => [
        'locales' => [],
  'countries' => [],
        'region' => '',
        'field_functionality' => [],
      ],
      'template' => 'bioland-settings-summary',
    ],
  ];
}

/**
 * Implements hook_module_implements_alter().
 *
 * Moves bioland's hook_form_alter to run last so the Save-button relabel in
 * bioland_form_alter() overrides the "Save (this translation)" label that
 * content_translation sets during its own hook_form_alter. The relabel must
 * stay in the form-build phase (never #after_build) so the button's #value
 * matches the submitted "op" value when Drupal resolves the triggering
 * element - see bioland_form_alter().
 *
 * Running last is also the ordering guarantee the mega-menu Component mode
 * depends on: because menu_link_attributes' base-form alter has already
 * registered its entity builder by the time bioland_form_alter() runs, the
 * builder BiolandComponentMenuFormMode appends lands after it in
 * $form['#entity_builders'], which run in array order. That is what stops the
 * contrib builder's wholesale rebuild of link.options.attributes from
 * discarding the picked component token. Do not reorder this hook.
 */
function bioland_module_implements_alter(&$implementations, $hook) {
  if ($hook === 'form_alter' && isset($implementations['bioland'])) {
    $group = $implementations['bioland'];
    unset($implementations['bioland']);
    $implementations['bioland'] = $group;
  }
}

/**
 * Custom submit handler for node_content_form and node_content_edit_form.
 *
 * Adds ?seachain-taisce=true to the redirect URL.
 */
function bioland_node_content_form_submit($form, FormStateInterface $form_state) {
  // Get the entity from the form.
  $entity = $form_state->getFormObject()->getEntity();

  if ($entity) {
    // Create a URL object for the entity canonical page.
    $url = $entity->toUrl();

    // Add the query parameter.
    $options = $url->getOptions();
    $options['query']['seachain-taisce'] = (string) microtime(TRUE);
    $url->setOptions($options);

    // Set the redirect.
    $form_state->setRedirectUrl($url);
  }
}

/**
 * Custom submit handler for menu link content form.
 *
 * Adds ?seachain-taisce=<microtime> to the redirect URL for cache busting.
 * Redirects to the page the menu link points to.
 */
function bioland_menu_link_form_submit($form, FormStateInterface $form_state) {
  // Get the menu link entity.
  $menu_link = $form_state->getFormObject()->getEntity();

  if ($menu_link && $menu_link->getUrlObject()) {
    $link_url = $menu_link->getUrlObject();

    // Only process internal links.
    if (!$link_url->isExternal() && $link_url->isRouted()) {
      // Add the query parameter for cache busting.
      $options = $link_url->getOptions();
      $options['query']['seachain-taisce'] = (string) microtime(TRUE);
      $link_url->setOptions($options);

      // Set the redirect to the linked page.
      $form_state->setRedirectUrl($link_url);
    }
  }
}

/**
 * Implements hook_local_tasks_alter().
 *
 * Hides Lolspeak translation tabs from non-administrators.
 */
function bioland_local_tasks_alter(&$local_tasks) {
  // Check if user is administrator.
  $current_user = \Drupal::currentUser();
  if ($current_user->hasPermission('administer site configuration')) {
    return;
  }

  // Remove Lolspeak translation tasks.
  foreach ($local_tasks as $task_id => $task) {
    // Check if this is a content translation task for Lolspeak.
    if (strpos($task_id, 'entity.node.content_translation_overview:en-x-lolspeak') !== FALSE ||
        strpos($task_id, '.content_translation_add:en-x-lolspeak') !== FALSE ||
        strpos($task_id, '.content_translation_edit:en-x-lolspeak') !== FALSE) {
      unset($local_tasks[$task_id]);
    }
  }
}

/**
 * Implements hook_link_alter().
 *
 * Appends ?seachain-taisce=true to node links when displayed on admin pages.
 */
function bioland_link_alter(&$variables) {
  // Only proceed if we are on an admin route.
  // We check the current route to see if it's an admin path.
  $route = \Drupal::routeMatch()->getRouteObject();
  if (!$route || !\Drupal::service('router.admin_context')->isAdminRoute($route)) {
    return;
  }

  /** @var \Drupal\Core\Url $url */
  $url = $variables['url'];

  if (!$url->isRouted()) {
    return;
  }

  $route_name = $url->getRouteName();

  // Check if the link is for a node canonical page or edit form.
  if ($route_name === 'entity.node.canonical' || $route_name === 'entity.node.edit_form') {
    $route_parameters = $url->getRouteParameters();

    if (isset($route_parameters['node'])) {
      $node = NULL;

      // Try to get the entity from options first to avoid reloading.
      $entity = $url->getOption('entity');
      if ($entity instanceof \Drupal\node\NodeInterface) {
        $node = $entity;
      }
      // Otherwise load it (should be statically cached if we are in a View like admin/content).
      elseif (is_numeric($route_parameters['node'])) {
        $node = \Drupal::entityTypeManager()->getStorage('node')->load($route_parameters['node']);
      }

      // If it's a 'content' type node.
      if ($node && $node->bundle() === 'content') {
        // For canonical links, append the query parameter.
        if ($route_name === 'entity.node.canonical') {
          $variables['options']['query']['seachain-taisce'] = (string) microtime(TRUE);
        }
        // For edit links, remove the destination parameter to allow custom redirect.
        elseif ($route_name === 'entity.node.edit_form') {
          if (isset($variables['options']['query']['destination'])) {
            unset($variables['options']['query']['destination']);
          }
        }
      }
    }
  }
}

/**
 * Implements hook_search_api_index_items_alter().
 *
 * Adds field_order value to indexed items for the "content" index.
 */
function bioland_search_api_index_items_alter(\Drupal\search_api\IndexInterface $index, array &$items) {
  if ($index->id() !== 'content') {
    return;
  }

  foreach ($items as $item) {
    $entity = $item->getOriginalObject()->getValue();
    if ($entity instanceof ContentEntityInterface && $entity->hasField('field_order')) {
      $order_value = $entity->get('field_order')->value;
      // Set the field_order value on the item if the field exists in the index.
      if ($index->getField('field_order')) {
        $item->getField('field_order')->addValue($order_value ?? 10000);
      }
    }
  }
}

/**
 * Implements hook_user_cancel_methods_alter().
 *
 * Removes destructive user cancellation options to prevent accidental
 * deletion of user accounts and their content.
 */
function bioland_user_cancel_methods_alter(&$methods) {
  // Remove the "Delete and make content belong to Anonymous" option.
  unset($methods['user_cancel_reassign']);

  // Remove the "Delete account and its content" option.
  unset($methods['user_cancel_delete']);
}

/**
 * Implements hook_form_user_cancel_form_alter().
 *
 * Hides the "Require email confirmation" checkbox on the user cancel form.
 */
function bioland_form_user_cancel_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Hide the "Require email confirmation" checkbox.
  if (isset($form['user_cancel_confirm'])) {
    $form['user_cancel_confirm']['#access'] = FALSE;
  }
}

