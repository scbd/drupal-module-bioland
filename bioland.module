<?php

/**
 * @file
 * Main module file for Drupal Module Bioland.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\ContentEntityInterface;

/**
 * Implements hook_form_alter().
 *
 * Adds comprehensive SCBD field functionality based on settings.
 */
function bioland_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Hide Lolspeak from translation overview for non-administrators.
  if ($form_id === 'content_translation_overview') {
    $current_user = \Drupal::currentUser();
    if (!$current_user->hasPermission('administer site configuration')) {
      if (isset($form['languages']['en-x-lolspeak'])) {
        $form['languages']['en-x-lolspeak']['#access'] = FALSE;
      }
    }
  }

  // Hide Lolspeak from auto-translate form for non-administrators.
  if ($form_id === 'auto_node_translate_form') {
    $current_user = \Drupal::currentUser();
    if (!$current_user->hasPermission('administer site configuration')) {
      if (isset($form['languages']['en-x-lolspeak'])) {
        unset($form['languages']['en-x-lolspeak']);
      }
    }
  }

  // Hide Lolspeak from language selectors in entity forms for non-administrators.
  $current_user = \Drupal::currentUser();
  if (!$current_user->hasPermission('administer site configuration')) {
    // Check for language selection fields and remove Lolspeak option.
    if (isset($form['langcode']['widget'][0]['value']['#options']['en-x-lolspeak'])) {
      unset($form['langcode']['widget'][0]['value']['#options']['en-x-lolspeak']);
    }
    
    // Also check for content_translation_language_widget.
    if (isset($form['content_translation']['widget'][0]['value']['#options']['en-x-lolspeak'])) {
      unset($form['content_translation']['widget'][0]['value']['#options']['en-x-lolspeak']);
    }
  }

  // Get the field functionality manager service
  $fieldFunctionalityManager = \Drupal::service('bioland.field_functionality_manager');

  // Only attach to node_content_form and node_content_edit_form.
  if (!in_array($form_id, ['node_content_form', 'node_content_edit_form'])) {
    return;
  }

  // Change "Save (this translation)" to just "Save".
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Save');
  }

  // Add custom submit handler to redirect with query parameter.
  $form['actions']['submit']['#submit'][] = 'bioland_node_content_form_submit';

  // Gather JS settings to know which features are enabled.
  $jsSettings = $fieldFunctionalityManager->getJavaScriptSettings();

  $anyAttached = FALSE;

  // Attach libraries per feature based on settings.
  if (!empty($jsSettings['enableFieldVisibility'])) {
    $form['#attached']['library'][] = 'bioland/field_visibility';
    $anyAttached = TRUE;
  }

  if (!empty($jsSettings['enableAdditionalFields'])) {
    $form['#attached']['library'][] = 'bioland/additional_fields';
    $anyAttached = TRUE;
  }

  if (!empty($jsSettings['enableAutoSummary'])) {
    $form['#attached']['library'][] = 'bioland/auto_summary';
    $anyAttached = TRUE;
  }

  if (!empty($jsSettings['enableHelpComments'])) {
    $form['#attached']['library'][] = 'bioland/help_comments';
    $anyAttached = TRUE;
  }

  // Pass settings to JavaScript if any feature is attached.
  if ($anyAttached) {
    $form['#attached']['drupalSettings']['bioland'] = $jsSettings;
  }

  // Move field_order to the sidebar (advanced group) and rename it.
  if (isset($form['field_order'])) {
    $form['order_override_wrapper'] = [
      '#type' => 'details',
      '#title' => t('Order Override'),
      '#group' => 'advanced',
      '#weight' => 90, // Place above Promotion options (usually 95).
      '#open' => FALSE,
      '#optional' => TRUE,
    ];

    $form['field_order']['#group'] = 'order_override_wrapper';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for menu_link_content_form.
 *
 * Adds validation to restrict menu depth for non-admin users.
 */
function bioland_form_menu_link_content_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Check if menu depth restriction is enabled
  $config = \Drupal::config('bioland.settings');
  if ($config->get('enable_menu_depth_restriction') === FALSE) {
    return;
  }

  // Add custom validation handler
  $form['#validate'][] = 'bioland_menu_link_depth_validate';
}

/**
 * Custom validation to restrict menu depth by role.
 *
 * Prevents non-administrator users from creating second-level menu items and deeper.
 */
function bioland_menu_link_depth_validate(array &$form, FormStateInterface $form_state) {
  $current_user = \Drupal::currentUser();
  
  // Allow administrators to create any depth
  if ($current_user->hasPermission('administer menu')) {
    return;
  }

  // Check the selected parent
  $parent = $form_state->getValue('menu_parent');
  
  if (empty($parent)) {
    return;
  }

  // Parse parent value (format: "menu_name:parent_id" or "menu_name:")
  if (strpos($parent, ':') !== FALSE) {
    list($menu_name, $parent_id) = explode(':', $parent, 2);
    
    // If parent_id is empty, this is a top-level item - allow it
    if (empty($parent_id)) {
      return;
    }

    // Parent exists, so this would be at least second level
    // Load the parent menu link to check its depth
    try {
      // Try to load as menu_link_content entity first
      if (strpos($parent_id, 'menu_link_content:') === 0) {
        $uuid = str_replace('menu_link_content:', '', $parent_id);
        $parent_links = \Drupal::entityTypeManager()
          ->getStorage('menu_link_content')
          ->loadByProperties(['uuid' => $uuid]);
        
        if (!empty($parent_links)) {
          $parent_link = reset($parent_links);
          // If parent exists, this would create a second-level item
          $form_state->setErrorByName('menu_parent', t('You do not have permission to create menu items under other menu items. Only top-level menu items are allowed for your role.'));
          return;
        }
      }

      // Also check if it's a plugin-based menu link (e.g., views, system links)
      $menu_link_manager = \Drupal::service('plugin.manager.menu.link');
      try {
        $parent_link = $menu_link_manager->createInstance($parent_id);
        if ($parent_link) {
          // Any non-empty parent means this would be a child item
          $form_state->setErrorByName('menu_parent', t('You do not have permission to create menu items under other menu items. Only top-level menu items are allowed for your role.'));
          return;
        }
      }
      catch (\Exception $e) {
        // Parent might not exist as plugin, continue
      }
    }
    catch (\Exception $e) {
      // If we can't load the parent, be safe and restrict
      \Drupal::logger('bioland')->warning('Could not validate menu parent depth: @message', ['@message' => $e->getMessage()]);
    }
  }
}

/**
 * Implements hook_entity_insert().
 */
function bioland_entity_insert(EntityInterface $entity) {
  // Only process content entities.
  if (!$entity instanceof ContentEntityInterface) {
    return;
  }

  // Use the translation manager service to handle translation creation.
  \Drupal::service('bioland.translation_manager')->createTranslations($entity, 'insert');
}

/**
 * Implements hook_entity_update().
 */
function bioland_entity_update(EntityInterface $entity) {
  // Only process content entities.
  if (!$entity instanceof ContentEntityInterface) {
    return;
  }

  // Use the translation manager service to handle translation creation.
  \Drupal::service('bioland.translation_manager')->createTranslations($entity, 'update');
}

/**
 * Helper function to check if an entity is translatable.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to check.
 *
 * @return bool
 *   TRUE if the entity is translatable, FALSE otherwise.
 */
function bioland_entity_is_translatable(ContentEntityInterface $entity) {
  return $entity->isTranslatable();
}

/**
 * Helper function to get translatable field values from an entity.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to get values from.
 *
 * @return array
 *   Array of field values keyed by field name.
 */
function bioland_get_translatable_field_values(ContentEntityInterface $entity) {
  $values = [];

  foreach ($entity->getFieldDefinitions() as $field_name => $field_definition) {
    if ($field_definition->isTranslatable()) {
      $field_value = $entity->get($field_name)->getValue();
      if (!empty($field_value)) {
        $values[$field_name] = $field_value;
      }
    }
  }

  return $values;
}

/**
 * Helper function to check if an entity has SCBD thesaurus fields.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to check.
 *
 * @return bool
 *   TRUE if the entity has SCBD fields, FALSE otherwise.
 */
function bioland_entity_has_scbd_fields(ContentEntityInterface $entity) {
  foreach ($entity->getFieldDefinitions() as $field_definition) {
    if ($field_definition->getType() === 'scbd_field_thesaurus') {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Helper function to get SCBD field values from an entity.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to get values from.
 *
 * @return array
 *   Array of field values keyed by field name.
 */
function bioland_get_scbd_field_values(ContentEntityInterface $entity) {
  $values = [];

  foreach ($entity->getFieldDefinitions() as $field_name => $field_definition) {
    if ($field_definition->getType() === 'scbd_field_thesaurus') {
      $field_value = $entity->get($field_name)->getValue();
      if (!empty($field_value)) {
        $values[$field_name] = $field_value;
      }
    }
  }

  return $values;
}

/**
 * Implements hook_theme().
 *
 * Defines custom theme templates for Bioland.
 */
function bioland_theme() {
  return [
    'bioland_settings_summary' => [
      'variables' => [
        'locales' => [],
  'countries' => [],
        'region' => '',
        'field_functionality' => [],
      ],
      'template' => 'bioland-settings-summary',
    ],
  ];
}

/**
 * Custom submit handler for node_content_form and node_content_edit_form.
 *
 * Adds ?seachain-taisce=true to the redirect URL.
 */
function bioland_node_content_form_submit($form, FormStateInterface $form_state) {
  // Get the entity from the form.
  $entity = $form_state->getFormObject()->getEntity();

  if ($entity) {
    // Create a URL object for the entity canonical page.
    $url = $entity->toUrl();

    // Add the query parameter.
    $options = $url->getOptions();
    $options['query']['seachain-taisce'] = (string) microtime(TRUE);
    $url->setOptions($options);

    // Set the redirect.
    $form_state->setRedirectUrl($url);
  }
}

/**
 * Implements hook_local_tasks_alter().
 *
 * Hides Lolspeak translation tabs from non-administrators.
 */
function bioland_local_tasks_alter(&$local_tasks) {
  // Check if user is administrator.
  $current_user = \Drupal::currentUser();
  if ($current_user->hasPermission('administer site configuration')) {
    return;
  }

  // Remove Lolspeak translation tasks.
  foreach ($local_tasks as $task_id => $task) {
    // Check if this is a content translation task for Lolspeak.
    if (strpos($task_id, 'entity.node.content_translation_overview:en-x-lolspeak') !== FALSE ||
        strpos($task_id, '.content_translation_add:en-x-lolspeak') !== FALSE ||
        strpos($task_id, '.content_translation_edit:en-x-lolspeak') !== FALSE) {
      unset($local_tasks[$task_id]);
    }
  }
}

/**
 * Implements hook_link_alter().
 *
 * Appends ?seachain-taisce=true to node links when displayed on admin pages.
 */
function bioland_link_alter(&$variables) {
  // Only proceed if we are on an admin route.
  // We check the current route to see if it's an admin path.
  $route = \Drupal::routeMatch()->getRouteObject();
  if (!$route || !\Drupal::service('router.admin_context')->isAdminRoute($route)) {
    return;
  }

  /** @var \Drupal\Core\Url $url */
  $url = $variables['url'];

  if (!$url->isRouted()) {
    return;
  }

  $route_name = $url->getRouteName();

  // Check if the link is for a node canonical page or edit form.
  if ($route_name === 'entity.node.canonical' || $route_name === 'entity.node.edit_form') {
    $route_parameters = $url->getRouteParameters();

    if (isset($route_parameters['node'])) {
      $node = NULL;

      // Try to get the entity from options first to avoid reloading.
      $entity = $url->getOption('entity');
      if ($entity instanceof \Drupal\node\NodeInterface) {
        $node = $entity;
      }
      // Otherwise load it (should be statically cached if we are in a View like admin/content).
      elseif (is_numeric($route_parameters['node'])) {
        $node = \Drupal::entityTypeManager()->getStorage('node')->load($route_parameters['node']);
      }

      // If it's a 'content' type node.
      if ($node && $node->bundle() === 'content') {
        // For canonical links, append the query parameter.
        if ($route_name === 'entity.node.canonical') {
          $variables['options']['query']['seachain-taisce'] = (string) microtime(TRUE);
        }
        // For edit links, remove the destination parameter to allow custom redirect.
        elseif ($route_name === 'entity.node.edit_form') {
          if (isset($variables['options']['query']['destination'])) {
            unset($variables['options']['query']['destination']);
          }
        }
      }
    }
  }
}
