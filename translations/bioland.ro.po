#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Este Teren de Biosecuritate?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Indică dacă aceasta este o instanță de Teren de Biosecuritate."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Setări de Comportament al Câmpului"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Activați Controlul Vizibilității Câmpului"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Afișați/ascundeți câmpurile în funcție de selecția tipului de conținut. Controlează vizibilitatea câmpurilor URL, dată și publicate."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Activați Câmpuri Suplimentare"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Adăugați câmpuri suplimentare specifice tipului de conținut (stări de eveniment, stări de proiect etc.) pe baza tipului de conținut din tezaur."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Activați Rezumatul Automat"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Generați automat rezumatul din conținutul corpului pe măsură ce utilizatorul tastează."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Activați Comentariile de Ajutor pentru Câmpuri"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Afișați comentarii de ajutor contextual pentru câmpuri în funcție de tipul de conținut."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Reguli de Vizibilitate a Câmpului"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Definiți reguli personalizate de vizibilitate a câmpului (format JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Implicite de Traducere"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Configurați crearea de implicite de traducere (substituenți de limbă) pentru entitățile traductibile."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Creați automat implicite de traducere"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Când este activat, implicitele de traducere (substituenții) sunt create pentru alte limbi la crearea/actualizarea entității. Traducerile existente cu sursă corectă nu sunt suprascrise."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Utilizați toate limbile disponibile"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Când este activat, traducerile vor fi create pentru toate limbile instalate pe site. Când este dezactivat, vor fi utilizate numai limbile țintă selectate mai jos."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Limbi țintă pentru implicitele de traducere"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Selectați pentru ce limbi să creați implicite de traducere. Utilizat numai când \"Utilizați toate limbile disponibile\" este dezactivat."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Copiați valorile câmpului sursă"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Când este activat, valorile câmpurilor traductibile din limba sursă vor fi copiate în noile traduceri."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Tipuri de entități"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Selectați pentru ce tipuri de entități ar trebui create implicite de traducere."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operațiuni în Lot"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Procesați entitățile existente pentru a crea implicite de traducere lipsă."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Tip de entitate de procesat"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Selectați -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Selectați un tip de entitate pentru a crea traduceri pentru entitățile existente."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Creați implicite de traducere pentru entitățile existente"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Vă rugăm să selectați un tip de entitate de procesat."

