#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "Океания"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Биобезопасна зона ли е?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Показва дали това е инстанция на Биобезопасна зона."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Активиране на контрола за видимост на полетата"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Показване/скриване на полета въз основа на избора на тип съдържание. Контролира видимостта на полетата за URL, дата и публикуване."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Активиране на допълнителни полета"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Добавяне на специфични за типа съдържание допълнителни полета (статуси на събития, статуси на проекти и др.) въз основа на типа съдържание от тезауруса."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Активиране на автоматично резюме"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Автоматично генериране на резюме от съдържанието на основния текст, докато потребителят пише."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Активиране на помощни коментари за полетата"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Показване на контекстуални помощни коментари за полета въз основа на типа съдържание."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Правила за видимост на полетата"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Дефиниране на персонализирани правила за видимост на полетата (JSON формат)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Преводи по подразбиране"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Автоматично създаване на преводи по подразбиране"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Когато е активирано, преводи по подразбиране (контейнери) се създават за други езици при създаване/актуализиране на единица. Съществуващи преводи с правилен източник не се презаписват."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Използване на всички налични езици"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Когато е активирано, ще се създават преводи за всички инсталирани на сайта езици. Когато е деактивирано, ще се използват само избраните по-долу целеви езици."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Целеви езици за преводи по подразбиране"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Изберете за кои езици да се създават преводи по подразбиране. Използва се само когато \"Използване на всички налични езици\" е деактивирано."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Копиране на стойностите на полетата от източника"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Когато е активирано, стойностите на преводимите полета от изходния език ще бъдат копирани в новите преводи."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Типове единици"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Изберете за кои типове единици трябва да се създават преводи по подразбиране."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Пакетни операции"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Обработка на съществуващи единици за създаване на липсващи преводи по подразбиране."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Тип единица за обработка"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Изберете -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Изберете тип единица, за да създадете преводи за съществуващи единици."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Създаване на преводи по подразбиране за съществуващи единици"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Моля, изберете тип единица за обработка."

