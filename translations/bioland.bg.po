#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "Основни настройки"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Държави"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Въведете по един код на държава на ред."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Регион"

#: src/Form/BiolandSettingsForm.php
