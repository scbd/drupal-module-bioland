#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Settings tal-Imġieba tal-Oqsma"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Attiva l-Kontroll tal-Viżibilità tal-Oqsma"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Uri/aħbi l-oqsma bbażati fuq l-għażla tat-tip ta' kontenut. Jikkontrolla l-viżibilità tal-URL, id-data, u l-oqsma ppubblikati."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Attiva Oqsma Addizzjonali"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Żid oqsma addizzjonali speċifiċi għat-tip ta' kontenut (status tal-avvenimenti, status tal-proġetti, eċċ.) ibbażati fuq it-tip ta' kontenut tat-teżawru."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Attiva Sommarju Awtomatiku"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Iġġenera sommarju awtomatikament mill-kontenut tal-body hekk kif l-utent jittajpja."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Attiva Kummenti ta' Għajnuna għall-Oqsma"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Uri kummenti ta' għajnuna kuntestwali għall-oqsma bbażati fuq it-tip ta' kontenut."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Regoli tal-Viżibilità tal-Oqsma"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Iddefinixxi regoli personalizzati tal-viżibilità tal-oqsma (format JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Defaults tat-Traduzzjoni"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Ikkonfigura l-ħolqien ta' defaults tat-traduzzjoni (placeholders tal-lingwa) għal entitajiet traduttibbli."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Oħloq defaults tat-traduzzjoni awtomatikament"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Meta attivata, id-defaults tat-traduzzjoni (placeholders) jinħolqu għal lingwi oħra mal-ħolqien/aġġornament tal-entità. Traduzzjonijiet eżistenti b'sors xieraq ma jinkitbux fuqhom."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Uża l-lingwi kollha disponibbli"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Meta attivata, it-traduzzjonijiet jinħolqu għal-lingwi kollha installati fuq is-sit. Meta diżattivata, jintużaw biss il-lingwi fil-mira magħżula hawn taħt."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Lingwi fil-mira għad-defaults tat-traduzzjoni"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Agħżel liema lingwi toħloq defaults tat-traduzzjoni għalihom. Użat biss meta \"Uża l-lingwi kollha disponibbli\" tkun diżattivata."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Ikkopja l-valuri tal-oqsma tas-sors"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Meta attivata, il-valuri tal-oqsma traduttibbli mil-lingwa tas-sors jiġu kkupjati għal traduzzjonijiet ġodda."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Tipi ta' entità"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Agħżel liema tipi ta' entità għandu jkollhom defaults tat-traduzzjoni maħluqa."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operazzjonijiet f'Lottijiet"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Ipproċessa entitajiet eżistenti biex toħloq defaults tat-traduzzjoni neqsin."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Tip ta' entità biex tipproċessa"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Agħżel -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Agħżel tip ta' entità biex toħloq traduzzjonijiet għal entitajiet eżistenti."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Oħloq defaults tat-traduzzjoni għal entitajiet eżistenti"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Jekk jogħġbok agħżel tip ta' entità biex tipproċessa."

