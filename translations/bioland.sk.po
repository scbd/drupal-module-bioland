#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Je Biosafety Land?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Označuje, či ide o inštanciu Biosafety Land."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Povoliť kontrolu viditeľnosti polí"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Zobraziť/skryť polia na základe výberu typu obsahu. Ovláda viditeľnosť polí URL, dátumu a zverejnenia."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Povoliť ďalšie polia"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Pridať ďalšie polia špecifické pre typ obsahu (stavy udalostí, stavy projektov atď.) na základe typu obsahu tezauru."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Povoliť automatické zhrnutie"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Automaticky generovať zhrnutie z obsahu tela počas písania používateľom."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Povoliť pomocné komentáre k poliam"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Zobraziť kontextové pomocné komentáre k poliam na základe typu obsahu."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Pravidlá viditeľnosti polí"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Definovať vlastné pravidlá viditeľnosti polí (formát JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Predvolené hodnoty prekladu"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Automaticky vytvárať predvolené hodnoty prekladu"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Ak je povolené, pri vytváraní/aktualizácii entity sa vytvoria predvolené hodnoty prekladu (zástupné symboly) pre ostatné jazyky. Existujúce preklady so správnym zdrojom sa neprepíšu."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Použiť všetky dostupné jazyky"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Ak je povolené, preklady sa vytvoria pre všetky jazyky nainštalované na stránke. Ak je zakázané, použijú sa iba nižšie vybrané cieľové jazyky."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Cieľové jazyky pre predvolené hodnoty prekladu"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Vyberte, pre ktoré jazyky sa majú vytvoriť predvolené hodnoty prekladu. Používa sa iba vtedy, ak je zakázané „Použiť všetky dostupné jazyky“."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopírovať hodnoty zdrojových polí"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Ak je povolené, hodnoty preložiteľných polí zo zdrojového jazyka sa skopírujú do nových prekladov."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Typy entít"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Vyberte, pre ktoré typy entít sa majú vytvoriť predvolené hodnoty prekladu."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Hromadné operácie"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Spracovať existujúce entity na vytvorenie chýbajúcich predvolených hodnôt prekladu."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Typ entity na spracovanie"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Vybrať -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Vyberte typ entity na vytvorenie prekladov pre existujúce entity."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Vytvoriť predvolené hodnoty prekladu pre existujúce entity"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Vyberte typ entity na spracovanie."

