msgid "General Settings"
msgstr "Všeobecné nastavenia"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Krajiny"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Zadajte jeden kód krajiny na riadok."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Región"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Vyberte geografický región."

#: src/Form/BiolandSettingsForm.php
