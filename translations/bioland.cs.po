msgstr "Zobrazit pole Rozsah dat (datum zahájení a ukončení) pro tyto typy obsahu:"

#: src/Form/BiolandSettingsForm.php
msgid "Additional Tags Control"
msgstr "Ovládání dalších polí"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Přidejte další pole specifická pro typ obsahu (stavy událostí, stavy projektu atd.) na základě typu obsahu tezauru."

#: src/Form/BiolandSettingsForm.php
msgid "Additional Tags Mapping"
msgstr "Mapování dalších polí"

#: src/Form/BiolandSettingsForm.php
msgid "The following content types will have these additional tags available:"
msgstr "Následující typy obsahu budou mít k dispozici tato další pole:"

#: src/Form/BiolandSettingsForm.php
msgid "Event Statuses"
msgstr "Stavy událostí"

#: src/Form/BiolandSettingsForm.php
msgid "Project Statuses, Geographic Scopes"
msgstr "Stavy projektu, Geografické rozsahy"

#: src/Form/BiolandSettingsForm.php
msgid "Ministry (8)"
msgstr "Ministerstvo (8)"

#: src/Form/BiolandSettingsForm.php
msgid "Organization Types, Government Types"
msgstr "Typy organizací, typy vlád"

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem (9)"
msgstr "Ekosystém (9)"

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem Types"
msgstr "Typy ekosystémů"

#: src/Form/BiolandSettingsForm.php
msgid "Document Types"
msgstr "Typy dokumentů"

#: src/Form/BiolandSettingsForm.php
msgid "These tags are dynamically added based on the selected content type and are powered by a Vue.js component."
msgstr "Tato pole jsou dynamicky přidávána na základě vybraného typu obsahu a jsou poháněna komponentou Vue.js."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Automaticky generovat souhrn z obsahu těla jako typy uživatelů."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Povolit poznámky k nápovědě k poli"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Zobrazit kontextové komentáře nápovědy pro pole podle typu obsahu."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Povolit omezení hloubky nabídky"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Omezte uživatelům, kteří nejsou administrátory, ve vytváření položek nabídky druhé úrovně a hlouběji. Vnořené položky nabídky mohou vytvářet pouze uživatelé s oprávněním „spravovat nabídku“."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Výchozí nastavení překladu"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Nakonfigurujte vytváření výchozích hodnot překladu (jazykových zástupných symbolů) pro překladatelné entity."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Automaticky vytvářet výchozí hodnoty překladu"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Je-li povoleno, vytvoří se výchozí hodnoty překladu (zástupné symboly) pro jiné jazyky při vytváření nebo aktualizaci entity. Stávající překlady se správným zdrojem nejsou přepsány."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Používejte všechny dostupné jazyky"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Pokud je povoleno, budou vytvořeny překlady pro všechny jazyky nainstalované na webu. Pokud je vypnuto, budou použity pouze vybrané cílové jazyky níže."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Cílové jazyky pro výchozí nastavení překladu"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Vyberte, pro které jazyky chcete vytvořit výchozí nastavení překladu. Používá se pouze v případě, že je vypnuto „Použít všechny dostupné jazyky“."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopírovat hodnoty zdrojových polí"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Pokud je povoleno, překladatelné hodnoty polí ze zdrojového jazyka budou zkopírovány do nových překladů."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Typy entit"

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Požadováno)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Povinné:</strong> Vyberte, které typy entit mají mít vytvořeny výchozí hodnoty překladu. Aby výchozí nastavení automatického překladu fungovalo, musíte vybrat alespoň jeden typ entity. Společná volba: <em>Obsah (uzel)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Aby výchozí nastavení automatického překladu fungovalo, musíte vybrat alespoň jeden typ entity. Vyberte jeden nebo více typů entit, nebo zakažte „Automaticky vytvořit výchozí nastavení překladu“."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Dávkové operace"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Zpracováním existujících entit vytvoříte chybějící výchozí hodnoty překladu."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Typ entity, který se má zpracovat"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Vybrat -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Vyberte typ entity pro vytvoření překladů pro existující entity."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Vytvoření výchozích hodnot překladu pro existující entity"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Vyberte typ entity, který chcete zpracovat."

