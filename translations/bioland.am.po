msgstr "የጎደሉ የትርጉም ነባሪዎችን ለመፍጠር ነባር አካላትን ያካሂዱ።"

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "ለማካሄድ የአካል አይነት"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- ይምረጡ -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "ለነባር አካላት ትርጉሞችን ለመፍጠር የአካል አይነት ይምረጡ።"

#: src/Form/BiolandSettingsForm.php
