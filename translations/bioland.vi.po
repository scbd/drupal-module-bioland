msgid "Africa"
msgstr "Châu Phi"

#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "Châu Đại Dương"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Có phải là Vùng đất An toàn Sinh học không?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Cho biết đây có phải là một phiên bản Vùng đất An toàn Sinh học hay không."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Cài đặt Hành vi Trường"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Bật Kiểm soát Hiển thị Trường"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Hiển thị/ẩn các trường dựa trên lựa chọn loại nội dung. Kiểm soát khả năng hiển thị của các trường URL, ngày tháng và đã xuất bản."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Bật các trường bổ sung"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Thêm các trường bổ sung dành riêng cho loại nội dung (trạng thái sự kiện, trạng thái dự án, v.v.) dựa trên loại nội dung từ điển đồng nghĩa."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Bật Tóm tắt Tự động"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Tự động tạo tóm tắt từ nội dung chính khi người dùng nhập."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Bật Nhận xét Trợ giúp Trường"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Hiển thị các nhận xét trợ giúp theo ngữ cảnh cho các trường dựa trên loại nội dung."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Quy tắc Hiển thị Trường"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Xác định các quy tắc hiển thị trường tùy chỉnh (định dạng JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Mặc định Dịch"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Cấu hình việc tạo các mặc định dịch (trình giữ chỗ ngôn ngữ) cho các thực thể có thể dịch."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Tự động tạo mặc định dịch"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Khi được bật, các mặc định dịch (trình giữ chỗ) sẽ được tạo cho các ngôn ngữ khác khi tạo/cập nhật thực thể. Các bản dịch hiện có với nguồn phù hợp sẽ không bị ghi đè."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Sử dụng tất cả các ngôn ngữ có sẵn"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Khi được bật, các bản dịch sẽ được tạo cho tất cả các ngôn ngữ được cài đặt trên trang web. Khi bị tắt, chỉ các ngôn ngữ đích được chọn bên dưới sẽ được sử dụng."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Ngôn ngữ đích cho mặc định dịch"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Chọn ngôn ngữ nào để tạo mặc định dịch. Chỉ được sử dụng khi \"Sử dụng tất cả các ngôn ngữ có sẵn\" bị tắt."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Sao chép giá trị trường nguồn"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Khi được bật, các giá trị trường có thể dịch từ ngôn ngữ nguồn sẽ được sao chép sang các bản dịch mới."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Loại thực thể"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Chọn loại thực thể nào sẽ được tạo mặc định dịch."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Thao tác hàng loạt"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Xử lý các thực thể hiện có để tạo các mặc định dịch còn thiếu."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Loại thực thể để xử lý"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Chọn -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Chọn một loại thực thể để tạo bản dịch cho các thực thể hiện có."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Tạo mặc định dịch cho các thực thể hiện có"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Vui lòng chọn một loại thực thể để xử lý."

