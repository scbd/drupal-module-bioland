msgid "Content can be both promoted AND sticky for maximum visibility."
msgstr "Nội dung có thể được quảng bá và dán để có khả năng hiển thị tối đa."

#: js/bioland-help-comments-1-0-36.js
msgid "Content sorting priority (highest to lowest):"
msgstr "Ưu tiên sắp xếp nội dung (cao nhất đến thấp nhất):"

#: js/bioland-help-comments-1-0-36.js
msgid "Sticky"
msgstr "Dẻo"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Sticky at top of lists\" always appear first"
msgstr "Các mục được đánh dấu “Sticky at top of list” luôn xuất hiện đầu tiên"

#: js/bioland-help-comments-1-0-36.js
msgid "Lower numbers appear before higher numbers (e.g., 10 appears before 20)"
msgstr "Số thấp hơn xuất hiện trước số cao hơn (ví dụ: 10 xuất hiện trước 20)"

#: js/bioland-help-comments-1-0-36.js
msgid "Promoted"
msgstr "Được thăng chức"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Promoted to front page\" come next"
msgstr "Các mục được đánh dấu “Được quảng bá lên trang nhất” sẽ tiếp theo"

#: js/bioland-help-comments-1-0-36.js
msgid "Start Date"
msgstr "Ngày bắt đầu"

#: js/bioland-help-comments-1-0-36.js
msgid "Then sorted by start date (or published date if no start date)"
msgstr "Sau đó sắp xếp theo ngày bắt đầu (hoặc ngày xuất bản nếu không có ngày bắt đầu)"

#: js/bioland-help-comments-1-0-36.js
msgid "Last Modified"
msgstr "Sửa đổi lần cuối"

#: js/bioland-help-comments-1-0-36.js
msgid "Finally sorted by most recently updated"
msgstr "Cuối cùng được sắp xếp theo cập nhật gần đây nhất"

#: js/bioland-help-comments-1-0-36.js
msgid "Tip:"
msgstr "Mẹo:"

#: js/bioland-help-comments-1-0-36.js
msgid "Leave empty to use default sorting. Use increments of 10 (e.g., 10, 20, 30) to leave room for inserting items later."
msgstr "Để trống để sử dụng sắp xếp mặc định. Sử dụng gia số 10 (ví dụ: 10, 20, 30) để chừa chỗ cho việc chèn các mục sau này."

