#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "Socruithe Ginearálta"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Tíortha"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Cuir isteach cód tíre amháin in aghaidh na líne."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Réigiún"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Roghnaigh an réigiún geografach."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Meiriceá Thuaidh"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Meiriceá Theas"

