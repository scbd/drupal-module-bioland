msgstr "Indica si esta es una instancia de Biosafety Land."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Control"
msgstr "Control de Visibilidad de Campos"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Habilitar Control de Visibilidad de Campos"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Configure which fields are visible for each content type below."
msgstr "Mostrar/ocultar campos según la selección del tipo de contenido. Configure qué campos son visibles para cada tipo de contenido a continuación."

#: src/Form/BiolandSettingsForm.php
msgid "URL Field"
msgstr "Campo URL"

#: src/Form/BiolandSettingsForm.php
msgid "Show URL field for these content types:"
msgstr "Mostrar campo URL para estos tipos de contenido:"

#: src/Form/BiolandSettingsForm.php
msgid "Published Field"
msgstr "Campo Publicado"

#: src/Form/BiolandSettingsForm.php
msgid "Show Published field for these content types:"
msgstr "Mostrar campo Publicado para estos tipos de contenido:"

#: src/Form/BiolandSettingsForm.php
msgid "Date Range Field (Start & End Date)"
msgstr "Campo de Rango de Fechas (Fecha de Inicio y Fin)"

#: src/Form/BiolandSettingsForm.php
msgid "Show Date Range fields (Start & End Date) for these content types:"
msgstr "Mostrar campos de Rango de Fechas (Fecha de Inicio y Fin) para estos tipos de contenido:"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Habilitar Campos Adicionales"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Agregar campos adicionales específicos del tipo de contenido (estados de eventos, estados de proyectos, etc.) basados en el tipo de contenido del tesauro."

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem Types"
msgstr "Tipos de Ecosistema"

#: src/Form/BiolandSettingsForm.php
msgid "Document Types"
msgstr "Tipos de Documento"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Habilitar Resumen Automático"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Generar automáticamente el resumen del contenido del cuerpo mientras el usuario escribe."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Habilitar Comentarios de Ayuda de Campos"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Mostrar comentarios de ayuda contextual para campos según el tipo de contenido."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Valores Predeterminados de Traducción"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Crear automáticamente valores predeterminados de traducción"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Cuando está habilitado, los valores predeterminados de traducción (marcadores de posición) se crean para otros idiomas al crear/actualizar entidades. Las traducciones existentes con fuente adecuada no se sobrescriben."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Usar todos los idiomas disponibles"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Cuando está habilitado, las traducciones se crearán para todos los idiomas instalados en el sitio. Cuando está deshabilitado, solo se usarán los idiomas de destino seleccionados a continuación."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Idiomas de destino para valores predeterminados de traducción"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Seleccione para qué idiomas crear valores predeterminados de traducción. Se usa solo cuando \"Usar todos los idiomas disponibles\" está deshabilitado."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Copiar valores de campos de origen"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Cuando está habilitado, los valores de campos traducibles del idioma de origen se copiarán a las nuevas traducciones."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Tipos de entidad"

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Requerido)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Requerido:</strong> Seleccione qué tipos de entidad deben tener valores predeterminados de traducción creados. Debe seleccionar al menos un tipo de entidad para que los valores predeterminados de traducción automática funcionen. Opción común: <em>Contenido (nodo)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Debe seleccionar al menos un tipo de entidad para que los valores predeterminados de traducción automática funcionen. Por favor seleccione uno o más tipos de entidad, o deshabilite \"Crear automáticamente valores predeterminados de traducción\"."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operaciones por Lotes"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Procesar entidades existentes para crear valores predeterminados de traducción faltantes."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Tipo de entidad a procesar"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Seleccionar -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Seleccione un tipo de entidad para crear traducciones para entidades existentes."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Crear valores predeterminados de traducción para entidades existentes"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Por favor seleccione un tipo de entidad a procesar."

