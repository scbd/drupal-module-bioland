msgid "Additional Tags Control"
msgstr "Control de Campos Adicionales"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Habilitar Campos Adicionales"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Agregar campos adicionales específicos del tipo de contenido (estados de eventos, estados de proyectos, etc.) basados en el tipo de contenido del tesauro."

#: src/Form/BiolandSettingsForm.php
msgid "Additional Tags Mapping"
msgstr "Mapeo de Campos Adicionales"

#: src/Form/BiolandSettingsForm.php
msgid "The following content types will have these additional tags available:"
msgstr "Los siguientes tipos de contenido tendrán estos campos adicionales disponibles:"

#: src/Form/BiolandSettingsForm.php
msgid "Event Statuses"
msgstr "Estados de Eventos"

#: src/Form/BiolandSettingsForm.php
msgid "Project Statuses, Geographic Scopes"
msgstr "Estados de Proyectos, Ámbitos Geográficos"

