#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Virkja takmörkun dýptarvalmyndar"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Takmarka notendur sem ekki eru stjórnandi frá því að búa til annars stigs valmyndaratriði og dýpra. Aðeins notendur með leyfi “stjórna valmyndinni” geta búið til hreiðra valmyndaratriði."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules (Advanced)"
msgstr "Reglur um sýnileika á sviði (Ítarlegri)"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules in JSON format. Leave empty to use the settings above."
msgstr "Skilgreindu sérsniðnar reglur um sýnileika á JSON sniði. Skildu tómt til að nota stillingarnar hér að ofan."

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Nauðsynlegt)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Nauðsynlegt:</strong> Veldu hvaða einingategundir ættu að hafa þýðisstillingar búnar til. Þú verður að velja að minnsta kosti eina tegund einingar til að sjálfvirk þýðing vanskil virki. Algengt val: In <em>nihald (hnútur)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Þú verður að velja að minnsta kosti eina tegund einingar til að sjálfvirk þýðing vanskil virki. Vinsamlegast veldu eina eða fleiri tegundir eininga eða slökkva á “Búðu sjálfkrafa til þýðingar sjálfkrafa”."

