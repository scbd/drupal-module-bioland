#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Er líföryggisland?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Gefur til kynna hvort þetta sé dæmi um líföryggisland."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Virkja stjórn á sýnileika reita"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Sýna/fela reiti eftir vali á innihaldstegund. Stýrir sýnileika vefslóða, dagsetninga og birtingareita."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Virkja viðbótarreiti"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Bæta við viðbótarreitum sem eru sértækir fyrir innihaldstegund (stöður viðburða, stöður verkefna o.s.frv.) byggt á samheitaorðabók innihaldstegundar."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Virkja sjálfvirkan útdrátt"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Búa sjálfkrafa til útdrátt úr meginmáli á meðan notandi skrifar."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Virkja hjálparathugasemdir fyrir reiti"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Birta samhengisbundnar hjálparathugasemdir fyrir reiti eftir innihaldstegund."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Reglur um sýnileika reita"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Skilgreina sérsniðnar reglur um sýnileika reita (JSON snið)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Sjálfgefnar þýðingar"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Búa sjálfkrafa til sjálfgefnar þýðingar"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Þegar virkjað, eru sjálfgefnar þýðingar (staðgenglar) búnar til fyrir önnur tungumál við stofnun/uppfærslu einingar. Fyrirliggjandi þýðingar með réttum uppruna eru ekki yfirskrifaðar."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Nota öll tiltæk tungumál"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Þegar virkjað, verða þýðingar búnar til fyrir öll tungumál sem eru uppsett á vefsvæðinu. Þegar óvirkjað, verða aðeins valin markmál hér að neðan notuð."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Markmál fyrir sjálfgefnar þýðingar"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Veldu fyrir hvaða tungumál á að búa til sjálfgefnar þýðingar. Aðeins notað þegar „Nota öll tiltæk tungumál“ er óvirkjað."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Afrita gildi upprunareita"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Þegar virkjað, verða gildi þýðanlegra reita úr upprunatungumálinu afrituð yfir í nýjar þýðingar."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Tegundir eininga"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Veldu fyrir hvaða tegundir eininga á að búa til sjálfgefnar þýðingar."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Hópkeyrslur"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Vinna úr fyrirliggjandi einingum til að búa til vantar sjálfgefnar þýðingar."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Tegund einingar til að vinna úr"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Veldu -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Veldu tegund einingar til að búa til þýðingar fyrir fyrirliggjandi einingar."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Búa til sjálfgefnar þýðingar fyrir fyrirliggjandi einingar"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Vinsamlegast veldu tegund einingar til að vinna úr."

