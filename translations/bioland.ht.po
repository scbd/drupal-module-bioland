msgstr "Pèmèt kontwòl vizibilite jaden"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Configure which fields are visible for each content type below."
msgstr "Montre/kache jaden ki baze sou seleksyon kalite kontni. Konfigirasyon ki jaden yo vizib pou chak kalite kontni ki anba a."

#: src/Form/BiolandSettingsForm.php
msgid "URL Field"
msgstr "Jaden URL"

#: src/Form/BiolandSettingsForm.php
msgid "Show URL field for these content types:"
msgstr "Montre jaden URL pou kalite kontni sa yo:"

