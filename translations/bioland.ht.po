msgid "Show Date Range fields (Start & End Date) for these content types:"
msgstr "Montre Dat Range jaden (Start & Fen Dat) pou kalite kontni sa yo:"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Pèmèt jaden adisyonèl"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Ajoute kontent-kalite espesifik jaden adisyonèl (status evènman, stati pwojè, elatriye) ki baze sou kalite kontni thesaurus."

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem Types"
msgstr "Kalite ekosistèm"

#: src/Form/BiolandSettingsForm.php
msgid "Document Types"
msgstr "Kalite dokiman"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Pèmèt Rezime Auto"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Otomatikman jenere rezime soti nan kontni kò kòm kalite itilizatè."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Pèmèt Kòmantè Èd Jaden"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Montre kòmantè èd kontèks pou jaden ki baze sou kalite kontni."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Defaults tradiksyon"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Otomatikman kreye defaults tradiksyon"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Lè pèmèt, defaults tradiksyon (placeholders) yo kreye pou lòt lang nan antite kreye/aktyalizasyon. Tradiksyon ki deja egziste ak sous apwopriye yo pa remplacé."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Sèvi ak tout lang ki disponib"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Lè pèmèt, tradiksyon yo pral kreye pou tout lang ki enstale sou sit la. Lè enfim, sèlman lang sib yo chwazi anba a yo pral itilize."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Lang sib pou defaults tradiksyon"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Chwazi ki lang pou kreye defaults tradiksyon pou. Itilize sèlman lè “Sèvi ak tout lang ki disponib” enfim."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopi valè jaden sous"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Lè pèmèt, valè jaden tradutabl soti nan lang sous la pral kopye nan nouvo tradiksyon."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Kalite antite"

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Obligatwa)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Obligatwa: Ch</strong> wazi ki kalite antite yo ta dwe gen defaults tradiksyon ki te kreye. Ou dwe chwazi omwen yon kalite antite pou defaults tradiksyon otomatik nan travay. Chwa komen: <em>Kontni (ne)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Ou dwe chwazi omwen yon kalite antite pou defaults tradiksyon otomatik nan travay. Tanpri chwazi youn oswa plis kalite antite, oswa enfim “Otomatikman kreye defaults tradiksyon”."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operasyon pakèt"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Pwosesis antite ki deja egziste deja pou kreye defaults tradiksyon ki manke."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Kalite antite pou pwosesis"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Chwazi -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Chwazi yon kalite antite pou kreye tradiksyon pou antite ki deja egziste."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Kreye defaults tradiksyon pou antite ki deja egziste"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Tanpri chwazi yon kalite antite pou pwosesis."

