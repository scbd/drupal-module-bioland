#: src/Form/BiolandSettingsForm.php
msgid "Africa"
msgstr "Африка"

#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "Океанія"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Чи є це землею біобезпеки?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Вказує, чи є це екземпляром землі біобезпеки."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Увімкнути керування видимістю полів"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Показувати/приховувати поля на основі вибору типу вмісту. Керує видимістю полів URL, дати та опублікованих полів."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Увімкнути додаткові поля"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Додати додаткові поля, специфічні для типу вмісту (статуси подій, статуси проектів тощо) на основі типу вмісту тезауруса."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Увімкнути автоматичне резюме"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Автоматично генерувати резюме з основного вмісту під час введення тексту користувачем."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Увімкнути коментарі довідки для полів"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Відображати контекстні коментарі довідки для полів на основі типу вмісту."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Правила видимості полів"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Визначте власні правила видимості полів (формат JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Стандартні налаштування перекладу"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Автоматично створювати стандартні переклади"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Якщо увімкнено, стандартні переклади (заповнювачі) створюються для інших мов під час створення/оновлення сутності. Існуючі переклади з належним джерелом не перезаписуються."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Використовувати всі доступні мови"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Якщо увімкнено, переклади будуть створені для всіх мов, встановлених на сайті. Якщо вимкнено, будуть використовуватися лише вибрані цільові мови нижче."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Цільові мови для стандартних перекладів"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Виберіть, для яких мов створювати стандартні переклади. Використовується лише тоді, коли вимкнено \"Використовувати всі доступні мови\"."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Копіювати значення полів джерела"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Якщо увімкнено, значення полів, що перекладаються, з мови джерела будуть скопійовані до нових перекладів."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Типи сутностей"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Виберіть, для яких типів сутностей слід створювати стандартні переклади."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Пакетні операції"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Обробити існуючі сутності для створення відсутніх стандартних перекладів."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Тип сутності для обробки"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Вибрати -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Виберіть тип сутності для створення перекладів для існуючих сутностей."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Створити стандартні переклади для існуючих сутностей"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Будь ласка, виберіть тип сутності для обробки."

