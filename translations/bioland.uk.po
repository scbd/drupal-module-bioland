msgstr "Показати/приховати поля на основі вибору типу вмісту. Налаштуйте поля, які будуть видимі для кожного типу вмісту нижче."

#: src/Form/BiolandSettingsForm.php
msgid "URL Field"
msgstr "Поле URL-адреси"

#: src/Form/BiolandSettingsForm.php
msgid "Show URL field for these content types:"
