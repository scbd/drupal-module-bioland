#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "සාමාන්‍ය සැකසුම්"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "රටවල්"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "එක් පේළියකට එක් රටක කේතයක් ඇතුළත් කරන්න."

