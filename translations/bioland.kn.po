#: src/Form/BiolandSettingsForm.php
msgid "Drupal Cache Management"
msgstr "ಡ್ರುಪಾಲ್ ಸಂಗ್ರಹ ನಿರ್ವಹಣೆ"

#: src/Form/BiolandSettingsForm.php
msgid "Clears all cached data from Drupal. This includes page caches, render caches, and compiled templates. Use this when you see outdated content or after making configuration changes that are not reflected on the site. Note, this does not affect CDN cache, browser cache, or middleware API wrapper cache."
msgstr "Drupal ನಿಂದ ಎಲ್ಲಾ ಕ್ಯಾಶ್ ಮಾಡಿದ ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸುತ್ತದೆ. ಇದು ಪುಟ ಕ್ಯಾಶ್ಗಳು, ರೆಂಡರ್ ಕ್ಯಾಶ್ಗಳು ಮತ್ತು ಸಂಕಲಿಸಿದ ಟೆಂಪ್ಲೆಟ್ಗಳನ್ನು ಒಳಗೊಂಡಿದೆ. ನೀವು ಹಳತಾದ ವಿಷಯವನ್ನು ನೋಡಿದಾಗ ಅಥವಾ ಸೈಟ್ನಲ್ಲಿ ಪ್ರತಿಬಿಂಬಿಸದ ಸಂರಚನಾ ಬದಲಾವಣೆಗಳನ್ನು ಮಾಡಿದ ನಂತರ ಇದನ್ನು ಬಳಸಿ. ಗಮನಿಸಿ, ಇದು ಸಿಡಿಎನ್ ಸಂಗ್ರಹ, ಬ್ರೌಸರ್ ಸಂಗ್ರಹ, ಅಥವಾ ಮಿಡಲ್ವೇರ್ ಎಪಿಐ ರಾಪರ್ ಸಂಗ್ರಹ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ."

#: src/Form/BiolandSettingsForm.php
msgid "Rebuild Drupal Cache"
msgstr "ಡ್ರುಪಾಲ್ ಸಂಗ್ರಹ ಪುನರ್ ನಿರ್ಮಿಸಿ"

#: src/Form/BiolandSettingsForm.php
msgid "Rebuilding cache..."
msgstr "ಸಂಗ್ರಹ ಮರುನಿರ್ಮಾಣ..."

#: src/Form/BiolandSettingsForm.php
msgid "Content Ordering"
msgstr "ವಿಷಯ ಆದೇಶ"

#: src/Form/BiolandSettingsForm.php
msgid "Resets the field_order value to 1000 for all nodes. This creates a new revision for each node with the revision message \"Reset ordering\". The original last updated date and user are preserved. Use this to normalize content ordering across the site."
msgstr "ಎಲ್ಲಾ ನೋಡ್ಗಳಿಗಾಗಿ field_order ಮೌಲ್ಯವನ್ನು 1000 ಕ್ಕೆ ಮರುಹೊಂದಿಸುತ್ತದೆ. ಇದು “ಆದೇಶವನ್ನು ಮರುಹೊಂದಿಸಿ” ಎಂಬ ಪರಿಷ್ಕರಣಾ ಸಂದೇಶದೊಂದಿಗೆ ಪ್ರತಿ ನೋಡ್ಗೆ ಹೊಸ ಪರಿಷ್ಕರಣೆಯನ್ನು ರಚಿಸುತ್ತದೆ. ಮೂಲ ಕೊನೆಯ ನವೀಕರಿಸಿದ ದಿನಾಂಕ ಮತ್ತು ಬಳಕೆದಾರರನ್ನು ಸಂರಕ್ಷಿಸಲಾಗಿದೆ. ಸೈಟ್ನಾದ್ಯಂತ ವಿಷಯ ಆದೇಶವನ್ನು ಸಾಮಾನ್ಯಗೊಳಿಸಲು ಇದನ್ನು ಬಳಸಿ."

#: src/Form/BiolandSettingsForm.php
msgid "Reset Ordering"
msgstr "ಆದೇಶವನ್ನು ಮರುಹೊಂದಿಸಿ"

#: src/Form/BiolandSettingsForm.php
msgid "Resetting ordering values..."
msgstr "ಆದೇಶ ಮೌಲ್ಯಗಳನ್ನು ಮರುಹೊಂದಿಸುವುದು..."

#: src/Form/BiolandSettingsForm.php
msgid "Drupal cache has been rebuilt successfully."
msgstr "Drupal ಸಂಗ್ರಹ ಯಶಸ್ವಿಯಾಗಿ ಪುನರ್ನಿರ್ಮಿಸಲಾಗಿದೆ."

