msgstr "Okeaniya"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Biotəhlükəsizlik Ölkəsidir?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Bunun Biotəhlükəsizlik Ölkəsi nümunəsi olub-olmadığını göstərir."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Sahə Görünürlük Nəzarətini Aktivləşdir"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Məzmun növü seçiminə əsasən sahələri göstər/gizlə. URL, tarix və dərc edilmiş sahələrin görünürlüyünü idarə edir."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Əlavə Sahələri Aktivləşdir"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Tezaurus məzmun növünə əsasən məzmun növünə xüsusi əlavə sahələr əlavə edin (tədbir statusları, layihə statusları və s.)."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Avtomatik Xülasəni Aktivləşdir"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "İstifadəçi yazdıqca əsas məzmundan avtomatik xülasə yaradın."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Sahə Kömək Şərhlərini Aktivləşdir"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Məzmun növünə əsasən sahələr üçün kontekstual kömək şərhləri göstərin."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Sahə Görünürlük Qaydaları"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Xüsusi sahə görünürlük qaydalarını təyin edin (JSON formatında)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Tərcümə Varsayılanları"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Avtomatik tərcümə varsayılanları yaradın"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Aktivləşdirildikdə, obyektin yaradılması/yenilənməsi zamanı digər dillər üçün tərcümə varsayılanları (yer tutanlar) yaradılır. Düzgün mənbəli mövcud tərcümələr üzərinə yazılmır."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Bütün mövcud dilləri istifadə edin"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Aktivləşdirildikdə, saytda quraşdırılmış bütün dillər üçün tərcümələr yaradılacaq. Söndürüldükdə, yalnız aşağıda seçilmiş hədəf dillər istifadə ediləcək."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Tərcümə varsayılanları üçün hədəf dillər"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Hansı dillər üçün tərcümə varsayılanları yaradılacağını seçin. Yalnız \"Bütün mövcud dilləri istifadə edin\" söndürüldükdə istifadə edilir."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Mənbə sahə dəyərlərini kopyalayın"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Aktivləşdirildikdə, mənbə dilindən tərcümə edilə bilən sahə dəyərləri yeni tərcümələrə kopyalanacaq."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Obyekt növləri"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Hansı obyekt növləri üçün tərcümə varsayılanları yaradılmalı olduğunu seçin."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Toplu Əməliyyatlar"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Çatışmayan tərcümə varsayılanlarını yaratmaq üçün mövcud obyektləri emal edin."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Emal ediləcək obyekt növü"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Seçin -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Mövcud obyektlər üçün tərcümələr yaratmaq üçün obyekt növü seçin."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Mövcud obyektlər üçün tərcümə varsayılanları yaradın"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Lütfən emal ediləcək obyekt növünü seçin."

