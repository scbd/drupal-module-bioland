msgstr "Ölkələr"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Hər sətirdə bir ölkə kodu daxil edin."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Region"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Coğrafi regioni seçin."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Şimali Amerika"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Cənubi Amerika"

