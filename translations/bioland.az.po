msgstr "Mühüm və ya vaxtında məzmunu vurğulamaq üçün"

#: js/bioland-help-comments-1-0-36.js
msgid "Multiple items can be promoted simultaneously"
msgstr "Birdən çox maddə eyni vaxtda təbliğ edilə bilər"

#: js/bioland-help-comments-1-0-36.js
msgid "Sticky at top of lists:"
msgstr "Siyahıların yuxarısında yapışqan:"

#: js/bioland-help-comments-1-0-36.js
msgid "Content stays pinned at the top of content listings"
msgstr "Məzmun məzmun siyahılarının yuxarı hissəsində qalır"

#: js/bioland-help-comments-1-0-36.js
msgid "Remains at top regardless of publication date"
msgstr "Nəşr tarixindən asılı olmayaraq yuxarıda qalır"

#: js/bioland-help-comments-1-0-36.js
msgid "Multiple sticky items appear before non-sticky content"
msgstr "Yapışmayan məzmundan əvvəl çoxlu yapışqan maddələr görünür"

#: js/bioland-help-comments-1-0-36.js
msgid "Using both:"
msgstr "Hər ikisini istifadə etmək:"

#: js/bioland-help-comments-1-0-36.js
msgid "Content can be both promoted AND sticky for maximum visibility."
msgstr "Məzmun maksimum görünürlük üçün həm təbliğ edilə bilər, həm də yapışqan ola bilər."

#: js/bioland-help-comments-1-0-36.js
msgid "Content sorting priority (highest to lowest):"
msgstr "Məzmun çeşidlənməsi prioriteti (ən yüksəkdən ən aşağı):"

#: js/bioland-help-comments-1-0-36.js
msgid "Sticky"
msgstr "Yapışqan"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Sticky at top of lists\" always appear first"
msgstr "“Siyahıların yuxarısında yapışqan” işarəli maddələr həmişə ilk olaraq görünür"

#: js/bioland-help-comments-1-0-36.js
msgid "Lower numbers appear before higher numbers (e.g., 10 appears before 20)"
msgstr "Aşağı rəqəmlər daha yüksək ədədlərdən əvvəl görünür (məsələn, 10 20-dən əvvəl görünür)"

#: js/bioland-help-comments-1-0-36.js
msgid "Promoted"
msgstr "Təbliğ edildi"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Promoted to front page\" come next"
msgstr "“Ön səhifəyə təbliğ edildi” işarəli maddələr sonrakı gəlir"

#: js/bioland-help-comments-1-0-36.js
msgid "Start Date"
msgstr "Başlama tarixi"

#: js/bioland-help-comments-1-0-36.js
msgid "Then sorted by start date (or published date if no start date)"
msgstr "Sonra başlanğıc tarixinə görə sıralanır (və ya başlanğıc tarixi yoxdursa dərc tarixi)"

#: js/bioland-help-comments-1-0-36.js
msgid "Last Modified"
msgstr "Son dəyişdirilmişdir"

#: js/bioland-help-comments-1-0-36.js
msgid "Finally sorted by most recently updated"
msgstr "Nəhayət, ən son yenilənmiş olaraq sıralanmışdır"

#: js/bioland-help-comments-1-0-36.js
msgid "Tip:"
msgstr "İpucu:"

#: js/bioland-help-comments-1-0-36.js
msgid "Leave empty to use default sorting. Use increments of 10 (e.g., 10, 20, 30) to leave room for inserting items later."
msgstr "Standart çeşidləmədən istifadə etmək üçün boş buraxın. Daha sonra əşyaları yerləşdirmək üçün yer buraxmaq üçün 10 artımlardan (məsələn, 10, 20, 30) istifadə edin."

