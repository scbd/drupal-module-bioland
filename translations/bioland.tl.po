msgstr "Nagsasaad kung ito ay isang Biosafety Land instance."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Mga Setting ng Pag-uugali ng Field"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Paganahin ang Kontrol sa Visibilidad ng Field"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Ipakita/itago ang mga field batay sa pagpili ng uri ng nilalaman. Kinokontrol ang visibilidad ng URL, petsa, at mga na-publish na field."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Paganahin ang mga Karagdagang Field"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Magdagdag ng mga karagdagang field na partikular sa uri ng nilalaman (mga status ng kaganapan, mga status ng proyekto, atbp.) batay sa uri ng nilalaman ng thesaurus."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Paganahin ang Auto Buod"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Awtomatikong bumuo ng buod mula sa nilalaman ng katawan habang nagta-type ang user."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Paganahin ang mga Komento ng Tulong sa Field"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Ipakita ang mga kontekstwal na komento ng tulong para sa mga field batay sa uri ng nilalaman."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Mga Panuntunan sa Visibilidad ng Field"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Tukuyin ang mga custom na panuntunan sa visibilidad ng field (JSON format)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Mga Default sa Pagsasalin"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "I-configure ang paglikha ng mga default sa pagsasalin (mga placeholder ng wika) para sa mga naisasaling entity."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Awtomatikong lumikha ng mga default sa pagsasalin"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Kapag pinagana, ang mga default sa pagsasalin (mga placeholder) ay nililikha para sa ibang mga wika sa paglikha/pag-update ng entity. Ang mga umiiral na pagsasalin na may tamang source ay hindi mapapatungan."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Gamitin ang lahat ng magagamit na wika"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Kapag pinagana, ang mga pagsasalin ay malilikha para sa lahat ng wikang naka-install sa site. Kapag hindi pinagana, tanging ang mga napiling target na wika sa ibaba ang gagamitin."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Mga target na wika para sa mga default sa pagsasalin"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Piliin kung aling mga wika ang lilikhaan ng mga default sa pagsasalin. Ginagamit lamang kapag hindi pinagana ang \"Gamitin ang lahat ng magagamit na wika\"."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopyahin ang mga halaga ng source field"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Kapag pinagana, ang mga naisasaling halaga ng field mula sa source na wika ay kokopyahin sa mga bagong pagsasalin."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Mga uri ng entity"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Piliin kung aling mga uri ng entity ang dapat magkaroon ng mga nilikhang default sa pagsasalin."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Mga Batch na Operasyon"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Iproseso ang mga umiiral na entity upang lumikha ng mga nawawalang default sa pagsasalin."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Uri ng entity na ipoproseso"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Pumili -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Pumili ng isang uri ng entity upang lumikha ng mga pagsasalin para sa mga umiiral na entity."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Lumikha ng mga default sa pagsasalin para sa mga umiiral na entity"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Mangyaring pumili ng isang uri ng entity na ipoproseso."

