#: src/Service/BiolandComponentRegistry.php
msgid "List of national report links, in tabs by country; hidden when the country has no reports."
msgstr "Listahan ng mga link sa mga ulat pambansa, nasa mga tab ayon sa bansa; itinatago kapag walang ulat ang bansa."

#: src/Service/BiolandComponentRegistry.php
msgid "Sixth national report links for the site country, plus the link's own children; hidden when empty."
msgstr "Mga link ng ikaanim na ulat pambansa para sa bansa ng site, kasama ang mga anak ng link; itinatago kapag walang laman."

#: src/Service/BiolandComponentRegistry.php
msgid "Biosafety Clearing-House records for the country, such as laws and decisions; hidden when empty."
msgstr "Mga tala ng Biosafety Clearing-House para sa bansa, gaya ng mga batas at desisyon; itinatago kapag walang laman."

#: src/Service/BiolandComponentRegistry.php
msgid "Access and Benefit-sharing Clearing-House records, such as measures and permits; hidden when empty."
msgstr "Mga tala ng Access and Benefit-sharing Clearing-House, gaya ng mga hakbang at permiso; itinatago kapag walang laman."

#: src/Service/BiolandComponentRegistry.php
msgid "List of national focal points, in tabs by country; hidden when empty."
msgstr "Listahan ng mga pambansang focal point, nasa mga tab ayon sa bansa; itinatago kapag walang laman."

#: src/Service/BiolandComponentRegistry.php
msgid "Links to CBD country profile pages, in tabs by country; always shown."
msgstr "Mga link sa mga pahina ng profile ng bansa ng CBD, nasa mga tab ayon sa bansa; palaging ipinapakita."

#: src/Service/BiolandComponentRegistry.php
msgid "Latest site content of the content types set on this link; hidden when there are no records."
msgstr "Pinakabagong nilalaman ng site mula sa mga uri ng nilalamang nakatakda sa link na ito; itinatago kapag walang tala."

#: src/Service/BiolandComponentRegistry.php
msgid "Latest forum threads, plus the link's own children; hidden when empty."
msgstr "Pinakabagong mga usapan sa forum, kasama ang mga anak ng link; itinatago kapag walang laman."

#: src/Service/BiolandComponentRegistry.php
msgid "National target cards for GBF target 7, in tabs by country; always shown."
msgstr "Mga card ng pambansang target para sa target 7 ng GBF, nasa mga tab ayon sa bansa; palaging ipinapakita."

#: src/Service/BiolandComponentRegistry.php
msgid "One link per content type that has records, plus the link's own children; always shown."
msgstr "Isang link para sa bawat uri ng nilalamang may tala, kasama ang mga anak ng link; palaging ipinapakita."

