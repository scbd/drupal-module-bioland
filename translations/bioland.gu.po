msgstr "કસ્ટમ ફીલ્ડ દૃશ્યતા નિયમો (JSON ફોર્મેટ) વ્યાખ્યાયિત કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "અનુવાદ ડિફોલ્ટ્સ"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "અનુવાદ કરી શકાય તેવી એન્ટિટી માટે અનુવાદ ડિફોલ્ટ્સ (ભાષા પ્લેસહોલ્ડર્સ) ની રચના ગોઠવો."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "આપમેળે અનુવાદ ડિફોલ્ટ્સ બનાવો"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "જ્યારે સક્ષમ હોય, ત્યારે એન્ટિટી બનાવવા/અપડેટ કરવા પર અન્ય ભાષાઓ માટે અનુવાદ ડિફોલ્ટ્સ (પ્લેસહોલ્ડર્સ) બનાવવામાં આવે છે. યોગ્ય સ્રોત સાથેના હાલના અનુવાદો ઓવરરાઇટ થતા નથી."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "બધી ઉપલબ્ધ ભાષાઓનો ઉપયોગ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "જ્યારે સક્ષમ હોય, ત્યારે સાઇટ પર ઇન્સ્ટોલ કરેલી બધી ભાષાઓ માટે અનુવાદો બનાવવામાં આવશે. જ્યારે અક્ષમ હોય, ત્યારે ફક્ત નીચે પસંદ કરેલી લક્ષ્ય ભાષાઓનો ઉપયોગ કરવામાં આવશે."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "અનુવાદ ડિફોલ્ટ્સ માટે લક્ષ્ય ભાષાઓ"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "કઈ ભાષાઓ માટે અનુવાદ ડિફોલ્ટ્સ બનાવવા તે પસંદ કરો. જ્યારે \"બધી ઉપલબ્ધ ભાષાઓનો ઉપયોગ કરો\" અક્ષમ હોય ત્યારે જ વપરાય છે."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "સ્રોત ફીલ્ડ મૂલ્યોની નકલ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "જ્યારે સક્ષમ હોય, ત્યારે સ્રોત ભાષામાંથી અનુવાદ કરી શકાય તેવા ફીલ્ડ મૂલ્યો નવા અનુવાદોમાં નકલ કરવામાં આવશે."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "એન્ટિટી પ્રકારો"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "કયા એન્ટિટી પ્રકારોમાં અનુવાદ ડિફોલ્ટ્સ બનાવવા જોઈએ તે પસંદ કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "બેચ ઓપરેશન્સ"

#: src/Form/BiolandSettingsForm.php
