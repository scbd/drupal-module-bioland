msgstr "શું આ બાયોસેફ્ટી લેન્ડ છે?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "સૂચવે છે કે શું આ બાયોસેફ્ટી લેન્ડનું ઉદાહરણ છે."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "ફીલ્ડ દૃશ્યતા નિયંત્રણ સક્ષમ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "સામગ્રી પ્રકારની પસંદગીના આધારે ફીલ્ડ્સ બતાવો/છુપાવો. URL, તારીખ અને પ્રકાશિત ફીલ્ડ્સની દૃશ્યતાને નિયંત્રિત કરે છે."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "વધારાના ફીલ્ડ્સ સક્ષમ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "થિસોરસ સામગ્રી પ્રકારના આધારે સામગ્રી-પ્રકાર વિશિષ્ટ વધારાના ફીલ્ડ્સ (ઇવેન્ટ સ્થિતિઓ, પ્રોજેક્ટ સ્થિતિઓ, વગેરે) ઉમેરો."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "સ્વતઃ સારાંશ સક્ષમ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "વપરાશકર્તા લખે તેમ મુખ્ય સામગ્રીમાંથી આપમેળે સારાંશ બનાવો."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "ફીલ્ડ મદદ ટિપ્પણીઓ સક્ષમ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "સામગ્રી પ્રકારના આધારે ફીલ્ડ્સ માટે સંદર્ભિત મદદ ટિપ્પણીઓ પ્રદર્શિત કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "ફીલ્ડ દૃશ્યતા નિયમો"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "કસ્ટમ ફીલ્ડ દૃશ્યતા નિયમો (JSON ફોર્મેટ) વ્યાખ્યાયિત કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "અનુવાદ ડિફોલ્ટ્સ"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "આપમેળે અનુવાદ ડિફોલ્ટ્સ બનાવો"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "જ્યારે સક્ષમ હોય, ત્યારે એન્ટિટી બનાવવા/અપડેટ કરવા પર અન્ય ભાષાઓ માટે અનુવાદ ડિફોલ્ટ્સ (પ્લેસહોલ્ડર્સ) બનાવવામાં આવે છે. યોગ્ય સ્રોત સાથેના હાલના અનુવાદો ઓવરરાઇટ થતા નથી."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "બધી ઉપલબ્ધ ભાષાઓનો ઉપયોગ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "જ્યારે સક્ષમ હોય, ત્યારે સાઇટ પર ઇન્સ્ટોલ કરેલી બધી ભાષાઓ માટે અનુવાદો બનાવવામાં આવશે. જ્યારે અક્ષમ હોય, ત્યારે ફક્ત નીચે પસંદ કરેલી લક્ષ્ય ભાષાઓનો ઉપયોગ કરવામાં આવશે."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "અનુવાદ ડિફોલ્ટ્સ માટે લક્ષ્ય ભાષાઓ"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "કઈ ભાષાઓ માટે અનુવાદ ડિફોલ્ટ્સ બનાવવા તે પસંદ કરો. જ્યારે \"બધી ઉપલબ્ધ ભાષાઓનો ઉપયોગ કરો\" અક્ષમ હોય ત્યારે જ વપરાય છે."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "સ્રોત ફીલ્ડ મૂલ્યોની નકલ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "જ્યારે સક્ષમ હોય, ત્યારે સ્રોત ભાષામાંથી અનુવાદ કરી શકાય તેવા ફીલ્ડ મૂલ્યો નવા અનુવાદોમાં નકલ કરવામાં આવશે."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "એન્ટિટી પ્રકારો"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "કયા એન્ટિટી પ્રકારોમાં અનુવાદ ડિફોલ્ટ્સ બનાવવા જોઈએ તે પસંદ કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "બેચ ઓપરેશન્સ"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "ખૂટતા અનુવાદ ડિફોલ્ટ્સ બનાવવા માટે હાલની એન્ટિટી પર પ્રક્રિયા કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "પ્રક્રિયા કરવા માટે એન્ટિટી પ્રકાર"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- પસંદ કરો -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "હાલની એન્ટિટી માટે અનુવાદો બનાવવા માટે એન્ટિટી પ્રકાર પસંદ કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "હાલની એન્ટિટી માટે અનુવાદ ડિફોલ્ટ્સ બનાવો"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "કૃપા કરીને પ્રક્રિયા કરવા માટે એન્ટિટી પ્રકાર પસંદ કરો."

