msgstr "ખૂટતા અનુવાદ ડિફોલ્ટ્સ બનાવવા માટે હાલની એન્ટિટી પર પ્રક્રિયા કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "પ્રક્રિયા કરવા માટે એન્ટિટી પ્રકાર"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- પસંદ કરો -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "હાલની એન્ટિટી માટે અનુવાદો બનાવવા માટે એન્ટિટી પ્રકાર પસંદ કરો."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "હાલની એન્ટિટી માટે અનુવાદ ડિફોલ્ટ્સ બનાવો"

#: src/Form/BiolandSettingsForm.php
