#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "સામગ્રી પ્રકારની પસંદગીના આધારે ફીલ્ડ્સ બતાવો/છુપાવો. URL, તારીખ અને પ્રકાશિત ફીલ્ડ્સની દૃશ્યતાને નિયંત્રિત કરે છે."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "વધારાના ફીલ્ડ્સ સક્ષમ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "થિસોરસ સામગ્રી પ્રકારના આધારે સામગ્રી-પ્રકાર વિશિષ્ટ વધારાના ફીલ્ડ્સ (ઇવેન્ટ સ્થિતિઓ, પ્રોજેક્ટ સ્થિતિઓ, વગેરે) ઉમેરો."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "સ્વતઃ સારાંશ સક્ષમ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "વપરાશકર્તા લખે તેમ મુખ્ય સામગ્રીમાંથી આપમેળે સારાંશ બનાવો."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "ફીલ્ડ મદદ ટિપ્પણીઓ સક્ષમ કરો"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "સામગ્રી પ્રકારના આધારે ફીલ્ડ્સ માટે સંદર્ભિત મદદ ટિપ્પણીઓ પ્રદર્શિત કરો."

