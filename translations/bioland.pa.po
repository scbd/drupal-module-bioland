msgid "Content Ordering"
msgstr "ਸਮਗਰੀ ਆਰਡਰਿੰਗ"

#: src/Form/BiolandSettingsForm.php
msgid "Resets the field_order value to 1000 for all nodes. This creates a new revision for each node with the revision message \"Reset ordering\". The original last updated date and user are preserved. Use this to normalize content ordering across the site."
msgstr "ਸਾਰੇ ਨੋਡਾਂ ਲਈ ਫੀਲਡ_ਆਰਡਰ ਮੁੱਲ ਨੂੰ 1000 ਤੇ ਰੀਸੈਟ ਕਰਦਾ ਹੈ. ਇਹ ਸੰਸ਼ੋਧਨ ਸੰਦੇਸ਼ “ਰੀਸੈਟ ਆਰਡਰਿੰਗ” ਦੇ ਨਾਲ ਹਰੇਕ ਨੋਡ ਲਈ ਇੱਕ ਨਵਾਂ ਸੰਸ਼ੋਧਨ ਬਣਾਉਂਦਾ ਹੈ। ਅਸਲ ਆਖਰੀ ਅਪਡੇਟ ਕੀਤੀ ਤਾਰੀਖ ਅਤੇ ਉਪਭੋਗਤਾ ਸੁਰੱਖਿਅਤ ਹਨ. ਸਾਈਟ ਭਰ ਵਿੱਚ ਸਮਗਰੀ ਦੇ ਕ੍ਰਮ ਨੂੰ ਆਮ ਬਣਾਉਣ ਲਈ ਇਸਦੀ ਵਰਤੋਂ ਕਰੋ।"

#: src/Form/BiolandSettingsForm.php
msgid "Reset Ordering"
msgstr "ਆਰਡਰਿੰਗ ਰੀਸੈਟ ਕਰੋ"

#: src/Form/BiolandSettingsForm.php
msgid "Resetting ordering values..."
msgstr "ਆਰਡਰਿੰਗ ਮੁੱਲਾਂ ਨੂੰ ਰੀਸੈਟ ਕਰਨਾ..."

#: src/Form/BiolandSettingsForm.php
msgid "Drupal cache has been rebuilt successfully."
msgstr "ਡਰੂਪਲ ਕੈਸ਼ ਨੂੰ ਸਫਲਤਾਪੂਰਵਕ ਦੁਬਾਰਾ ਬਣਾਇਆ"

#: src/Form/BiolandSettingsForm.php
msgid "Successfully reset field_order to 1000 for @count nodes."
