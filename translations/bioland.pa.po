#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "ਫੀਲਡ ਦ੍ਰਿਸ਼ਟੀ ਨਿਯੰਤਰਣ ਨੂੰ ਸਮਰੱਥ ਬਣਾਓ"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "ਸਮੱਗਰੀ ਦੀ ਕਿਸਮ ਦੀ ਚੋਣ ਦੇ ਅਧਾਰ ਤੇ ਫੀਲਡ ਦਿਖਾਓ/ਛੁਪਾਓ। URL, ਮਿਤੀ, ਅਤੇ ਪ੍ਰਕਾਸ਼ਿਤ ਫੀਲਡਾਂ ਦੀ ਦ੍ਰਿਸ਼ਟੀ ਨੂੰ ਨਿਯੰਤਰਿਤ ਕਰਦਾ ਹੈ।"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "ਵਾਧੂ ਫੀਲਡਾਂ ਨੂੰ ਸਮਰੱਥ ਬਣਾਓ"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "ਥੀਸੌਰਸ ਸਮੱਗਰੀ ਦੀ ਕਿਸਮ ਦੇ ਅਧਾਰ ਤੇ ਸਮੱਗਰੀ-ਕਿਸਮ ਦੇ ਖਾਸ ਵਾਧੂ ਫੀਲਡ (ਈਵੈਂਟ ਸਥਿਤੀਆਂ, ਪ੍ਰੋਜੈਕਟ ਸਥਿਤੀਆਂ, ਆਦਿ) ਸ਼ਾਮਲ ਕਰੋ।"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "ਆਟੋ ਸੰਖੇਪ ਨੂੰ ਸਮਰੱਥ ਬਣਾਓ"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "ਉਪਭੋਗਤਾ ਦੁਆਰਾ ਟਾਈਪ ਕਰਦੇ ਸਮੇਂ ਸਰੀਰ ਦੀ ਸਮੱਗਰੀ ਤੋਂ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਸੰਖੇਪ ਤਿਆਰ ਕਰੋ।"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "ਫੀਲਡ ਮਦਦ ਟਿੱਪਣੀਆਂ ਨੂੰ ਸਮਰੱਥ ਬਣਾਓ"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "ਸਮੱਗਰੀ ਦੀ ਕਿਸਮ ਦੇ ਅਧਾਰ ਤੇ ਫੀਲਡਾਂ ਲਈ ਪ੍ਰਸੰਗਿਕ ਮਦਦ ਟਿੱਪਣੀਆਂ ਪ੍ਰਦਰਸ਼ਿਤ ਕਰੋ।"

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "ਫੀਲਡ ਦ੍ਰਿਸ਼ਟੀ ਨਿਯਮ"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "ਕਸਟਮ ਫੀਲਡ ਦ੍ਰਿਸ਼ਟੀ ਨਿਯਮਾਂ ਨੂੰ ਪਰਿਭਾਸ਼ਿਤ ਕਰੋ (JSON ਫਾਰਮੈਟ)।"

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "ਅਨੁਵਾਦ ਡਿਫੌਲਟਸ"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "ਅਨੁਵਾਦਯੋਗ ਇਕਾਈਆਂ ਲਈ ਅਨੁਵਾਦ ਡਿਫੌਲਟਸ (ਭਾਸ਼ਾ ਪਲੇਸਹੋਲਡਰ) ਦੀ ਸਿਰਜਣਾ ਨੂੰ ਕੌਂਫਿਗਰ ਕਰੋ।"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਅਨੁਵਾਦ ਡਿਫੌਲਟਸ ਬਣਾਓ"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "ਜਦੋਂ ਸਮਰੱਥ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, ਤਾਂ ਇਕਾਈ ਬਣਾਉਣ/ਅੱਪਡੇਟ ਕਰਨ ਵੇਲੇ ਦੂਜੀਆਂ ਭਾਸ਼ਾਵਾਂ ਲਈ ਅਨੁਵਾਦ ਡਿਫੌਲਟਸ (ਪਲੇਸਹੋਲਡਰ) ਬਣਾਏ ਜਾਂਦੇ ਹਨ। ਸਹੀ ਸਰੋਤ ਵਾਲੇ ਮੌਜੂਦਾ ਅਨੁਵਾਦਾਂ ਨੂੰ ਓਵਰਰਾਈਟ ਨਹੀਂ ਕੀਤਾ ਜਾਂਦਾ ਹੈ।"

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "ਸਾਰੀਆਂ ਉਪਲਬਧ ਭਾਸ਼ਾਵਾਂ ਦੀ ਵਰਤੋਂ ਕਰੋ"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "ਜਦੋਂ ਸਮਰੱਥ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, ਤਾਂ ਸਾਈਟ 'ਤੇ ਸਥਾਪਤ ਸਾਰੀਆਂ ਭਾਸ਼ਾਵਾਂ ਲਈ ਅਨੁਵਾਦ ਬਣਾਏ ਜਾਣਗੇ। ਜਦੋਂ ਅਸਮਰੱਥ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, ਤਾਂ ਸਿਰਫ ਹੇਠਾਂ ਚੁਣੀਆਂ ਗਈਆਂ ਟੀਚਾ ਭਾਸ਼ਾਵਾਂ ਦੀ ਵਰਤੋਂ ਕੀਤੀ ਜਾਵੇਗੀ।"

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "ਅਨੁਵਾਦ ਡਿਫੌਲਟਸ ਲਈ ਟੀਚਾ ਭਾਸ਼ਾਵਾਂ"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "ਚੁਣੋ ਕਿ ਕਿਹੜੀਆਂ ਭਾਸ਼ਾਵਾਂ ਲਈ ਅਨੁਵਾਦ ਡਿਫੌਲਟਸ ਬਣਾਉਣੇ ਹਨ। ਸਿਰਫ ਉਦੋਂ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ ਜਦੋਂ \"ਸਾਰੀਆਂ ਉਪਲਬਧ ਭਾਸ਼ਾਵਾਂ ਦੀ ਵਰਤੋਂ ਕਰੋ\" ਅਸਮਰੱਥ ਹੁੰਦਾ ਹੈ।"

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "ਸਰੋਤ ਫੀਲਡ ਮੁੱਲਾਂ ਦੀ ਨਕਲ ਕਰੋ"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "ਜਦੋਂ ਸਮਰੱਥ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, ਤਾਂ ਸਰੋਤ ਭਾਸ਼ਾ ਤੋਂ ਅਨੁਵਾਦਯੋਗ ਫੀਲਡ ਮੁੱਲਾਂ ਨੂੰ ਨਵੇਂ ਅਨੁਵਾਦਾਂ ਵਿੱਚ ਨਕਲ ਕੀਤਾ ਜਾਵੇਗਾ।"

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "ਇਕਾਈ ਦੀਆਂ ਕਿਸਮਾਂ"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "ਚੁਣੋ ਕਿ ਕਿਹੜੀਆਂ ਇਕਾਈ ਕਿਸਮਾਂ ਲਈ ਅਨੁਵਾਦ ਡਿਫੌਲਟਸ ਬਣਾਏ ਜਾਣੇ ਚਾਹੀਦੇ ਹਨ।"

