msgstr "Okyanusya"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Biyogüvenlik Alanı mı?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Bunun bir Biyogüvenlik Alanı örneği olup olmadığını belirtir."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Alan Davranış Ayarları"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Alan Görünürlük Kontrolünü Etkinleştir"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "İçerik türü seçimine göre alanları göster/gizle. URL, tarih ve yayınlanmış alanların görünürlüğünü kontrol eder."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Ek Alanları Etkinleştir"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Tezaurus içerik türüne göre içerik türüne özgü ek alanlar (etkinlik durumları, proje durumları vb.) ekleyin."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Otomatik Özeti Etkinleştir"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Kullanıcı yazarken gövde içeriğinden otomatik olarak özet oluşturun."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Alan Yardım Yorumlarını Etkinleştir"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "İçerik türüne göre alanlar için bağlamsal yardım yorumları görüntüleyin."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Alan Görünürlük Kuralları"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Özel alan görünürlük kurallarını tanımlayın (JSON formatında)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Çeviri Varsayılanları"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Çevrilebilir varlıklar için çeviri varsayılanlarının (dil yer tutucuları) oluşturulmasını yapılandırın."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Çeviri varsayılanlarını otomatik olarak oluştur"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Etkinleştirildiğinde, varlık oluşturma/güncelleme sırasında diğer diller için çeviri varsayılanları (yer tutucular) oluşturulur. Uygun kaynağa sahip mevcut çevirilerin üzerine yazılmaz."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Mevcut tüm dilleri kullan"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Etkinleştirildiğinde, sitede yüklü olan tüm diller için çeviriler oluşturulacaktır. Devre dışı bırakıldığında, yalnızca aşağıdaki seçili hedef diller kullanılacaktır."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Çeviri varsayılanları için hedef diller"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Hangi diller için çeviri varsayılanları oluşturulacağını seçin. Yalnızca \"Mevcut tüm dilleri kullan\" devre dışı bırakıldığında kullanılır."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kaynak alan değerlerini kopyala"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Etkinleştirildiğinde, kaynak dildeki çevrilebilir alan değerleri yeni çevirilere kopyalanacaktır."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Varlık türleri"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Hangi varlık türleri için çeviri varsayılanları oluşturulması gerektiğini seçin."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Toplu İşlemler"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Eksik çeviri varsayılanlarını oluşturmak için mevcut varlıkları işleyin."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "İşlenecek varlık türü"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Seçiniz -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Mevcut varlıklar için çeviriler oluşturmak üzere bir varlık türü seçin."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Mevcut varlıklar için çeviri varsayılanları oluştur"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Lütfen işlemek için bir varlık türü seçin."

