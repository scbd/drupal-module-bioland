msgstr "Luba väli nähtavuse juhtimine"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Configure which fields are visible for each content type below."
msgstr "Sisutüübi valiku alusel väljade kuvamise/peitmine. Seadistage allpool iga sisutüübi jaoks nähtavad väljad."

#: src/Form/BiolandSettingsForm.php
msgid "URL Field"
msgstr "URL-väli"

#: src/Form/BiolandSettingsForm.php
msgid "Show URL field for these content types:"
msgstr "Kuva URL-väli nende sisutüüpide jaoks:"

