#: js/bioland-help-comments-1-0-36.js
msgid "Content can be both promoted AND sticky for maximum visibility."
msgstr "Maksimaalse nähtavuse tagamiseks saab sisu nii reklaamida KUI ka kleepuvat."

#: js/bioland-help-comments-1-0-36.js
msgid "Content sorting priority (highest to lowest):"
msgstr "Sisu sortimise prioriteet (kõrgeimast madalaimani):"

#: js/bioland-help-comments-1-0-36.js
msgid "Sticky"
msgstr "Kleepuv"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Sticky at top of lists\" always appear first"
msgstr "Üksused, millele on märgitud „Kleepuv loendite ülaosas”, ilmuvad alati"

#: js/bioland-help-comments-1-0-36.js
msgid "Lower numbers appear before higher numbers (e.g., 10 appears before 20)"
msgstr "Madalamad numbrid ilmuvad enne suuremaid numbreid (nt 10 ilmub enne 20)"

#: js/bioland-help-comments-1-0-36.js
msgid "Promoted"
msgstr "Reklaamitud"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Promoted to front page\" come next"
msgstr "Järgmisena tulevad esemed sildiga „Esilehel edutatud”"

#: js/bioland-help-comments-1-0-36.js
msgid "Start Date"
msgstr "Alguskuupäev"

#: js/bioland-help-comments-1-0-36.js
msgid "Then sorted by start date (or published date if no start date)"
msgstr "Seejärel sorteeritakse alguskuupäeva järgi (või avaldamise kuupäev, kui alguskuupäeva pole)"

#: js/bioland-help-comments-1-0-36.js
msgid "Last Modified"
msgstr "Viimati muudetud"

#: js/bioland-help-comments-1-0-36.js
msgid "Finally sorted by most recently updated"
msgstr "Lõpuks sorteeritud viimati uuendatud järgi"

#: js/bioland-help-comments-1-0-36.js
msgid "Tip:"
msgstr "Näpunäide:"

#: js/bioland-help-comments-1-0-36.js
msgid "Leave empty to use default sorting. Use increments of 10 (e.g., 10, 20, 30) to leave room for inserting items later."
msgstr "Vaikimisi sortimise kasutamiseks jätke tühjaks. Kasutage samme 10 (nt 10, 20, 30), et jätta ruumi esemete hilisemaks sisestamiseks."

#: bioland.module
msgid "URL"
msgstr "URL"
