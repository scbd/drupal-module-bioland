msgstr "Begrens ikke-administratorbrukere fra å opprette menyelementer på andre nivå og dypere. Bare brukere med «administrer meny» -tillatelse kan opprette nestede menyelementer."

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Påkrevd)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Obligatorisk:</strong> Velg hvilke enhetstyper som skal ha oversettelsesstandarder opprettet. Du må velge minst én enhetstype for at standardinnstillingene for automatisk oversettelse skal fungere. Vanlig valg: <em>Innhold (node)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Du må velge minst én enhetstype for at standardinnstillingene for automatisk oversettelse skal fungere. Velg en eller flere enhetstyper, eller deaktiver «Opprett oversettelsesstandarder automatisk»."

