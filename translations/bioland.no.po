#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Er biosikkerhetsland?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Indikerer om dette er en biosikkerhetsland-instans."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Innstillinger for feltoppførsel"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Aktiver synlighetskontroll for felt"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Vis/skjul felt basert på valg av innholdstype. Kontrollerer synligheten for URL-, dato- og publiserte felt."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Aktiver tilleggsfelt"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Legg til innholdstypespesifikke tilleggsfelt (hendelsesstatuser, prosjektstatuser, osv.) basert på tesaurus-innholdstype."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Aktiver automatisk sammendrag"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Generer sammendrag automatisk fra brødtekstinnhold mens brukeren skriver."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Aktiver hjelpekommentarer for felt"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Vis kontekstuelle hjelpekommentarer for felt basert på innholdstype."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Regler for feltsynlighet"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Definer egendefinerte regler for feltsynlighet (JSON-format)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Standardinnstillinger for oversettelse"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Konfigurer oppretting av standardoversettelser (plassholdere for språk) for oversettbare enheter."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Opprett standardoversettelser automatisk"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Når aktivert, opprettes standardoversettelser (plassholdere) for andre språk ved oppretting/oppdatering av enheter. Eksisterende oversettelser med riktig kilde blir ikke overskrevet."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Bruk alle tilgjengelige språk"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Når aktivert, vil oversettelser bli opprettet for alle språk som er installert på nettstedet. Når deaktivert, vil bare de valgte målspråkene nedenfor bli brukt."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Målspråk for standardoversettelser"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Velg hvilke språk du vil opprette standardoversettelser for. Brukes bare når \"Bruk alle tilgjengelige språk\" er deaktivert."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopier kildefeltverdier"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Når aktivert, vil oversettbare feltverdier fra kildespråket bli kopiert til nye oversettelser."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Enhetstyper"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Velg hvilke enhetstyper som skal ha standardoversettelser opprettet."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Masseoperasjoner"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Behandle eksisterende enheter for å opprette manglende standardoversettelser."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Enhetstype som skal behandles"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Velg -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Velg en enhetstype for å opprette oversettelser for eksisterende enheter."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Opprett standardoversettelser for eksisterende enheter"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Vennligst velg en enhetstype som skal behandles."

