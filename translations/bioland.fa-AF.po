#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "تنظیمات عمومی"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "کشورها"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "کد هر کشور را در یک خط وارد کنید."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "منطقه"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "منطقه جغرافیایی را انتخاب کنید."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "آمریکای شمالی"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "آمریکای جنوبی"

#: src/Form/BiolandSettingsForm.php
msgid "Europe"
msgstr "اروپا"

#: src/Form/BiolandSettingsForm.php
msgid "Asia"
msgstr "آسیا"

#: src/Form/BiolandSettingsForm.php
msgid "Africa"
msgstr "آفریقا"

#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "اقیانوسیه"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "آیا سرزمین ایمنی زیستی است؟"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "نشان می‌دهد که آیا این یک نمونه از سرزمین ایمنی زیستی است."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "تنظیمات رفتار فیلد"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "فعال کردن کنترل نمایش فیلد"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "نمایش/پنهان کردن فیلدها بر اساس انتخاب نوع محتوا. نمایش فیلدهای URL، تاریخ و منتشر شده را کنترل می‌کند."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "فعال کردن فیلدهای اضافی"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "فیلدهای اضافی خاص نوع محتوا (وضعیت رویدادها، وضعیت پروژه‌ها و غیره) را بر اساس نوع محتوای اصطلاح‌نامه اضافه کنید."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "فعال کردن خلاصه‌سازی خودکار"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "هنگام تایپ کاربر، خلاصه را به طور خودکار از محتوای اصلی تولید کنید."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "فعal کردن نظرات راهنمای فیلد"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "نمایش نظرات راهنمای متنی برای فیلدها بر اساس نوع محتوا."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "قوانین نمایش فیلد"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "قوانین سفارشی نمایش فیلد را تعریف کنید (فرمت JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "پیش‌فرض‌های ترجمه"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "ایجاد پیش‌فرض‌های ترجمه (جانگهدار زبان) را برای موجودیت‌های قابل ترجمه پیکربندی کنید."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "ایجاد خودکار پیش‌فرض‌های ترجمه"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "هنگامی که فعال باشد، پیش‌فرض‌های ترجمه (جانگهدارها) برای زبان‌های دیگر در زمان ایجاد/به‌روزرسانی موجودیت ایجاد می‌شوند. ترجمه‌های موجود با منبع مناسب بازنویسی نمی‌شوند."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "استفاده از تمام زبان‌های موجود"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "هنگامی که فعال باشد، ترجمه‌ها برای تمام زبان‌های نصب شده در سایت ایجاد می‌شوند. هنگامی که غیرفعال باشد، فقط زبان‌های هدف انتخاب شده در زیر استفاده خواهند شد."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "زبان‌های هدف برای پیش‌فرض‌های ترجمه"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "انتخاب کنید برای کدام زبان‌ها پیش‌فرض‌های ترجمه ایجاد شود. فقط زمانی استفاده می‌شود که \"استفاده از تمام زبان‌های موجود\" غیرفعال باشد."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "کپی کردن مقادیر فیلد منبع"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "هنگامی که فعال باشد، مقادیر فیلدهای قابل ترجمه از زبان منبع به ترجمه‌های جدید کپی خواهند شد."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "انواع موجودیت"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "انتخاب کنید کدام انواع موجودیت باید پیش‌فرض‌های ترجمه برایشان ایجاد شود."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "عملیات دسته‌ای"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "پردازش موجودیت‌های موجود برای ایجاد پیش‌فرض‌های ترجمه گمشده."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "نوع موجودیت برای پردازش"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- انتخاب کنید -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "یک نوع موجودیت را برای ایجاد ترجمه برای موجودیت‌های موجود انتخاب کنید."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "ایجاد پیش‌فرض‌های ترجمه برای موجودیت‌های موجود"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "لطفاً یک نوع موجودیت برای پردازش انتخاب کنید."

