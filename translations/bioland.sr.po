#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Omogući ograničenje dubine menija"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Ograničite korisnike koji nisu administratori da kreiraju stavke menija drugog nivoa i dublje. Samo korisnici sa dozvolom za „administriranje menija“ mogu da kreiraju ugnežđene stavke menija."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules (Advanced)"
msgstr "Pravila vidljivosti polja (napredno)"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules in JSON format. Leave empty to use the settings above."
msgstr "Definišite prilagođena pravila vidljivosti polja u JSON formatu. Ostavite prazno da biste koristili gornja podešavanja."

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Obavezno)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Obavezno:</strong> Izaberite koje vrste entiteta treba da imaju kreirane podrazumevane vrednosti prevoda. Morate odabrati najmanje jedan tip entiteta da bi podrazumevana podešavanja automatskog prevođenja funkcionisala. Zajednički izbor: <em>Sadržaj (čvor)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Morate odabrati najmanje jedan tip entiteta da bi podrazumevana podešavanja automatskog prevođenja funkcionisala. Izaberite jedan ili više tipova entiteta ili onemogućite „Automatsko kreiranje podrazumevanih vrednosti prevoda“."

