#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Da li je zemljište za biološku sigurnost?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Označava da li je ovo instanca zemljišta za biološku sigurnost."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Podešavanja ponašanja polja"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Omogući kontrolu vidljivosti polja"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Prikaži/sakrij polja na osnovu izbora tipa sadržaja. Kontroliše vidljivost URL-a, datuma i objavljenih polja."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Omogući dodatna polja"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Dodaj dodatna polja specifična za tip sadržaja (statusi događaja, statusi projekata, itd.) na osnovu tipa sadržaja tezaurusa."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Omogući automatski sažetak"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Automatski generiši sažetak iz sadržaja tela dok korisnik kuca."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Omogući komentare za pomoć u poljima"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Prikaži kontekstualne komentare za pomoć za polja na osnovu tipa sadržaja."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Pravila vidljivosti polja"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Definišite prilagođena pravila vidljivosti polja (JSON format)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Podrazumevane vrednosti prevoda"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Konfigurišite kreiranje podrazumevanih vrednosti prevoda (čuvari mesta za jezik) za prevodive entitete."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Automatski kreiraj podrazumevane vrednosti prevoda"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Kada je omogućeno, podrazumevane vrednosti prevoda (čuvari mesta) se kreiraju za druge jezike prilikom kreiranja/ažuriranja entiteta. Postojeći prevodi sa ispravnim izvorom se ne prepisuju."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Koristi sve dostupne jezike"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Kada je omogućeno, prevodi će biti kreirani za sve jezike instalirane na sajtu. Kada je onemogućeno, koristiće se samo izabrani ciljni jezici ispod."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Ciljni jezici za podrazumevane vrednosti prevoda"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Izaberite za koje jezike da se kreiraju podrazumevane vrednosti prevoda. Koristi se samo kada je opcija \"Koristi sve dostupne jezike\" onemogućena."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopiraj vrednosti izvornih polja"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Kada je omogućeno, vrednosti prevodivih polja sa izvornog jezika će biti kopirane u nove prevode."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Tipovi entiteta"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Izaberite za koje tipove entiteta treba kreirati podrazumevane vrednosti prevoda."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Grupne operacije"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Obradi postojeće entitete da bi se kreirale nedostajuće podrazumevane vrednosti prevoda."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Tip entiteta za obradu"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Izaberi -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Izaberite tip entiteta za kreiranje prevoda za postojeće entitete."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Kreiraj podrazumevane vrednosti prevoda za postojeće entitete"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Molimo izaberite tip entiteta za obradu."

