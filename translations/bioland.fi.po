msgstr "Näytä päivämäärävaihtelukentät (alkamis- ja lopetuspäivämäärä) näille sisältötyypeille:"

#: src/Form/BiolandSettingsForm.php
msgid "Additional Fields Control"
msgstr "Lisäkenttien hallinta"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Ota käyttöön lisäkentät"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Lisää sisältötyyppikohtaisia lisäkenttiä (tapahtumatilat, projektin tilat jne.) tesauruksen sisältötyypin perusteella."

#: src/Form/BiolandSettingsForm.php
msgid "Additional Fields Mapping"
msgstr "Lisäkenttien kartoitus"

#: src/Form/BiolandSettingsForm.php
msgid "The following content types will have these additional fields available:"
msgstr "Seuraavat sisältötyypit sisältävät nämä lisäkentät:"

#: src/Form/BiolandSettingsForm.php
msgid "Event Statuses"
msgstr "Tapahtumatilat"

#: src/Form/BiolandSettingsForm.php
msgid "Project Statuses, Geographic Scopes"
msgstr "Projektin tilat, maantieteelliset laajuudet"

#: src/Form/BiolandSettingsForm.php
msgid "Ministry (8)"
msgstr "Ministeriö (8)"

#: src/Form/BiolandSettingsForm.php
msgid "Organization Types, Government Types"
msgstr "Organisaatiotyypit, Hallitustyypit"

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem (9)"
msgstr "Ekosysteemi (9)"

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem Types"
msgstr "Ekosysteemityypit"

#: src/Form/BiolandSettingsForm.php
msgid "Document Types"
msgstr "Asiakirjatyypit"

#: src/Form/BiolandSettingsForm.php
msgid "These fields are dynamically added based on the selected content type and are powered by a Vue.js component."
msgstr "Nämä kentät lisätään dynaamisesti valitun sisältötyypin perusteella, ja ne toimivat Vue.js -komponentin avulla."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Ota automaattinen yhteenveto käyttöön"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Luo yhteenveto kehon sisällöstä automaattisesti käyttäjätyypeinä."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Ota kentän ohjekommentit käyttöön"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Näytä sisältötyypin mukaiset kenttien kontekstuaaliset ohjekommentit."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Ota valikon syvyysrajoitus käyttöön"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Rajoita muita kuin järjestelmänvalvojan käyttäjiä luomasta toisen tason valikkokohteita ja syvempiä. Vain käyttäjät, joilla on ”hallinta-valikko” -oikeus, voivat luoda sisäkkäisiä valikkokohteita."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules (Advanced)"
msgstr "Kentän näkyvyyssäännöt (lisäasetukset)"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules in JSON format. Leave empty to use the settings above."
msgstr "Määritä mukautetut kentän näkyvyyssäännöt JSON-muodossa. Jätä tyhjäksi käyttääksesi yllä olevia asetuksia."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Käännöksen oletusasetukset"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Määritä käännettävien entiteettien käännösten oletusarvojen (kielipaikkamerkkien) luominen."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Käännösten oletusarvojen luominen automaattisesti"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Kun asetus on käytössä, käännöksen oletusarvot (paikkamerkit) luodaan muille kielille entiteetin luomissa/päivityksen yhteydessä. Olemassa olevia käännöksiä, joissa on oikea lähde, ei korvata."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Käytä kaikkia käytettävissä olevia kieliä"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Kun se on käytössä, käännökset luodaan kaikille sivustolle asennetuille kielille. Kun se on poistettu käytöstä, käytetään vain alla valittuja kohdekieliä."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Käännösten oletusasetusten kohdekielet"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Valitse kielille, joille käännöksen oletusarvot luodaan. Käytetään vain, kun ”Käytä kaikkia käytettävissä olevia kieliä” on poistettu käytöstä."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopioi lähdekentän arvot"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Kun tämä asetus on käytössä, lähdekielen käännettävät kenttäarvot kopioidaan uusiin käännöksiin."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Entiteettityypit"

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Pakollinen)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Pakollinen:</strong> Valitse, millä entiteettityypeillä käännöksen oletusarvot on luotava. Sinun on valittava vähintään yksi entiteettityyppi, jotta automaattisen käännöksen oletusarvot toimivat. Yhteinen valinta: <em>Sisältö (solmu)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Sinun on valittava vähintään yksi entiteettityyppi, jotta automaattisen käännöksen oletusarvot toimivat. Valitse yksi tai useampi entiteettityyppi tai poista ”Luo käännöksen oletusasetukset automaattisesti” käytöstä."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Erätoiminnot"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Käsittele olemassa olevia entiteettejä luodaksesi puuttuvat käännöksen oletusarvot."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Käsiteltävä entiteettityyppi"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Valitse -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Valitse entiteettityyppi, jos haluat luoda käännöksiä olemassa oleville entiteeteille."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Käännösten oletusarvojen luominen olemassa oleville entiteeteille"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Valitse käsiteltävä entiteettityyppi."

