#: src/Service/BiolandComponentRegistry.php
msgid "List of national report links, in tabs by country; hidden when the country has no reports."
msgstr "Lys van skakels na nasionale verslae, in oortjies per land; word versteek wanneer die land geen verslae het nie."

#: src/Service/BiolandComponentRegistry.php
msgid "Sixth national report links for the site country, plus the link's own children; hidden when empty."
msgstr "Skakels van die sesde nasionale verslag vir die werf se land, plus die skakel se eie kinders; word versteek as dit leeg is."

#: src/Service/BiolandComponentRegistry.php
msgid "Biosafety Clearing-House records for the country, such as laws and decisions; hidden when empty."
msgstr "Rekords van die Bioveiligheidsinligtingsentrum vir die land, soos wette en besluite; word versteek as dit leeg is."

#: src/Service/BiolandComponentRegistry.php
msgid "Access and Benefit-sharing Clearing-House records, such as measures and permits; hidden when empty."
msgstr "Rekords van die Inligtingsentrum vir Toegang en Voordeeldeling, soos maatreëls en permitte; word versteek as dit leeg is."

#: src/Service/BiolandComponentRegistry.php
msgid "List of national focal points, in tabs by country; hidden when empty."
msgstr "Lys van nasionale kontakpunte, in oortjies per land; word versteek as dit leeg is."

#: src/Service/BiolandComponentRegistry.php
msgid "Links to CBD country profile pages, in tabs by country; always shown."
msgstr "Skakels na die CBD se landprofielbladsye, in oortjies per land; word altyd gewys."

#: src/Service/BiolandComponentRegistry.php
msgid "Latest site content of the content types set on this link; hidden when there are no records."
msgstr "Nuutste werfinhoud van die inhoudstipes wat op hierdie skakel gestel is; word versteek wanneer daar geen rekords is nie."

#: src/Service/BiolandComponentRegistry.php
msgid "Latest forum threads, plus the link's own children; hidden when empty."
msgstr "Nuutste forumgesprekke, plus die skakel se eie kinders; word versteek as dit leeg is."

#: src/Service/BiolandComponentRegistry.php
msgid "National target cards for GBF target 7, in tabs by country; always shown."
msgstr "Kaarte van nasionale teikens vir GBF-teiken 7, in oortjies per land; word altyd gewys."

#: src/Service/BiolandComponentRegistry.php
msgid "One link per content type that has records, plus the link's own children; always shown."
msgstr "Een skakel per inhoudstipe met rekords, plus die skakel se eie kinders; word altyd gewys."

