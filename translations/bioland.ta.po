#: js/bioland-help-comments-1-0-36.js
msgid "How it Works"
msgstr "இது எப்படி வேலை செய்கிறது"

#: js/bioland-help-comments-1-0-36.js
msgid "Promoted to front page:"
msgstr "முன் பக்கத்திற்கு ஊக்குவிக்கப்பட்டது:"

#: js/bioland-help-comments-1-0-36.js
msgid "Content appears in featured listings, homepage blocks, or \"promoted\" views"
msgstr "சிறப்பு பட்டியல்கள், முகப்புப்பக்கத் தொகுதிகள் அல்லது “விளம்பரப்படுத்தப்பட்ட” பார்வைகளில் உள்ளடக்கம்"

#: js/bioland-help-comments-1-0-36.js
msgid "Useful for highlighting important or timely content"
msgstr "முக்கியமான அல்லது சரியான நேரத்தில் உள்ளடக்கத்தை முன்னிலைப்படுத்த பயன"

#: js/bioland-help-comments-1-0-36.js
msgid "Multiple items can be promoted simultaneously"
msgstr "ஒரே நேரத்தில் பல பொருட்களை விளம்பரப்படுத்தலாம்"

#: js/bioland-help-comments-1-0-36.js
msgid "Sticky at top of lists:"
msgstr "பட்டியல்களின் மேலே ஒட்டியது:"

#: js/bioland-help-comments-1-0-36.js
msgid "Content stays pinned at the top of content listings"
msgstr "உள்ளடக்க பட்டியல்களின் மேலே உள்ளடக்கம் பினிடப்பட்டுள்ளது"

#: js/bioland-help-comments-1-0-36.js
msgid "Remains at top regardless of publication date"
msgstr "வெளியீட்டு தேதியைப் பொருட்படுத்தாமல் மேலே உள்ளது"

#: js/bioland-help-comments-1-0-36.js
msgid "Multiple sticky items appear before non-sticky content"
msgstr "ஒட்டாத உள்ளடக்கத்திற்கு முன் பல ஒட்டும் பொருட்கள் தோன்றும்"

#: js/bioland-help-comments-1-0-36.js
msgid "Using both:"
msgstr "இரண்டையும் பயன்படுத்துதல்:"

#: js/bioland-help-comments-1-0-36.js
msgid "Content can be both promoted AND sticky for maximum visibility."
msgstr "அதிகபட்ச பார்வைக்கு உள்ளடக்கத்தை ஊக்குவிக்கலாம் மற்றும் ஒட்டலாம்."

#: js/bioland-help-comments-1-0-36.js
msgid "Content sorting priority (highest to lowest):"
msgstr "உள்ளடக்க வரிசைப்படுத்தும் முன்னுரிமை (மிக உயர்ந்தது முதல்"

#: js/bioland-help-comments-1-0-36.js
msgid "Sticky"
msgstr "ஒட்டும்"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Sticky at top of lists\" always appear first"
msgstr "“பட்டியல்களின் மேலே ஒட்டும்” என்று குறிக்கப்பட்ட பொருட்கள் எப்போதும் முதலில் தோன்றும்"

#: js/bioland-help-comments-1-0-36.js
msgid "Lower numbers appear before higher numbers (e.g., 10 appears before 20)"
msgstr "அதிக எண்களுக்கு முன் குறைந்த எண்கள் தோன்றும் (எ. கா., 10 20 க்கு முன் தோன்றும்)"

#: js/bioland-help-comments-1-0-36.js
msgid "Promoted"
msgstr "ஊக்குவிக்கப்பட்டது"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Promoted to front page\" come next"
msgstr "“முன்பக்கத்திற்கு ஊக்குவிக்கப்பட்டது” என்று குறிக்கப்பட்ட பொருட்கள் அடுத்து வருகின்றன"

#: js/bioland-help-comments-1-0-36.js
msgid "Start Date"
msgstr "தொடக்க தேதி"

#: js/bioland-help-comments-1-0-36.js
msgid "Then sorted by start date (or published date if no start date)"
msgstr "பின்னர் தொடக்க தேதியின் அடிப்படையில் வரிசைப்படுத்தப்பட்டுள்ளது (அல்லது தொடக்க தேதி இல்லை என்றால் வெளியிடப்பட்ட தேதி)"

#: js/bioland-help-comments-1-0-36.js
msgid "Last Modified"
msgstr "கடைசியாக மாற்றப்பட்டது"

#: js/bioland-help-comments-1-0-36.js
msgid "Finally sorted by most recently updated"
msgstr "இறுதியாக மிக சமீபத்தில் புதுப்பிக்கப்பட்டது"

#: js/bioland-help-comments-1-0-36.js
msgid "Tip:"
msgstr "உதவிக்குறிப்பு:"

#: js/bioland-help-comments-1-0-36.js
msgid "Leave empty to use default sorting. Use increments of 10 (e.g., 10, 20, 30) to leave room for inserting items later."
msgstr "இயல்புநிலை வரிசைப்படுத்தலைப் பயன்படுத்த காலியாக வி பின்னர் பொருட்களைச் செருகுவதற்கு இடம் விட்டுவிட 10 அதிகரிப்புகளைப் பயன்படுத்தவும் (எ. கா., 10, 20, 30)."

