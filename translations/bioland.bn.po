msgstr "বায়োসেফটি ল্যান্ড"

msgid "Bioland"
msgstr "বায়োল্যান্ড"

msgid "@branding Settings"
msgstr "@ব্র্যান্ডিং সেটিংস"

msgid "Field Visibility Control"
msgstr "ফিল্ড দৃশ্যমানতা নিয়ন্ত্রণ"

msgid "Show/hide fields based on content type selection. Configure which fields are visible for each content type below."
msgstr "বিষয়বস্তুর প্রকার নির্বাচনের উপর ভিত্তি করে ফিল্ড দেখান/লুকান। নীচে প্রতিটি বিষয়বস্তুর প্রকারের জন্য কোন ফিল্ডগুলি দৃশ্যমান হবে তা কনফিগার করুন।"

msgid "URL Field"
msgstr "URL ফিল্ড"

msgid "Show URL field for these content types:"
msgstr "এই বিষয়বস্তুর প্রকারগুলির জন্য URL ফিল্ড দেখান:"

msgid "Published Field"
msgstr "প্রকাশিত ফিল্ড"

msgid "Show Published field for these content types:"
msgstr "এই বিষয়বস্তুর প্রকারগুলির জন্য প্রকাশিত ফিল্ড দেখান:"

msgid "Date Range Field (Start & End Date)"
msgstr "তারিখ পরিসীমা ফিল্ড (শুরু এবং শেষের তারিখ)"

msgid "Show Date Range fields (Start & End Date) for these content types:"
msgstr "এই বিষয়বস্তুর প্রকারগুলির জন্য তারিখ পরিসীমা ফিল্ড (শুরু এবং শেষের তারিখ) দেখান:"

