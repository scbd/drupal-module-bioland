msgid "General Settings"
msgstr "সাধারণ সেটিংস"

msgid "Countries"
msgstr "দেশ"

msgid "Enter one country code per line."
msgstr "প্রতি লাইনে একটি করে দেশের কোড লিখুন।"

msgid "Region"
msgstr "অঞ্চল"

msgid "Select the geographical region."
msgstr "ভৌগোলিক অঞ্চল নির্বাচন করুন।"

msgid "North America"
msgstr "উত্তর আমেরিকা"

msgid "South America"
msgstr "দক্ষিণ আমেরিকা"

msgid "Europe"
msgstr "ইউরোপ"

msgid "Asia"
msgstr "এশিয়া"

msgid "Africa"
msgstr "আফ্রিকা"

msgid "Oceania"
msgstr "ওশেনিয়া"

msgid "Is Biosafety Land?"
msgstr "এটি কি বায়োসেফটি ল্যান্ড?"

msgid "Indicates whether this is a Biosafety Land instance."
msgstr "নির্দেশ করে যে এটি একটি বায়োসেফটি ল্যান্ড ইনস্ট্যান্স কিনা।"

msgid "Field Behavior Settings"
msgstr "ফিল্ড আচরণ সেটিংস"

msgid "Enable Field Visibility Control"
msgstr "ফিল্ড দৃশ্যমানতা নিয়ন্ত্রণ সক্ষম করুন"

msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "বিষয়বস্তুর প্রকার নির্বাচনের উপর ভিত্তি করে ফিল্ড দেখান/লুকান। URL, তারিখ, এবং প্রকাশিত ফিল্ডের দৃশ্যমানতা নিয়ন্ত্রণ করে।"

msgid "Enable Additional Tags"
msgstr "অতিরিক্ত ফিল্ড সক্ষম করুন"

msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "থিসোরাস বিষয়বস্তুর প্রকারের উপর ভিত্তি করে বিষয়বস্তু-প্রকার নির্দিষ্ট অতিরিক্ত ফিল্ড (ইভেন্টের অবস্থা, প্রকল্পের অবস্থা, ইত্যাদি) যোগ করুন।"

msgid "Enable Auto Summary"
msgstr "স্বয়ংক্রিয় সারাংশ সক্ষম করুন"

msgid "Automatically generate summary from body content as user types."
msgstr "ব্যবহারকারী টাইপ করার সাথে সাথে মূল বিষয়বস্তু থেকে স্বয়ংক্রিয়ভাবে সারাংশ তৈরি করুন।"

msgid "Enable Field Help Comments"
msgstr "ফিল্ড সহায়তা মন্তব্য সক্ষম করুন"

msgid "Display contextual help comments for fields based on content type."
msgstr "বিষয়বস্তুর প্রকারের উপর ভিত্তি করে ফিল্ডের জন্য প্রাসঙ্গিক সহায়তা মন্তব্য প্রদর্শন করুন।"

msgid "Field Visibility Rules"
msgstr "ফিল্ড দৃশ্যমানতার নিয়ম"

msgid "Define custom field visibility rules (JSON format)."
msgstr "কাস্টম ফিল্ড দৃশ্যমানতার নিয়ম নির্ধারণ করুন (JSON ফরম্যাট)।"

msgid "Translation Defaults"
msgstr "অনুবাদ ডিফল্ট"

msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "অনুবাদযোগ্য সত্তার জন্য অনুবাদ ডিফল্ট (ভাষা স্থানধারক) তৈরির কনফিগার করুন।"

msgid "Automatically create translation defaults"
msgstr "স্বয়ংক্রিয়ভাবে অনুবাদ ডিফল্ট তৈরি করুন"

msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "সক্ষম করা হলে, সত্তা তৈরি/আপডেট করার সময় অন্যান্য ভাষার জন্য অনুবাদ ডিফল্ট (স্থানধারক) তৈরি করা হয়। সঠিক উৎস সহ বিদ্যমান অনুবাদগুলি ওভাররাইট করা হয় না।"

msgid "Use all available languages"
msgstr "সমস্ত উপলব্ধ ভাষা ব্যবহার করুন"

msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "সক্ষম করা হলে, সাইটে ইনস্টল করা সমস্ত ভাষার জন্য অনুবাদ তৈরি করা হবে। অক্ষম করা হলে, শুধুমাত্র নীচের নির্বাচিত লক্ষ্য ভাষাগুলি ব্যবহার করা হবে।"

msgid "Target languages for translation defaults"
msgstr "অনুবাদ ডিফল্টের জন্য লক্ষ্য ভাষা"

msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "কোন ভাষার জন্য অনুবাদ ডিফল্ট তৈরি করতে হবে তা নির্বাচন করুন। শুধুমাত্র যখন \"সমস্ত উপলব্ধ ভাষা ব্যবহার করুন\" অক্ষম থাকে তখন ব্যবহৃত হয়।"

msgid "Copy source field values"
msgstr "উৎস ফিল্ডের মান অনুলিপি করুন"

msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "সক্ষম করা হলে, উৎস ভাষা থেকে অনুবাদযোগ্য ফিল্ডের মানগুলি নতুন অনুবাদে অনুলিপি করা হবে।"

msgid "Entity types"
msgstr "সত্তার প্রকার"

msgid "Select which entity types should have translation defaults created."
msgstr "কোন সত্তার প্রকারের জন্য অনুবাদ ডিফল্ট তৈরি করা উচিত তা নির্বাচন করুন।"

msgid "Batch Operations"
msgstr "ব্যাচ অপারেশন"

msgid "Process existing entities to create missing translation defaults."
msgstr "বিদ্যমান সত্তাগুলি প্রক্রিয়া করে অনুপস্থিত অনুবাদ ডিফল্ট তৈরি করুন।"

msgid "Entity type to process"
msgstr "প্রক্রিয়াকরণের জন্য সত্তার প্রকার"

msgid "- Select -"
msgstr "- নির্বাচন করুন -"

msgid "Select an entity type to create translations for existing entities."
msgstr "বিদ্যমান সত্তার জন্য অনুবাদ তৈরি করতে একটি সত্তার প্রকার নির্বাচন করুন।"

msgid "Create translation defaults for existing entities"
msgstr "বিদ্যমান সত্তার জন্য অনুবাদ ডিফল্ট তৈরি করুন"

msgid "Please select an entity type to process."
msgstr "প্রক্রিয়াকরণের জন্য অনুগ্রহ করে একটি সত্তার প্রকার নির্বাচন করুন।"

