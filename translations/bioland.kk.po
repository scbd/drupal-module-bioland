#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "Жалпы параметрлер"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Елдер"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Бір жолға бір ел кодын енгізіңіз."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Аймақ"

#: src/Form/BiolandSettingsForm.php
