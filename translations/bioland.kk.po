msgstr "Солтүстік Америка"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Оңтүстік Америка"

#: src/Form/BiolandSettingsForm.php
msgid "Europe"
msgstr "Еуропа"

#: src/Form/BiolandSettingsForm.php
msgid "Asia"
msgstr "Азия"

#: src/Form/BiolandSettingsForm.php
msgid "Africa"
msgstr "Африка"

#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "Океания"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Биоқауіпсіздік жері ме?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Бұл Биоқауіпсіздік жері данасы екенін көрсетеді."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Өріс көрінуін басқаруды қосу"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Мазмұн түрін таңдау негізінде өрістерді көрсету/жасыру. URL, күн және жарияланған өрістердің көрінуін басқарады."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Қосымша өрістерді қосу"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Тезаурус мазмұн түріне негізделген мазмұн түріне тән қосымша өрістерді (оқиға күйлері, жоба күйлері, т.б.) қосыңыз."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Автоматты түйіндемені қосу"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Пайдаланушы теріп жатқанда негізгі мазмұннан автоматты түрде түйіндеме жасау."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Өріс анықтамалық түсініктемелерін қосу"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Мазмұн түріне негізделген өрістер үшін контекстік анықтамалық түсініктемелерді көрсету."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Өріс көріну ережелері"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Жеке өріс көріну ережелерін анықтаңыз (JSON форматы)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Аударманың әдепкілері"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Аударманың әдепкілерін автоматты түрде жасау"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Қосылған кезде, нысанды жасау/жаңарту кезінде басқа тілдер үшін аударманың әдепкілері (толтырғыштар) жасалады. Дұрыс көзі бар бұрыннан бар аудармалар қайта жазылмайды."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Барлық қолжетімді тілдерді пайдалану"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Қосылған кезде, сайтта орнатылған барлық тілдер үшін аудармалар жасалады. Өшірілген кезде, тек төменде таңдалған мақсатты тілдер пайдаланылады."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Аударманың әдепкілері үшін мақсатты тілдер"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Аударманың әдепкілерін жасау үшін қай тілдерді таңдаңыз. Тек \"Барлық қолжетімді тілдерді пайдалану\" өшірілген кезде пайдаланылады."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Бастапқы өріс мәндерін көшіру"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Қосылған кезде, бастапқы тілдегі аударылатын өріс мәндері жаңа аудармаларға көшіріледі."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Нысан түрлері"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Аударманың әдепкілері жасалуы керек нысан түрлерін таңдаңыз."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Топтық операциялар"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Жоқ аударманың әдепкілерін жасау үшін бұрыннан бар нысандарды өңдеу."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Өңделетін нысан түрі"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Таңдаңыз -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Бұрыннан бар нысандар үшін аудармалар жасау үшін нысан түрін таңдаңыз."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Бұрыннан бар нысандар үшін аударманың әдепкілерін жасау"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Өңдеу үшін нысан түрін таңдаңыз."

