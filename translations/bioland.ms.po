#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Diperlukan)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Diperlukan:</strong> Pilih jenis entiti mana yang sepatutnya dibuat default terjemahan. Anda mesti memilih sekurang-kurangnya satu jenis entiti untuk default terjemahan automatik berfungsi. Pilihan biasa: <em>Kandungan (nod)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Anda mesti memilih sekurang-kurangnya satu jenis entiti untuk default terjemahan automatik berfungsi. Sila pilih satu atau lebih jenis entiti, atau lumpuhkan “Buat default terjemahan secara automatik”."

