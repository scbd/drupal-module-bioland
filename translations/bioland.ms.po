#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Adakah Tanah Biokeselamatan?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Menunjukkan sama ada ini adalah contoh Tanah Biokeselamatan."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Tetapan Kelakuan Medan"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Dayakan Kawalan Keterlihatan Medan"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Tunjukkan/sembunyikan medan berdasarkan pilihan jenis kandungan. Mengawal keterlihatan URL, tarikh dan medan yang diterbitkan."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Dayakan Medan Tambahan"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Tambah medan tambahan khusus jenis kandungan (status acara, status projek, dll.) berdasarkan jenis kandungan tesaurus."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Dayakan Ringkasan Auto"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Hasilkan ringkasan secara automatik daripada kandungan badan semasa pengguna menaip."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Dayakan Komen Bantuan Medan"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Paparkan komen bantuan kontekstual untuk medan berdasarkan jenis kandungan."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Peraturan Keterlihatan Medan"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Tentukan peraturan keterlihatan medan tersuai (format JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Lalai Terjemahan"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Konfigurasikan penciptaan lalai terjemahan (pemegang tempat bahasa) untuk entiti yang boleh diterjemahkan."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Buat lalai terjemahan secara automatik"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Apabila didayakan, lalai terjemahan (pemegang tempat) dibuat untuk bahasa lain semasa entiti dibuat/dikemas kini. Terjemahan sedia ada dengan sumber yang betul tidak akan ditulis ganti."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Gunakan semua bahasa yang tersedia"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Apabila didayakan, terjemahan akan dibuat untuk semua bahasa yang dipasang di tapak. Apabila dilumpuhkan, hanya bahasa sasaran yang dipilih di bawah akan digunakan."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Bahasa sasaran untuk lalai terjemahan"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Pilih bahasa mana untuk membuat lalai terjemahan. Digunakan hanya apabila \"Gunakan semua bahasa yang tersedia\" dilumpuhkan."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Salin nilai medan sumber"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Apabila didayakan, nilai medan yang boleh diterjemahkan daripada bahasa sumber akan disalin ke terjemahan baharu."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Jenis entiti"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Pilih jenis entiti mana yang sepatutnya mempunyai lalai terjemahan yang dibuat."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operasi Kelompok"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Proses entiti sedia ada untuk mencipta lalai terjemahan yang hilang."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Jenis entiti untuk diproses"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Pilih -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Pilih jenis entiti untuk membuat terjemahan bagi entiti sedia ada."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Buat lalai terjemahan untuk entiti sedia ada"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Sila pilih jenis entiti untuk diproses."

