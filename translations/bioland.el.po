#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Ρυθμίσεις συμπεριφοράς πεδίου"

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Control"
msgstr "Έλεγχος ορατότητας πεδίου"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Ενεργοποίηση ελέγχου ορατότητας πεδίου"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Configure which fields are visible for each content type below."
msgstr "Εμφάνιση ή απόκρυψη πεδίων με βάση την επιλογή τύπου περιεχομένου. Ρυθμίστε ποια πεδία είναι ορατά για κάθε τύπο περιεχομένου παρακάτω."

#: src/Form/BiolandSettingsForm.php
msgid "URL Field"
msgstr "Πεδίο URL"

#: src/Form/BiolandSettingsForm.php
msgid "Show URL field for these content types:"
msgstr "Εμφάνιση πεδίου URL για αυτούς τους τύπους περιεχομένου:"

#: src/Form/BiolandSettingsForm.php
msgid "Published Field"
msgstr "Δημοσιευμένο πεδίο"

#: src/Form/BiolandSettingsForm.php
msgid "Show Published field for these content types:"
msgstr "Εμφάνιση πεδίου Δημοσίευση για αυτούς τους τύπους περιεχομένου:"

#: src/Form/BiolandSettingsForm.php
msgid "Date Range Field (Start & End Date)"
msgstr "Πεδίο εύρους ημερομηνιών (Ημερομηνία έναρξης & λήξης)"

#: src/Form/BiolandSettingsForm.php
msgid "Show Date Range fields (Start & End Date) for these content types:"
msgstr "Εμφάνιση πεδίων Εύρους ημερομηνιών (Ημερομηνία έναρξης και λήξης) για αυτούς τους τύπους περιεχομένου:"

#: src/Form/BiolandSettingsForm.php
msgid "Additional Fields Control"
msgstr "Έλεγχος πρόσθετων πεδίων"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Ενεργοποίηση πρόσθετων πεδίων"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Προσθέστε πρόσθετα πεδία συγκεκριμένου τύπου περιεχομένου (καταστάσεις συμβάντων, καταστάσεις έργου κ.λπ.) με βάση τον τύπο περιεχομένου θησαυρού."

#: src/Form/BiolandSettingsForm.php
msgid "Additional Fields Mapping"
msgstr "Χαρτογράφηση πρόσθετων πεδίων"

#: src/Form/BiolandSettingsForm.php
msgid "The following content types will have these additional fields available:"
msgstr "Οι ακόλουθοι τύποι περιεχομένου θα έχουν αυτά τα πρόσθετα πεδία διαθέσιμα:"

#: src/Form/BiolandSettingsForm.php
msgid "Event Statuses"
msgstr "Κατάσταση συμβάντων"

#: src/Form/BiolandSettingsForm.php
msgid "Project Statuses, Geographic Scopes"
msgstr "Κατάσταση Έργου, Γεωγραφικά πεδία"

#: src/Form/BiolandSettingsForm.php
msgid "Ministry (8)"
msgstr "Υπουργείο (8)"

#: src/Form/BiolandSettingsForm.php
msgid "Organization Types, Government Types"
msgstr "Τύποι Οργανισμού, Τύποι Κυβέρνησης"

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem (9)"
msgstr "Οικοσύστημα (9)"

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem Types"
msgstr "Τύποι οικοσυστημάτων"

#: src/Form/BiolandSettingsForm.php
msgid "Document Types"
msgstr "Τύποι εγγράφων"

#: src/Form/BiolandSettingsForm.php
msgid "These fields are dynamically added based on the selected content type and are powered by a Vue.js component."
msgstr "Αυτά τα πεδία προστίθενται δυναμικά με βάση τον επιλεγμένο τύπο περιεχομένου και τροφοδοτούνται από ένα στοιχείο Vue.js."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Ενεργοποίηση αυτόματης σύνοψης"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Δημιουργήστε αυτόματα περίληψη από το περιεχόμενο του σώματος ως τύπους χρηστών."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Ενεργοποίηση σχολίων βοήθειας πεδίου"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Εμφάνιση σχολίων βοήθειας με βάση τα συμφραζόμενα για πεδία με βάση τον τύπο περιεχομένου."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Ενεργοποίηση περιορισμού βάθους μενού"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Περιορίστε τους χρήστες που δεν είναι διαχειριστές από τη δημιουργία στοιχείων μενού δεύτερου επιπέδου και βαθύτερα. Μόνο οι χρήστες με άδεια «διαχειριστής μενού» μπορούν να δημιουργήσουν ένθετα στοιχεία μενού."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules (Advanced)"
msgstr "Κανόνες ορατότητας πεδίου (για προχωρημένους)"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules in JSON format. Leave empty to use the settings above."
msgstr "Ορίστε προσαρμοσμένους κανόνες ορατότητας πεδίου σε μορφή JSON. Αφήστε κενό για να χρησιμοποιήσετε τις παραπάνω ρυθμίσεις."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Προεπιλογές μετάφρασης"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Διαμορφώστε τη δημιουργία προεπιλογών μετάφρασης (σύμβολα κράτησης θέσης γλώσσας) για μεταφράσιμες οντότητες."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Αυτόματη δημιουργία προεπιλογών μετάφρασης"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Όταν είναι ενεργοποιημένη, δημιουργούνται προεπιλογές μετάφρασης (κράτη-θέσεις) για άλλες γλώσσες κατά τη δημιουργία ή ενημέρωση οντότητας. Οι υπάρχουσες μεταφράσεις με σωστή πηγή δεν αντικαθίστανται."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Χρησιμοποιήστε όλες τις διαθέσιμες γλώσσες"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Όταν ενεργοποιηθεί, θα δημιουργηθούν μεταφράσεις για όλες τις γλώσσες που είναι εγκατεστημένες στον ιστότοπο. Όταν απενεργοποιηθεί, θα χρησιμοποιηθούν μόνο οι επιλεγμένες γλώσσες προορισμού παρακάτω."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Γλώσσες προορισμού για τις προεπιλογές μετάφρασης"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Επιλέξτε τις γλώσσες για τις οποίες θα δημιουργηθούν οι προεπιλογές μετάφρασης. Χρησιμοποιείται μόνο όταν είναι απενεργοποιημένη η επιλογή «Χρήση όλων των διαθέσιμων γλωσσών»."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Αντιγραφή τιμών πεδίου προέλευσης"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Όταν ενεργοποιηθεί, οι μεταφράσιμες τιμές πεδίων από τη γλώσσα προέλευσης θα αντιγραφούν σε νέες μεταφράσεις."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Τύποι οντοτήτων"

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Απαιτείται)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Απαιτείται:</strong> Επιλέξτε ποιοι τύποι οντοτήτων θα πρέπει να έχουν δημιουργηθεί προεπιλογές μετάφρασης. Πρέπει να επιλέξετε τουλάχιστον έναν τύπο οντότητας για να λειτουργούν οι προεπιλογές αυτόματης μετάφρασης. Κοινή επιλογή: <em>Περιεχόμενο (κόμβος)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Πρέπει να επιλέξετε τουλάχιστον έναν τύπο οντότητας για να λειτουργούν οι προεπιλογές αυτόματης μετάφρασης. Επιλέξτε έναν ή περισσότερους τύπους οντοτήτων ή απενεργοποιήστε την επιλογή «Αυτόματη δημιουργία προεπιλογών μετάφρασης»."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Λειτουργίες παρτίδας"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Επεξεργαστείτε υπάρχουσες οντότητες για να δημιουργήσετε προεπιλογές μετάφρασης που λείπουν."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Τύπος οντότητας προς επεξεργασία"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Επιλέξτε -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Επιλέξτε έναν τύπο οντότητας για να δημιουργήσετε μεταφράσεις για υπάρχουσες οντότητες."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Δημιουργία προεπιλογών μετάφρασης για υπάρχουσες οντότητες"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Επιλέξτε έναν τύπο οντότητας για επεξεργασία."

