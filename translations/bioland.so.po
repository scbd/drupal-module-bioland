#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Geli hal kood wadan halkii sadar."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Gobolka"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Dooro gobolka juqraafi ahaan."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Waqooyiga Ameerika"

#: src/Form/BiolandSettingsForm.php
