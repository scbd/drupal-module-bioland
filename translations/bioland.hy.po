#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Պահանջվում է)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Պահանջվում</strong> է. Ընտրեք, թե որ սուբյեկտների տեսակները պետք է ստեղծվեն թարգմանության կանխադրյալներ: Ավտոմատ թարգմանության նախադրյալները աշխատելու համար դուք պետք է ընտրեք առնվազն մեկ սուբյեկտի տեսակ: Ընդհանուր ընտրություն. Բով <em>անդակություն (հանգույց)</em>:"

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Ավտոմատ թարգմանության նախադրյալները աշխատելու համար դուք պետք է ընտրեք առնվազն մեկ սուբյեկտի տեսակ: Խնդրում ենք ընտրել մեկ կամ մի քանի սուբյեկտների տեսակներ կամ անջատել “Ավտոմատ կերպով ստեղծել թարգմանության նախադրյալներ”:"

