#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Միացնել ավտոմատ ամփոփումը"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Օգտատիրոջ մուտքագրման ընթացքում ավտոմատ կերպով ստեղծել ամփոփում հիմնական բովանդակությունից:"

