#: js/bioland.help-comments.js
msgid "Help"
msgstr "Օգնություն"

#: js/bioland.help-comments.js
msgid "This will be the main content of your new site content.  The summary can be used to display a brief concise description of your content.  Further, the summary  will be displayed in list and card views of your record on the website.  Alternatively, the first few sentence from the main content will be used."
msgstr "Սա կլինի ձեր նոր կայքի բովանդակության հիմնական մասը: Ամփոփումը կարող է օգտագործվել ձեր բովանդակության համառոտ նկարագրությունը ցուցադրելու համար: Ավելին, ամփոփումը կցուցադրվի ձեր գրառման ցուցակային և քարտային տեսքերում կայքում: Այլընտրանքորեն, կօգտագործվեն հիմնական բովանդակության առաջին մի քանի նախադասությունները:"

#: js/bioland.help-comments.js
msgid "Images"
msgstr "Նկարներ"

#: js/bioland.help-comments.js
msgid "The <b>first image</b> in order of left to right here, <b>will be the main image</b> of your record displayed on the page and in thumbnails in list and card views.  All another images will be displayed below the main content."
msgstr "Այստեղ ձախից աջ հերթականությամբ <b>առաջին նկարը</b> <b>կլինի ձեր գրառման հիմնական նկարը</b>, որը կցուցադրվի էջում և մանրապատկերներում՝ ցուցակային և քարտային տեսքերում: Մնացած բոլոր նկարները կցուցադրվեն հիմնական բովանդակությունից ներքև:"

#: js/bioland.help-comments.js
msgid "Heroes"
msgstr "Հերոսներ"

#: js/bioland.help-comments.js
msgid "Any page/content type can have multiple <b>hero banners</b>.  If there is more then one they will be rotated on an hourly basis."
msgstr "Ցանկացած էջ/բովանդակության տեսակ կարող է ունենալ բազմաթիվ <b>հերոսական բաներներ</b>: Եթե մեկից ավելի լինեն, դրանք կպտտվեն ժամային հիմունքներով:"

