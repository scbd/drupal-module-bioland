#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Մշակման ենթակա օբյեկտի տեսակ"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Ընտրել -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Ընտրեք օբյեկտի տեսակ՝ գոյություն ունեցող օբյեկտների համար թարգմանություններ ստեղծելու համար:"

