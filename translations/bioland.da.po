msgstr "Generer automatisk resumé fra brødindhold som brugertyper."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Aktiver felthjælpekommentarer"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Vis kontekstuelle hjælpekommentarer for felter baseret på indholdstype."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Oversættelsesstandarder"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Opret automatisk oversættelsesstandarder"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Når dette er aktiveret, oprettes oversættelsesstandarder (pladsholdere) for andre sprog ved oprettelse/opdatering af objekt. Eksisterende oversættelser med korrekt kilde overskrives ikke."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Brug alle tilgængelige sprog"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Når aktiveret, oprettes oversættelser for alle sprog, der er installeret på webstedet. Når deaktiveret, vil kun de valgte målsprog nedenfor blive brugt."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Målsprog for oversættelsesstandarder"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Vælg, hvilke sprog der skal oprettes oversættelsesstandarder for. Bruges kun, når „Brug alle tilgængelige sprog“ er deaktiveret."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopier kildefeltværdier"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Når aktiveret, kopieres oversættelige feltværdier fra kildesproget til nye oversættelser."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Enhedstyper"

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Påkrævet)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Påkrævet:</strong> Vælg, hvilke objekttyper der skal have oprettet oversættelsesstandarder. Du skal vælge mindst én objekttype for at automatiske oversættelsesstandarder kan fungere. Fælles valg: <em>Indhold (node)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Du skal vælge mindst én objekttype for at automatiske oversættelsesstandarder kan fungere. Vælg en eller flere objekttyper, eller deaktiver „Opret automatisk oversættelsesstandarder“."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Batchoperationer"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Behandle eksisterende objekter for at oprette manglende oversættelsesstandarder."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Enhedstype, der skal behandles"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Vælg -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Vælg en objekttype for at oprette oversættelser til eksisterende objekter."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Opret oversættelsesstandarder for eksisterende objekter"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Vælg en objekttype, der skal behandles."

