#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "کیا یہ بائیو سیفٹی لینڈ ہے؟"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "اس بات کی نشاندہی کرتا ہے کہ آیا یہ بائیو سیفٹی لینڈ کی ایک مثال ہے۔"

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "فیلڈ رویے کی ترتیبات"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "فیلڈ کی مرئیت کا کنٹرول فعال کریں"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "مواد کی قسم کے انتخاب کی بنیاد پر فیلڈز دکھائیں/چھپائیں۔ یو آر ایل، تاریخ، اور شائع شدہ فیلڈز کی مرئیت کو کنٹرول کرتا ہے۔"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "اضافی فیلڈز فعال کریں"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "تھیسورس مواد کی قسم کی بنیاد پر مواد کی قسم کے لیے مخصوص اضافی فیلڈز (ایونٹ کی حیثیت، پروجیکٹ کی حیثیت، وغیرہ) شامل کریں۔"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "خودکار خلاصہ فعال کریں"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "صارف کے ٹائپ کرتے وقت باڈی مواد سے خود بخود خلاصہ بنائیں۔"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "فیلڈ مدد کے تبصرے فعال کریں"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "مواد کی قسم کی بنیاد پر فیلڈز کے لیے سیاق و سباق کے مطابق مدد کے تبصرے دکھائیں۔"

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "فیلڈ کی مرئیت کے قواعد"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "حسب ضرورت فیلڈ کی مرئیت کے قواعد (JSON فارمیٹ) کی وضاحت کریں۔"

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "ترجمہ کے ڈیفالٹس"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "قابل ترجمہ اداروں کے لیے ترجمہ کے ڈیفالٹس (زبان کے پلیس ہولڈرز) کی تشکیل کو ترتیب دیں۔"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "خود بخود ترجمہ کے ڈیفالٹس بنائیں"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "فعال ہونے پر، ادارہ بنانے/اپ ڈیٹ کرنے پر دوسری زبانوں کے لیے ترجمہ کے ڈیفالٹس (پلیس ہولڈرز) بنائے جاتے ہیں۔ مناسب ماخذ کے ساتھ موجودہ تراجم کو اوور رائٹ نہیں کیا جاتا ہے۔"

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "تمام دستیاب زبانیں استعمال کریں"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "فعال ہونے پر، سائٹ پر نصب تمام زبانوں کے لیے تراجم بنائے جائیں گے۔ غیر فعال ہونے پر، صرف ذیل میں منتخب کردہ ہدف کی زبانیں استعمال کی جائیں گی۔"

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "ترجمہ کے ڈیفالٹس کے لیے ہدف کی زبانیں"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "منتخب کریں کہ کن زبانوں کے لیے ترجمہ کے ڈیفالٹس بنانے ہیں۔ صرف اس وقت استعمال ہوتا ہے جب \"تمام دستیاب زبانیں استعمال کریں\" غیر فعال ہو۔"

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "ماخذ فیلڈ کی قدریں کاپی کریں"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "فعال ہونے پر، ماخذ زبان سے قابل ترجمہ فیلڈ کی قدریں نئے تراجم میں کاپی کی جائیں گی۔"

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "ادارے کی اقسام"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "منتخب کریں کہ کن ادارے کی اقسام کے لیے ترجمہ کے ڈیفالٹس بنائے جانے چاہئیں۔"

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "بیچ آپریشنز"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "گمشدہ ترجمہ کے ڈیفالٹس بنانے کے لیے موجودہ اداروں پر کارروائی کریں۔"

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "کارروائی کے لیے ادارے کی قسم"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- منتخب کریں -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "موجودہ اداروں کے لیے تراجم بنانے کے لیے ایک ادارے کی قسم منتخب کریں۔"

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "موجودہ اداروں کے لیے ترجمہ کے ڈیفالٹس بنائیں"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "براہ کرم کارروائی کے لیے ایک ادارے کی قسم منتخب کریں۔"

