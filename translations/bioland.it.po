#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "È un'area di biosicurezza?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Indica se questa è un'istanza di area di biosicurezza."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Impostazioni Comportamento Campi"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Abilita Controllo Visibilità Campi"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Mostra/nascondi campi in base alla selezione del tipo di contenuto. Controlla la visibilità dei campi URL, data e pubblicati."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Abilita Campi Aggiuntivi"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Aggiungi campi aggiuntivi specifici per tipo di contenuto (stati di eventi, stati di progetti, ecc.) in base al tipo di contenuto del thesaurus."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Abilita Riepilogo Automatico"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Genera automaticamente un riepilogo dal contenuto del corpo mentre l'utente digita."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Abilita Commenti di Aiuto per i Campi"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Visualizza commenti di aiuto contestuali per i campi in base al tipo di contenuto."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Regole di Visibilità dei Campi"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Definisci regole di visibilità dei campi personalizzate (formato JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Impostazioni Predefinite di Traduzione"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Configura la creazione di impostazioni predefinite di traduzione (segnaposto di lingua) per le entità traducibili."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Crea automaticamente le impostazioni predefinite di traduzione"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Quando abilitato, le impostazioni predefinite di traduzione (segnaposto) vengono create per altre lingue alla creazione/aggiornamento dell'entità. Le traduzioni esistenti con una fonte corretta non vengono sovrascritte."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Usa tutte le lingue disponibili"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Quando abilitato, le traduzioni verranno create per tutte le lingue installate sul sito. Quando disabilitato, verranno utilizzate solo le lingue di destinazione selezionate di seguito."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Lingue di destinazione per le impostazioni predefinite di traduzione"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Seleziona per quali lingue creare le impostazioni predefinite di traduzione. Utilizzato solo quando \"Usa tutte le lingue disponibili\" è disabilitato."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Copia i valori dei campi di origine"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Quando abilitato, i valori dei campi traducibili dalla lingua di origine verranno copiati nelle nuove traduzioni."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Tipi di entità"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Seleziona per quali tipi di entità devono essere create le impostazioni predefinite di traduzione."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operazioni Batch"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Elabora le entità esistenti per creare le impostazioni predefinite di traduzione mancanti."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Tipo di entità da elaborare"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Seleziona -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Seleziona un tipo di entità per creare traduzioni per le entità esistenti."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Crea impostazioni predefinite di traduzione per le entità esistenti"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Seleziona un tipo di entità da elaborare."

