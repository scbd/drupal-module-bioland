#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Iespējot izvēlnes dziļuma ierobežo"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Ierobežojiet lietotājiem, kas nav administratori, izveidot otrā līmeņa izvēlnes vienumus un dziļāk. Tikai lietotāji ar atļauju “administrēt izvēlni” var izveidot ligzdotus izvēlnes vienumus."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules (Advanced)"
msgstr "Lauka redzamības noteikumi (papildu)"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules in JSON format. Leave empty to use the settings above."
msgstr "Definējiet pielāgotas lauka redzamības kārtulas JSON formātā. Atstājiet tukšu, lai izmantotu iepriekš minētos iestatījumus."

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Nepieciešams)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Nepieciešams:</strong> atlasiet, kuriem entītiju veidiem jābūt izveidotiem tulkošanas noklusējuma iestatījumiem. Lai automātiskās tulkošanas noklusējuma iestatījumi darbotos, ir jāizvēlas vismaz viens entītijas tips. Kopēja izvēle: <em>saturs (mezgls)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Lai automātiskās tulkošanas noklusējuma iestatījumi darbotos, ir jāizvēlas vismaz viens entītijas tips. Lūdzu, atlasiet vienu vai vairākus entītiju veidus vai atspējojiet “Automātiski izveidot tulkošanas noklusējumus”."

