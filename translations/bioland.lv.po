#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Valstis"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Ievadiet vienu valsts kodu katrā rindā."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Reģions"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Atlasiet ģeogrāfisko reģionu."

#: src/Form/BiolandSettingsForm.php
