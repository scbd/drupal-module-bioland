msgstr "Land für biologische Sicherheit"

#: src/Form/BiolandSettingsForm.php
msgid "@branding Settings"
msgstr "@branding Einstellungen"

#: src/Form/BiolandSettingsForm.php
msgid "Site name"
msgstr "Name der Seite"

#: src/Form/BiolandSettingsForm.php
msgid "Slogan"
msgstr "Slogan"

#: src/Form/BiolandSettingsForm.php
msgid "How this is used depends on your site's theme."
msgstr "Wie das verwendet wird, hängt vom Theme deiner Website ab."

#: src/Form/BiolandSettingsForm.php
msgid "Email address"
msgstr "E-Mail-Adresse"

#: src/Form/BiolandSettingsForm.php
msgid "The <em>From</em> address in automated e-mails sent during registration and new password requests, and other notifications. (Use an address ending in your site's domain to help prevent this e-mail being flagged as spam.)"
msgstr "Die <em>Absenderadresse</em> in automatisierten E-Mails, die während der Registrierung gesendet werden, sowie bei Anfragen nach neuen Passwörtern und anderen Benachrichtigungen. (Verwenden Sie eine Adresse, die auf die Domain Ihrer Website endet, um zu verhindern, dass diese E-Mail als Spam gekennzeichnet wird.)"

#: src/Form/BiolandSettingsForm.php
msgid "Translate Site Name"
msgstr "Übersetze den Namen der Seite"

#: src/Form/BiolandSettingsForm.php
msgid "Translate Slogan"
msgstr "Übersetze Slogan"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Länder"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Geben Sie eine Landesvorwahl pro Zeile ein."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Region"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Wählen Sie die geografische Region aus."

