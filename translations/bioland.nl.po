#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Schakel zichtbaarheidscontrole voor velden in"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Velden tonen/verbergen op basis van selectie van inhoudstype. Regelt de zichtbaarheid van URL-, datum- en publicatievelden."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Schakel extra velden in"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Voeg inhoudstype-specifieke extra velden toe (evenementstatussen, projectstatussen, etc.) op basis van het thesaurus-inhoudstype."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Schakel automatische samenvatting in"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Genereer automatisch een samenvatting van de hoofdtekst terwijl de gebruiker typt."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Schakel helpcommentaar voor velden in"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Toon contextuele helpcommentaren voor velden op basis van het inhoudstype."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Zichtbaarheidsregels voor velden"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Definieer aangepaste zichtbaarheidsregels voor velden (JSON-formaat)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Standaard vertalingen"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Automatisch standaard vertalingen aanmaken"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Indien ingeschakeld, worden standaard vertalingen (placeholders) aangemaakt voor andere talen bij het aanmaken/bijwerken van een entiteit. Bestaande vertalingen met de juiste bron worden niet overschreven."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Gebruik alle beschikbare talen"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Indien ingeschakeld, worden vertalingen aangemaakt voor alle talen die op de site zijn geïnstalleerd. Indien uitgeschakeld, worden alleen de hieronder geselecteerde doeltalen gebruikt."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Doeltalen voor standaard vertalingen"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Selecteer voor welke talen standaard vertalingen moeten worden aangemaakt. Alleen gebruikt wanneer \"Gebruik alle beschikbare talen\" is uitgeschakeld."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopieer bronveldwaarden"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Indien ingeschakeld, worden vertaalbare veldwaarden uit de brontaal gekopieerd naar nieuwe vertalingen."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Entiteitstypes"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Selecteer voor welke entiteitstypes standaard vertalingen moeten worden aangemaakt."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Batchbewerkingen"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Verwerk bestaande entiteiten om ontbrekende standaard vertalingen aan te maken."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Te verwerken entiteitstype"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Selecteer -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Selecteer een entiteitstype om vertalingen voor bestaande entiteiten aan te maken."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Standaard vertalingen voor bestaande entiteiten aanmaken"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Selecteer een entiteitstype om te verwerken."

