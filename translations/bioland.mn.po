#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "Ерөнхий тохиргоо"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Улсууд"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Нэг мөрөнд нэг улсын код оруулна уу."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Бүс нутаг"

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Хойд Америк"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Өмнөд Америк"

#: src/Form/BiolandSettingsForm.php
msgid "Europe"
msgstr "Европ"

#: src/Form/BiolandSettingsForm.php
