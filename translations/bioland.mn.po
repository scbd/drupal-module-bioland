msgstr "Африк"

#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "Далайн орнууд"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Энэ нь Биоаюулгүй байдлын газар мөн үү?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Энэ нь Биоаюулгүй байдлын газрын жишээ эсэхийг заана."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Талбарын ажиллагааны тохиргоо"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Талбарын харагдацын хяналтыг идэвхжүүлэх"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Агуулгын төрлийн сонголтод үндэслэн талбаруудыг харуулах/нуух. URL, огноо, нийтлэгдсэн талбаруудын харагдацыг хянана."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Нэмэлт талбаруудыг идэвхжүүлэх"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Тезаурусын агуулгын төрөлд үндэслэн агуулгын төрөлд хамаарах нэмэлт талбаруудыг (үйл явдлын төлөв, төслийн төлөв гэх мэт) нэмэх."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Автомат хураангуйг идэвхжүүлэх"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Хэрэглэгч бичиж байх үед үндсэн агуулгаас хураангуйг автоматаар үүсгэх."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Талбарын тусламжийн сэтгэгдлийг идэвхжүүлэх"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Агуулгын төрөлд үндэслэн талбаруудад зориулсан контекст тусламжийн сэтгэгдлийг харуулах."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Талбарын харагдацын дүрэм"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Талбарын харагдацын дүрмийг (JSON форматаар) тодорхойлох."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Орчуулгын анхдагч утгууд"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Орчуулагдах боломжтой нэгжүүдэд зориулсан орчуулгын анхдагч утгуудыг (хэлний байр эзлэгч) үүсгэх тохиргоо."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Орчуулгын анхдагч утгуудыг автоматаар үүсгэх"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Идэвхжүүлсэн үед, нэгжийг үүсгэх/шинэчлэх үед бусад хэлэнд зориулсан орчуулгын анхдагч утгууд (байр эзлэгч) үүсгэгдэнэ. Зөв эх сурвалжтай одоо байгаа орчуулгууд дахин бичигдэхгүй."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Бүх боломжит хэлийг ашиглах"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Идэвхжүүлсэн үед, сайтад суулгасан бүх хэлэнд орчуулга үүсгэгдэнэ. Идэвхгүй болгосон үед, зөвхөн доорх сонгосон зорилтот хэлнүүд ашиглагдана."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Орчуулгын анхдагч утгуудад зориулсан зорилтот хэлнүүд"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Орчуулгын анхдагч утгуудыг ямар хэлэнд үүсгэхээ сонгоно уу. Зөвхөн \"Бүх боломжит хэлийг ашиглах\" идэвхгүй үед ашиглагдана."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Эх талбарын утгуудыг хуулах"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Идэвхжүүлсэн үед, эх хэлний орчуулагдах боломжтой талбарын утгууд шинэ орчуулга руу хуулагдана."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Нэгжийн төрлүүд"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Ямар нэгжийн төрлүүдэд орчуулгын анхдагч утгууд үүсгэх ёстойг сонгоно уу."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Багц үйлдлүүд"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Одоо байгаа нэгжүүдийг боловсруулж, дутуу орчуулгын анхдагч утгуудыг үүсгэх."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Боловсруулах нэгжийн төрөл"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Сонгох -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Одоо байгаа нэгжүүдэд орчуулга үүсгэхийн тулд нэгжийн төрлийг сонгоно уу."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Одоо байгаа нэгжүүдэд орчуулгын анхдагч утгуудыг үүсгэх"

