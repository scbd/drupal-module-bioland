msgstr "Улсууд"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Нэг мөрөнд нэг улсын код оруулна уу."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Бүс нутаг"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Газарзүйн бүс нутгийг сонгоно уу."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Хойд Америк"

#: src/Form/BiolandSettingsForm.php
