#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "A është Tokë e Biosigurisë?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Tregon nëse kjo është një instancë e Tokës së Biosigurisë."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Cilësimet e Sjelljes së Fushës"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Aktivizo Kontrollin e Dukshmërisë së Fushës"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Shfaq/fsheh fushat bazuar në zgjedhjen e llojit të përmbajtjes. Kontrollon dukshmërinë e fushave të URL-së, datës dhe publikimit."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Aktivizo Fushat Shtesë"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Shto fusha shtesë specifike për llojin e përmbajtjes (statuset e ngjarjeve, statuset e projekteve, etj.) bazuar në llojin e përmbajtjes së tezaurit."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Aktivizo Përmbledhjen Automatike"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Gjenero automatikisht përmbledhje nga përmbajtja e trupit ndërsa përdoruesi shtyp."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Aktivizo Komentet e Ndihmës së Fushës"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Shfaq komente ndihmëse kontekstuale për fushat bazuar në llojin e përmbajtjes."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Rregullat e Dukshmërisë së Fushës"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Përcaktoni rregulla të personalizuara të dukshmërisë së fushës (formati JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Parazgjedhjet e Përkthimit"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Konfiguro krijimin e parazgjedhjeve të përkthimit (mbajtësit e gjuhës) për entitetet e përkthyeshme."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Krijo automatikisht parazgjedhjet e përkthimit"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Kur aktivizohet, parazgjedhjet e përkthimit (mbajtësit e vendit) krijohen për gjuhë të tjera gjatë krijimit/përditësimit të entitetit. Përkthimet ekzistuese me burim të duhur nuk mbishkruhen."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Përdor të gjitha gjuhët e disponueshme"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Kur aktivizohet, përkthimet do të krijohen për të gjitha gjuhët e instaluara në faqe. Kur çaktivizohet, do të përdoren vetëm gjuhët e synuara të zgjedhura më poshtë."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Gjuhët e synuara për parazgjedhjet e përkthimit"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Zgjidhni për cilat gjuhë të krijohen parazgjedhjet e përkthimit. Përdoret vetëm kur \"Përdor të gjitha gjuhët e disponueshme\" është çaktivizuar."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopjo vlerat e fushës burimore"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Kur aktivizohet, vlerat e fushave të përkthyeshme nga gjuha burimore do të kopjohen në përkthimet e reja."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Llojet e entiteteve"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Zgjidhni për cilat lloje entitetesh duhet të krijohen parazgjedhjet e përkthimit."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operacionet në Grup"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Përpuno entitetet ekzistuese për të krijuar parazgjedhjet e përkthimit që mungojnë."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Lloji i entitetit për t'u përpunuar"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Zgjidh -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Zgjidhni një lloj entiteti për të krijuar përkthime për entitetet ekzistuese."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Krijo parazgjedhjet e përkthimit për entitetet ekzistuese"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Ju lutemi zgjidhni një lloj entiteti për t'u përpunuar."

