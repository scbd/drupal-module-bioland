msgstr "Mbetet në krye pavarësisht datës së publikimit"

#: js/bioland-help-comments-1-0-36.js
msgid "Multiple sticky items appear before non-sticky content"
msgstr "Shumë artikuj ngjitës shfaqen përpara përmbajtjes jo"

#: js/bioland-help-comments-1-0-36.js
msgid "Using both:"
msgstr "Duke përdorur të dyja:"

#: js/bioland-help-comments-1-0-36.js
msgid "Content can be both promoted AND sticky for maximum visibility."
msgstr "Përmbajtja mund të promovohet DHE ngjitëse për shikueshmëri maksimale."

#: js/bioland-help-comments-1-0-36.js
msgid "Content sorting priority (highest to lowest):"
msgstr "Prioriteti i klasifikimit të përmbajtjes (më i lartë në më të ulët"

#: js/bioland-help-comments-1-0-36.js
msgid "Sticky"
msgstr "Ngjitës"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Sticky at top of lists\" always appear first"
msgstr "Artikujt e shënuar “Ngjitës në krye të listave” shfaqen gjithmonë të parët"

#: js/bioland-help-comments-1-0-36.js
msgid "Lower numbers appear before higher numbers (e.g., 10 appears before 20)"
msgstr "Numrat më të ulët shfaqen para numrave më të lartë (p.sh., 10 shfaqet para 20)"

#: js/bioland-help-comments-1-0-36.js
msgid "Promoted"
msgstr "Promovimi"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Promoted to front page\" come next"
msgstr "Artikujt e shënuar “Promovimi në faqen e parë” vijnë në radhë"

#: js/bioland-help-comments-1-0-36.js
msgid "Start Date"
msgstr "Data e fillimit"

#: js/bioland-help-comments-1-0-36.js
msgid "Then sorted by start date (or published date if no start date)"
msgstr "Pastaj renditur sipas datës së fillimit (ose data e publikuar nëse nuk ka datë fillimi)"

#: js/bioland-help-comments-1-0-36.js
msgid "Last Modified"
msgstr "Modifikuar për herë të fundit"

#: js/bioland-help-comments-1-0-36.js
msgid "Finally sorted by most recently updated"
msgstr "Më në fund renditur sipas përditësuara së fundmi"

#: js/bioland-help-comments-1-0-36.js
msgid "Tip:"
msgstr "Këshillë:"

#: js/bioland-help-comments-1-0-36.js
msgid "Leave empty to use default sorting. Use increments of 10 (e.g., 10, 20, 30) to leave room for inserting items later."
msgstr "Lëreni bosh për të përdorur klasifikimin e parazgjedhur. Përdorni rritje prej 10 (p.sh., 10, 20, 30) për të lënë hapësirë për futjen e artikujve më vonë."

