#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Futni një kod vendi për rresht."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Rajoni"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Zgjidhni rajonin gjeografik."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Amerika e Veriut"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Amerika e Jugut"

