#: js/bioland-help-comments-1-0-21.js
msgid "Help"
msgstr "Ndihmë"

#: js/bioland-help-comments-1-0-21.js
msgid "This will be the main content of your new site content.  The summary can be used to display a brief concise description of your content.  Further, the summary  will be displayed in list and card views of your record on the website.  Alternatively, the first few sentence from the main content will be used."
msgstr "Kjo do të jetë përmbajtja kryesore e përmbajtjes së faqes suaj të re. Përmbledhja mund të përdoret për të shfaqur një përshkrim të shkurtër dhe konciz të përmbajtjes suaj. Më tej, përmbledhja do të shfaqet në pamjet e listës dhe kartave të regjistrimit tuaj në faqen e internetit. Përndryshe, do të përdoren fjalitë e para nga përmbajtja kryesore."

#: js/bioland-help-comments-1-0-21.js
msgid "Images"
msgstr "Imazhe"

#: js/bioland-help-comments-1-0-21.js
msgid "The <b>first image</b> in order of left to right here, <b>will be the main image</b> of your record displayed on the page and in thumbnails in list and card views.  All another images will be displayed below the main content."
msgstr "<b>Imazhi i parë</b> sipas rendit nga e majta në të djathtë këtu, <b>do të jetë imazhi kryesor</b> i regjistrimit tuaj i shfaqur në faqe dhe në miniaturat në pamjet e listës dhe kartave. Të gjitha imazhet e tjera do të shfaqen poshtë përmbajtjes kryesore."

#: js/bioland-help-comments-1-0-21.js
msgid "Heroes"
msgstr "Heronjtë"

#: js/bioland-help-comments-1-0-21.js
msgid "Any page/content type can have multiple <b>hero banners</b>.  If there is more then one they will be rotated on an hourly basis."
msgstr "Çdo faqe/lloj përmbajtjeje mund të ketë disa <b>banerë heronjsh</b>. Nëse ka më shumë se një, ato do të rrotullohen çdo orë."

