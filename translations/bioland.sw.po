msgstr "Mipangilio ya Jumla"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Nchi"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Weka nambari ya nchi moja kwa kila mstari."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Mkoa"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Chagua eneo la kijiografia."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Amerika ya Kaskazini"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Amerika ya Kusini"

