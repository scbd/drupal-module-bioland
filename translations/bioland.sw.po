#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Je, ni Ardhi ya Usalama wa Mazingira?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Inaonyesha ikiwa hii ni mfano wa Ardhi ya Usalama wa Mazingira."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Wezesha Udhibiti wa Mwonekano wa Sehemu"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Onyesha/ficha sehemu kulingana na uteuzi wa aina ya maudhui. Inadhibiti URL, tarehe, na mwonekano wa sehemu zilizochapishwa."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Wezesha Sehemu za Ziada"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Ongeza sehemu za ziada maalum za aina ya maudhui (hali za matukio, hali za miradi, n.k.) kulingana na aina ya maudhui ya thesaurus."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Wezesha Muhtasari wa Kiotomatiki"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Tengeneza muhtasari kiotomatiki kutoka kwa maudhui ya msingi mtumiaji anapoandika."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Wezesha Maoni ya Usaidizi wa Sehemu"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Onyesha maoni ya usaidizi wa kimazingira kwa sehemu kulingana na aina ya maudhui."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Kanuni za Mwonekano wa Sehemu"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Bainisha kanuni maalum za mwonekano wa sehemu (muundo wa JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Chaguo-msingi za Tafsiri"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Unda chaguo-msingi za tafsiri kiotomatiki"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Inapowezeshwa, chaguo-msingi za tafsiri (vishikilia nafasi) huundwa kwa lugha zingine wakati wa kuunda/kusasisha huluki. Tafsiri zilizopo zenye chanzo sahihi haziandikwi juu."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Tumia lugha zote zilizopo"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Inapowezeshwa, tafsiri zitatengenezwa kwa lugha zote zilizosakinishwa kwenye tovuti. Inapozimwa, ni lugha lengwa zilizochaguliwa hapa chini pekee ndizo zitatumika."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Lugha lengwa za chaguo-msingi za tafsiri"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Chagua lugha za kuundia chaguo-msingi za tafsiri. Hutumika tu wakati \"Tumia lugha zote zilizopo\" imezimwa."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Nakili thamani za sehemu za chanzo"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Inapowezeshwa, thamani za sehemu zinazoweza kutafsiriwa kutoka lugha ya chanzo zitanakiliwa kwenye tafsiri mpya."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Aina za huluki"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Chagua aina za huluki ambazo zinapaswa kuundwa chaguo-msingi za tafsiri."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operesheni za Kundi"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Chakata huluki zilizopo ili kuunda chaguo-msingi za tafsiri zinazokosekana."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Aina ya huluki ya kuchakata"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Chagua -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Chagua aina ya huluki ili kuunda tafsiri za huluki zilizopo."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Unda chaguo-msingi za tafsiri za huluki zilizopo"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Tafadhali chagua aina ya huluki ya kuchakata."

