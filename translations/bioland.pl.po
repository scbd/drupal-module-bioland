msgid "Asia"
msgstr "Azja"

#: src/Form/BiolandSettingsForm.php
msgid "Africa"
msgstr "Afryka"

#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "Oceania"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Czy to jest ziemia bezpieczeństwa biologicznego?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Wskazuje, czy jest to instancja ziemi bezpieczeństwa biologicznego."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Ustawienia zachowania pól"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Włącz kontrolę widoczności pól"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Pokaż/ukryj pola na podstawie wyboru typu zawartości. Kontroluje widoczność pól URL, daty i opublikowanych."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Włącz dodatkowe pola"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Dodaj dodatkowe pola specyficzne dla typu zawartości (statusy wydarzeń, statusy projektów itp.) na podstawie typu zawartości tezaurusa."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Włącz automatyczne podsumowanie"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Automatycznie generuj podsumowanie z treści podczas pisania przez użytkownika."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Włącz komentarze pomocy do pól"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Wyświetlaj kontekstowe komentarze pomocy dla pól na podstawie typu zawartości."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Reguły widoczności pól"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Zdefiniuj niestandardowe reguły widoczności pól (format JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Domyślne ustawienia tłumaczenia"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Skonfiguruj tworzenie domyślnych tłumaczeń (symboli zastępczych języka) dla jednostek podlegających tłumaczeniu."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Automatycznie twórz domyślne tłumaczenia"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Gdy włączone, domyślne tłumaczenia (symbole zastępcze) są tworzone dla innych języków podczas tworzenia/aktualizacji jednostki. Istniejące tłumaczenia z prawidłowym źródłem nie są nadpisywane."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Użyj wszystkich dostępnych języków"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Gdy włączone, tłumaczenia będą tworzone dla wszystkich języków zainstalowanych na stronie. Gdy wyłączone, używane będą tylko wybrane poniżej języki docelowe."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Języki docelowe dla domyślnych tłumaczeń"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Wybierz, dla których języków tworzyć domyślne tłumaczenia. Używane tylko wtedy, gdy opcja \"Użyj wszystkich dostępnych języków\" jest wyłączona."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopiuj wartości pól źródłowych"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Gdy włączone, wartości pól podlegających tłumaczeniu z języka źródłowego będą kopiowane do nowych tłumaczeń."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Typy jednostek"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Wybierz, dla których typów jednostek powinny być tworzone domyślne tłumaczenia."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operacje wsadowe"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Przetwarzaj istniejące jednostki, aby utworzyć brakujące domyślne tłumaczenia."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Typ jednostki do przetworzenia"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Wybierz -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Wybierz typ jednostki, aby utworzyć tłumaczenia dla istniejących jednostek."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Utwórz domyślne tłumaczenia dla istniejących jednostek"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Proszę wybrać typ jednostki do przetworzenia."

