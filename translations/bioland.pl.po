#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Kraje"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Wprowadź jeden kod kraju w wierszu."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Region"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Wybierz region geograficzny."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Ameryka Północna"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Ameryka Południowa"

