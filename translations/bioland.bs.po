msgstr "Prikaži polja raspona datuma (datum početka i završetka) za ove vrste sadržaja:"

#: src/Form/BiolandSettingsForm.php
msgid "Additional Tags Control"
msgstr "Kontrola dodatnih polja"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Dodajte dodatna polja specifična za vrstu sadržaja (statuse događaja, statuse projekta itd.) na osnovu vrste sadržaja tezaurusa."

#: src/Form/BiolandSettingsForm.php
msgid "Additional Tags Mapping"
msgstr "Mapiranje dodatnih polja"

#: src/Form/BiolandSettingsForm.php
msgid "The following content types will have these additional tags available:"
msgstr "Sljedeće vrste sadržaja imat će na raspolaganju ova dodatna polja:"

#: src/Form/BiolandSettingsForm.php
msgid "Event Statuses"
msgstr "Statusi događaja"

#: src/Form/BiolandSettingsForm.php
msgid "Project Statuses, Geographic Scopes"
msgstr "Statusi projekta, geografski opsezi"

#: src/Form/BiolandSettingsForm.php
msgid "Ministry (8)"
msgstr "Ministarstvo (8)"

#: src/Form/BiolandSettingsForm.php
msgid "Organization Types, Government Types"
msgstr "Vrste organizacija, Tipovi vlade"

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem (9)"
msgstr "Ekosistem (9)"

#: src/Form/BiolandSettingsForm.php
msgid "Ecosystem Types"
msgstr "Vrste ekosistema"

#: src/Form/BiolandSettingsForm.php
msgid "Document Types"
msgstr "Vrste dokumenata"

#: src/Form/BiolandSettingsForm.php
msgid "These tags are dynamically added based on the selected content type and are powered by a Vue.js component."
msgstr "Ova polja se dinamički dodaju na osnovu odabranog tipa sadržaja i pokreću ih komponenta Vue.js."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Automatski generirajte sažetak iz sadržaja tijela kao tipova korisnika."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Omogući komentare pomoći u polju"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Prikažite komentare kontekstualne pomoći za polja na temelju vrste sadržaja."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Omogući ograničenje dubine izbornika"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Ograničite korisnike koji nisu administratori da stvaraju stavke izbornika drugog nivoa i dublje. Samo korisnici s dozvolom “administriraj izbornik” mogu kreirati ugniježđene stavke menija."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Zadane vrijednosti prijevoda"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Konfigurirajte kreiranje zadanih postavki prijevoda (jezičnih rezerviranih mjesta) za prevodljive entitete."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Automatski kreiranje zadanih postavki prijevoda"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Kada je omogućeno, zadane vrijednosti prijevoda (rezervirani držači mjesta) kreiraju se za druge jezike pri kreiranju/ažuriranju entiteta. Postojeći prijevodi s odgovarajućim izvorom nisu prepisani."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Koristite sve dostupne jezike"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Kada je omogućeno, kreirat će se prijevodi za sve jezike instalirane na web mjestu. Kada je onemogućeno, koristit će se samo odabrani ciljni jezici u nastavku."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Ciljni jezici za podrazumevane vrijednosti prijevoda"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Odaberite jezike za koje ćete kreirati zadane postavke prijevoda. Koristi se samo kada je “Koristi sve dostupne jezike” onemogućeno."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopirajte vrijednosti izvornog polja"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Kada je omogućeno, vrijednosti polja koje se mogu prevesti iz izvornog jezika kopirat će se u nove prijevode."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Tipovi entiteta"

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Obavezno)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Obavezno:</strong> Odaberite koje vrste entiteta trebaju imati kreirane zadane vrijednosti prijevoda. Morate odabrati barem jednu vrstu entiteta da bi zadane postavke automatskog prevođenja radile. Zajednički izbor: <em>Sadržaj (čvor)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Morate odabrati barem jednu vrstu entiteta da bi zadane postavke automatskog prevođenja radile. Odaberite jednu ili više vrsta entiteta ili onemogućite “Automatski kreiranje zadanih postavki prijevoda”."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Serijske operacije"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Obradite postojeće entitete kako biste stvorili nedostajuće podrazumevane vrijednosti prijevoda."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Vrsta entiteta za obradu"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Odaberite -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Odaberite vrstu entiteta za kreiranje prijevoda za postojeće entitete."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Stvorite podrazumevane vrijednosti prijevoda za postojeće entitete"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Molimo odaberite vrstu entiteta za obradu."

