msgid "Event Statuses"
msgstr "Statusi događaja"

#: src/Form/BiolandSettingsForm.php
msgid "Project Statuses, Geographic Scopes"
msgstr "Statusi projekta, geografski opsezi"

#: src/Form/BiolandSettingsForm.php
msgid "Ministry (8)"
msgstr "Ministarstvo (8)"

#: src/Form/BiolandSettingsForm.php
msgid "Organization Types, Government Types"
msgstr "Vrste organizacija, Tipovi vlade"

