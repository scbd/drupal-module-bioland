msgstr "Prioritet sortiranja sadržaja (od najviših do najnižih):"

#: js/bioland-help-comments-1-0-36.js
msgid "Sticky"
msgstr "Ljepljiv"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Sticky at top of lists\" always appear first"
msgstr "Stavke označene sa “Ljepljivo na vrhu popisa” uvijek se pojavljuju prvi"

#: js/bioland-help-comments-1-0-36.js
msgid "Lower numbers appear before higher numbers (e.g., 10 appears before 20)"
msgstr "Niži brojevi pojavljuju se prije viših brojeva (npr. 10 se pojavljuje prije 20)"

#: js/bioland-help-comments-1-0-36.js
msgid "Promoted"
msgstr "Promoviran"

#: js/bioland-help-comments-1-0-36.js
msgid "Items marked \"Promoted to front page\" come next"
msgstr "Predmeti s oznakom “Promovirani na naslovnu stranicu” dolaze sljedeće"

#: js/bioland-help-comments-1-0-36.js
msgid "Start Date"
msgstr "Datum početka"

#: js/bioland-help-comments-1-0-36.js
msgid "Then sorted by start date (or published date if no start date)"
msgstr "Zatim sortirano prema datumu početka (ili datumu objavljivanja ako nema datuma početka)"

#: js/bioland-help-comments-1-0-36.js
msgid "Last Modified"
msgstr "Posljednja izmjena"

#: js/bioland-help-comments-1-0-36.js
msgid "Finally sorted by most recently updated"
msgstr "Konačno sortirano prema najnovijem ažuriranju"

#: js/bioland-help-comments-1-0-36.js
msgid "Tip:"
msgstr "Savjet:"

#: js/bioland-help-comments-1-0-36.js
msgid "Leave empty to use default sorting. Use increments of 10 (e.g., 10, 20, 30) to leave room for inserting items later."
msgstr "Ostavite prazno da biste koristili zadano sortiranje. Koristite korake od 10 (npr. 10, 20, 30) da biste kasnije ostavili prostor za umetanje predmeta."

