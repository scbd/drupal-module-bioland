msgstr "Oceanija"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Je zemljišče za biološko varnost?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Označuje, ali je to primerek zemljišča za biološko varnost."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Nastavitve obnašanja polj"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Omogoči nadzor vidnosti polj"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Pokaži/skrij polja glede na izbiro vrste vsebine. Nadzoruje vidnost URL-ja, datuma in objavljenih polj."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Omogoči dodatna polja"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Dodaj dodatna polja, specifična za vrsto vsebine (stanja dogodkov, stanja projektov itd.), glede na vrsto vsebine tezavra."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Omogoči samodejni povzetek"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Samodejno ustvari povzetek iz vsebine telesa med tipkanjem uporabnika."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Omogoči komentarje za pomoč pri poljih"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Prikaži kontekstualne komentarje za pomoč pri poljih glede na vrsto vsebine."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Pravila vidnosti polj"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Določite pravila vidnosti polj po meri (format JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Privzete vrednosti prevoda"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Konfigurirajte ustvarjanje privzetih vrednosti prevoda (jezikovnih ograd) za prevodljive entitete."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Samodejno ustvari privzete vrednosti prevoda"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Ko je omogočeno, se privzete vrednosti prevoda (ograde) ustvarijo za druge jezike ob ustvarjanju/posodabljanju entitete. Obstoječi prevodi s pravilnim virom se ne prepišejo."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Uporabi vse razpoložljive jezike"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Ko je omogočeno, bodo prevodi ustvarjeni za vse jezike, nameščene na spletnem mestu. Ko je onemogočeno, se bodo uporabljali samo spodaj izbrani ciljni jeziki."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Ciljni jeziki za privzete vrednosti prevoda"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Izberite, za katere jezike želite ustvariti privzete vrednosti prevoda. Uporablja se samo, če je možnost »Uporabi vse razpoložljive jezike« onemogočena."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopiraj vrednosti izvornih polj"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Ko je omogočeno, se bodo vrednosti prevodljivih polj iz izvornega jezika kopirale v nove prevode."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Vrste entitet"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Izberite, za katere vrste entitet naj se ustvarijo privzete vrednosti prevoda."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Paketne operacije"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Obdelajte obstoječe entitete, da ustvarite manjkajoče privzete vrednosti prevoda."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Vrsta entitete za obdelavo"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Izberi -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Izberite vrsto entitete za ustvarjanje prevodov za obstoječe entitete."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Ustvari privzete vrednosti prevoda za obstoječe entitete"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Izberite vrsto entitete za obdelavo."

