msgstr "Države"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Vnesite eno kodo države na vrstico."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Regija"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Izberite geografsko regijo."

