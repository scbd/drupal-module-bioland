msgid "Define custom field visibility rules in JSON format. Leave empty to use the settings above."
msgstr "Določite pravila vidnosti polja po meri v obliki JSON. Pustite prazno, da uporabite zgornje nastavitve."

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Obvezno)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Obvezno:</strong> Izberite, v katerih vrstah entitet naj bodo ustvarjene privzete nastavitve prevajanja. Izbrati morate vsaj eno vrsto entitete, da bodo privzete nastavitve samodejnega prevajanja delovale. Skupna izbira: V <em>sebina (vozlišče)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Izbrati morate vsaj eno vrsto entitete, da bodo privzete nastavitve samodejnega prevajanja delovale. Izberite eno ali več vrst entitet ali onemogočite« Samodejno ustvari privzete nastavitve prevajanja«."

