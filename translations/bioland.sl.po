msgstr "Uporabnikom, ki niso skrbniki, omejite ustvarjanje elementov menija druge stopnje in globlje. Ugnezdene elemente menija lahko ustvarijo samo uporabniki z dovoljenjem za upravljanje menija."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules (Advanced)"
