#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "Общие настройки"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Страны"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Введите по одному коду страны на строку."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Регион"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Выберите географический регион."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Северная Америка"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Южная Америка"

#: src/Form/BiolandSettingsForm.php
msgid "Europe"
msgstr "Европа"

#: src/Form/BiolandSettingsForm.php
msgid "Asia"
msgstr "Азия"

#: src/Form/BiolandSettingsForm.php
msgid "Africa"
msgstr "Африка"

#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "Океания"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Это земля биоразнообразия?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Указывает, является ли это экземпляром Biosafety Land."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Настройки поведения полей"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Включить управление видимостью полей"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Показывать/скрывать поля в зависимости от выбора типа контента. Управляет видимостью полей URL, даты и публикации."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Включить дополнительные поля"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Добавить специфичные для типа контента дополнительные поля (статусы событий, статусы проектов и т.д.) на основе типа контента тезауруса."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Включить автоматическое резюме"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Автоматически генерировать резюме из основного содержимого по мере ввода пользователем."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Включить комментарии-подсказки для полей"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Отображать контекстные комментарии-подсказки для полей в зависимости от типа контента."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Правила видимости полей"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Определите пользовательские правила видимости полей (формат JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Значения по умолчанию для перевода"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Настройте создание значений по умолчанию для перевода (заполнителей языка) для переводимых сущностей."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Автоматически создавать значения по умолчанию для перевода"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Если включено, значения по умолчанию для перевода (заполнители) создаются для других языков при создании/обновлении сущности. Существующие переводы с правильным источником не перезаписываются."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Использовать все доступные языки"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Если включено, переводы будут создаваться для всех языков, установленных на сайте. Если отключено, будут использоваться только выбранные ниже целевые языки."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Целевые языки для значений по умолчанию перевода"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Выберите, для каких языков создавать значения по умолчанию для перевода. Используется только тогда, когда опция \"Использовать все доступные языки\" отключена."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Копировать значения исходных полей"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Если включено, значения переводимых полей из исходного языка будут скопированы в новые переводы."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Типы сущностей"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Выберите, для каких типов сущностей должны создаваться значения по умолчанию для перевода."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Пакетные операции"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Обработать существующие сущности для создания отсутствующих значений по умолчанию для перевода."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Тип сущности для обработки"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Выбрать -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Выберите тип сущности для создания переводов для существующих сущностей."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Создать значения по умолчанию для перевода для существующих сущностей"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Пожалуйста, выберите тип сущности для обработки."

