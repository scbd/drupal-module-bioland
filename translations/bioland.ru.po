msgid "URL Field"
msgstr "Поле URL-адреса"

#: src/Form/BiolandSettingsForm.php
msgid "Show URL field for these content types:"
msgstr "Показать поле URL для следующих типов контента:"

#: src/Form/BiolandSettingsForm.php
msgid "Published Field"
msgstr "Опубликованное поле"

#: src/Form/BiolandSettingsForm.php
msgid "Show Published field for these content types:"
msgstr "Показать поле «Опубликовано» для следующих типов контента:"

#: src/Form/BiolandSettingsForm.php
msgid "Date Range Field (Start & End Date)"
msgstr "Поле диапазона дат (дата начала и окончания)"

#: src/Form/BiolandSettingsForm.php
msgid "Show Date Range fields (Start & End Date) for these content types:"
msgstr "Показать поля диапазона дат (дата начала и окончания) для следующих типов контента:"

