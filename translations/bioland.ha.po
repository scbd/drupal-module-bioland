#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Kunna Ƙuntatawa Zurfin Menu"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Ƙuntata masu amfani da marasa gudanarwa daga ƙirƙirar abubuwa na menu na matakin biyu da zurfi. Masu amfani ne kawai tare da izinin “gudanar da menu” zasu iya ƙirƙirar abubuwan menu da aka tsara."

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Ana buƙata)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Ana buƙata: Za</strong> ɓi waɗanne nau&#39;ikan ƙungiya yakamata su ƙirƙira tsoffin fassarar. Dole ne ku zaɓi aƙalla nau&#39;in ƙungiya ɗaya don tsoffin fassarar atomatik don aiki. Zaɓin gama gari: <em>Abun ciki (node)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Dole ne ku zaɓi aƙalla nau'in ƙungiya ɗaya don tsoffin fassarar atomatik don aiki. Da fatan za a zaɓi nau'ikan ƙungiya ɗaya ko fiye, ko kashe “Ƙirƙirar tsoffin fassara ta atomatik”."

