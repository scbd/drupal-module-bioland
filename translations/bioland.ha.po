msgstr "Kasashe"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Shigar da lambar ƙasa ɗaya a kowace layi."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Yanki"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Zaɓi yankin ƙasa."

