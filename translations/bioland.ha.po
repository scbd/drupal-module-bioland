#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Shin Kasa ce ta Tsaron Halittu?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Yana nuna ko wannan misali ne na Kasa ta Tsaron Halittu."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Saitunan Halayen Filaye"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Kunna Kula da Ganin Filaye"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Nuna/ɓoye filaye dangane da zaɓin nau'in abun ciki. Yana sarrafa ganin URL, kwanan wata, da filayen da aka buga."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Kunna Ƙarin Filaye"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Ƙara ƙarin filaye na musamman na nau'in abun ciki (matsayin taron, matsayin aikin, da sauransu) dangane da nau'in abun ciki na thesaurus."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Kunna Takaitawa ta atomatik"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Samar da takaitawa ta atomatik daga babban abun ciki yayin da mai amfani ke bugawa."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Kunna Sharhin Taimakon Filaye"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Nuna sharhin taimako na mahallin don filaye dangane da nau'in abun ciki."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Dokokin Ganin Filaye"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Bayyana dokokin ganin filaye na al'ada (tsarin JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Tsoffin Fassarori"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Sanya yadda za a ƙirƙiri tsoffin fassarori (masu riƙe wuri na harshe) don abubuwan da za a iya fassarawa."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Ƙirƙiri tsoffin fassarori ta atomatik"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Idan an kunna, ana ƙirƙirar tsoffin fassarori (masu riƙe wuri) don wasu harsuna a lokacin ƙirƙirar/sabunta abu. Ba a sake rubuta fassarorin da ke akwai tare da tushe mai kyau."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Yi amfani da duk harsunan da ke akwai"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Idan an kunna, za a ƙirƙiri fassarori don duk harsunan da aka sanya a shafin. Idan an kashe, za a yi amfani da harsunan da aka zaɓa a ƙasa kawai."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Harsunan da aka nufa don tsoffin fassarori"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Zaɓi waɗanne harsuna za a ƙirƙira tsoffin fassarori don su. Ana amfani da shi ne kawai lokacin da aka kashe \"Yi amfani da duk harsunan da ke akwai\"."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kwafi dabi'un filin tushe"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Idan an kunna, za a kwafi dabi'un filayen da za a iya fassarawa daga harshen tushe zuwa sababbin fassarori."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Nau'ukan Abubuwa"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Zaɓi waɗanne nau'ukan abubuwa ya kamata a ƙirƙira musu tsoffin fassarori."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Ayyukan Rukuni"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Gudanar da abubuwan da ke akwai don ƙirƙirar tsoffin fassarorin da suka ɓace."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Nau'in abu don sarrafawa"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Zaɓi -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Zaɓi nau'in abu don ƙirƙirar fassarori don abubuwan da ke akwai."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Ƙirƙiri tsoffin fassarori don abubuwan da ke akwai"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Da fatan za a zaɓi nau'in abu don sarrafawa."

