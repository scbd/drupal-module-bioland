#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "Општи поставки"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Земји"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Внесете по еден код на земја по ред."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Регион"

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Северна Америка"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
msgstr "Јужна Америка"

#: src/Form/BiolandSettingsForm.php
msgid "Europe"
msgstr "Европа"

