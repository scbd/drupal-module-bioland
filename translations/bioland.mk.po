msgstr "Последна модификација"

#: js/bioland-help-comments-1-0-36.js
msgid "Finally sorted by most recently updated"
msgstr "Конечно подредено по неодамна ажурирано"

#: js/bioland-help-comments-1-0-36.js
msgid "Tip:"
msgstr "Совет:"

#: js/bioland-help-comments-1-0-36.js
