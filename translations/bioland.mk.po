msgid "Asia"
msgstr "Азија"

#: src/Form/BiolandSettingsForm.php
msgid "Africa"
msgstr "Африка"

#: src/Form/BiolandSettingsForm.php
msgid "Oceania"
msgstr "Океанија"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Дали е земја за биобезбедност?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Означува дали ова е инстанца на земја за биобезбедност."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Овозможи контрола на видливоста на полињата"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Прикажи/сокриј полиња врз основа на изборот на тип на содржина. Контролира видливост на URL, датум и објавени полиња."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Овозможи дополнителни полиња"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Додај дополнителни полиња специфични за типот на содржина (статуси на настани, статуси на проекти, итн.) врз основа на типот на содржина на тезаурусот."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Овозможи автоматско резиме"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Автоматски генерирај резиме од содржината на телото додека корисникот пишува."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Овозможи коментари за помош на полињата"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Прикажи контекстуални коментари за помош за полињата врз основа на типот на содржина."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Правила за видливост на полињата"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Дефинирајте прилагодени правила за видливост на полињата (JSON формат)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Стандардни вредности за превод"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Автоматски создавај стандардни вредности за превод"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Кога е овозможено, стандардните вредности за превод (држачи на места) се создаваат за други јазици при креирање/ажурирање на ентитет. Постоечките преводи со соодветен извор не се презапишуваат."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Користи ги сите достапни јазици"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Кога е овозможено, преводите ќе се креираат за сите јазици инсталирани на страницата. Кога е оневозможено, ќе се користат само избраните целни јазици подолу."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Целни јазици за стандардни вредности за превод"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Изберете за кои јазици да се креираат стандардни вредности за превод. Се користи само кога е оневозможено „Користи ги сите достапни јазици“."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Копирај ги вредностите на изворните полиња"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Кога е овозможено, вредностите на преводливите полиња од изворниот јазик ќе се копираат во новите преводи."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Типови на ентитети"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Изберете за кои типови на ентитети треба да се креираат стандардни вредности за превод."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Групни операции"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Обработете ги постоечките ентитети за да ги креирате недостасувачките стандардни вредности за превод."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Тип на ентитет за обработка"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Избери -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Изберете тип на ентитет за да креирате преводи за постоечките ентитети."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Создај стандардни вредности за превод за постоечките ентитети"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Ве молиме изберете тип на ентитет за обработка."

