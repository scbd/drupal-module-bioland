#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Är biosäkerhetsland?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Anger om detta är en instans av biosäkerhetsland."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Aktivera synlighetskontroll för fält"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Visa/dölj fält baserat på val av innehållstyp. Styr synligheten för URL-, datum- och publicerade fält."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Aktivera ytterligare fält"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Lägg till innehållstypsspecifika ytterligare fält (händelsestatus, projektstatus etc.) baserat på innehållstypen i tesaurusen."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Aktivera automatisk sammanfattning"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Generera automatiskt en sammanfattning från brödtexten medan användaren skriver."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Aktivera hjälkommentarer för fält"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Visa kontextuella hjälkommentarer för fält baserat på innehållstyp."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Regler för fältsynlighet"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Definiera anpassade regler för fältsynlighet (JSON-format)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Standardinställningar för översättning"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Skapa standardöversättningar automatiskt"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "När detta är aktiverat skapas standardöversättningar (platshållare) för andra språk när enheter skapas/uppdateras. Befintliga översättningar med korrekt källa skrivs inte över."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Använd alla tillgängliga språk"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "När detta är aktiverat skapas översättningar för alla språk som är installerade på webbplatsen. När det är inaktiverat används endast de valda målspråken nedan."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Målspråk för standardöversättningar"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Välj vilka språk som standardöversättningar ska skapas för. Används endast när \"Använd alla tillgängliga språk\" är inaktiverat."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopiera källfältvärden"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "När detta är aktiverat kommer översättningsbara fältvärden från källspråket att kopieras till nya översättningar."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Entitetstyper"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Välj för vilka entitetstyper standardöversättningar ska skapas."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Batch-operationer"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Bearbeta befintliga enheter för att skapa saknade standardöversättningar."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Entitetstyp att bearbeta"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Välj -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Välj en entitetstyp för att skapa översättningar för befintliga enheter."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Skapa standardöversättningar för befintliga enheter"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Välj en entitetstyp att bearbeta."

