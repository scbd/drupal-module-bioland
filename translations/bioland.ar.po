msgstr "حالة الكائنات الحية المحورة (45)"

msgid "Field Trial (46)"
msgstr "تجربة حقلية (46)"

msgid "National Mainstreaming Strategy (47)"
msgstr "استراتيجية الدمج الوطنية (47)"

msgid "Capacity-Building (48)"
msgstr "بناء القدرات (48)"

msgid "Announcement (49)"
msgstr "إعلان (49)"

msgid "Contact (50)"
msgstr "جهة اتصال (50)"

msgid "Order Override"
msgstr "تجاوز الترتيب"

msgid "Save"
msgstr "حفظ"

msgid "You do not have permission to create menu items under other menu items. Only top-level menu items are allowed for your role."
msgstr "ليست لديك صلاحية إنشاء عناصر قائمة تحت عناصر قائمة أخرى. يُسمح لك فقط بعناصر القائمة ذات المستوى الأعلى."

msgid "Site name"
msgstr "اسم الموقع"

msgid "Slogan"
msgstr "الشعار"

msgid "How this is used depends on your site's theme."
msgstr "تعتمد طريقة استخدامه على سمة موقعك."

msgid "Email address"
msgstr "عنوان البريد الإلكتروني"

msgid "The <em>From</em> address in automated e-mails sent during registration and new password requests, and other notifications. (Use an address ending in your site's domain to help prevent this e-mail being flagged as spam.)"
msgstr "عنوان <em>المرسل</em> في رسائل البريد الإلكتروني الآلية المرسلة أثناء التسجيل وطلبات كلمة المرور الجديدة والإشعارات الأخرى. (استخدم عنواناً ينتهي بنطاق موقعك للمساعدة في منع وضع هذا البريد ضمن الرسائل المزعجة.)"

msgid "Translate Site Name"
msgstr "ترجمة اسم الموقع"

msgid "Translate Slogan"
msgstr "ترجمة الشعار"

msgid "Biosafety Land"
msgstr "أرض السلامة الأحيائية"

msgid "Bioland"
msgstr "بيولاند"

msgid "@branding Settings"
msgstr "إعدادات @branding"

msgid "Field Visibility Control"
msgstr "التحكم في رؤية الحقول"

msgid "Show/hide fields based on content type selection. Configure which fields are visible for each content type below."
msgstr "إظهار/إخفاء الحقول بناءً على نوع المحتوى المحدد. قم بتهيئة الحقول المرئية لكل نوع محتوى أدناه."

msgid "URL Field"
msgstr "حقل الرابط"

msgid "Show URL field for these content types:"
msgstr "إظهار حقل الرابط لأنواع المحتوى التالية:"

msgid "Published Field"
msgstr "حقل النشر"

msgid "Show Published field for these content types:"
msgstr "إظهار حقل النشر لأنواع المحتوى التالية:"

msgid "Date Range Field (Start & End Date)"
msgstr "حقل نطاق التاريخ (تاريخ البداية والنهاية)"

msgid "Show Date Range fields (Start & End Date) for these content types:"
msgstr "إظهار حقول نطاق التاريخ (تاريخ البداية والنهاية) لأنواع المحتوى التالية:"

msgid "Additional Tags Control"
msgstr "التحكم في الحقول الإضافية"

msgid "Additional Tags Mapping"
msgstr "تعيين الحقول الإضافية"

msgid "The following content types will have these additional tags available:"
msgstr "ستتوفر أنواع المحتوى التالية على هذه الحقول الإضافية:"

msgid "Event Statuses"
msgstr "حالات الحدث"

msgid "Project Statuses, Geographic Scopes"
msgstr "حالات المشروع، النطاقات الجغرافية"

msgid "Ministry (8)"
msgstr "الوزارة (8)"

msgid "Organization Types, Government Types"
msgstr "أنواع المنظمات، أنواع الحكومات"

msgid "Ecosystem (9)"
msgstr "النظام البيئي (9)"

msgid "Ecosystem Types"
msgstr "أنواع النظم البيئية"

msgid "Document Types"
msgstr "أنواع الوثائق"

msgid "These tags are dynamically added based on the selected content type and are powered by a Vue.js component."
msgstr "تُضاف هذه الحقول ديناميكياً بناءً على نوع المحتوى المحدد ويتم تشغيلها بواسطة مكون Vue.js."

msgid "Enable Menu Depth Restriction"
msgstr "تفعيل تقييد عمق القائمة"

msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "تقييد المستخدمين غير الإداريين من إنشاء عناصر قائمة من المستوى الثاني وما بعده. يمكن فقط للمستخدمين الذين لديهم صلاحية \"إدارة القائمة\" إنشاء عناصر قائمة متداخلة."

msgid "(Required)"
msgstr "(مطلوب)"

msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>مطلوب:</strong> حدد أنواع الكيانات التي يجب إنشاء إعدادات الترجمة الافتراضية لها. يجب اختيار نوع كيان واحد على الأقل ليعمل إنشاء الترجمة الآلي. الخيار الشائع: <em>المحتوى (node)</em>."

msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "يجب اختيار نوع كيان واحد على الأقل ليعمل إنشاء الترجمة الافتراضي تلقائياً. يرجى اختيار نوع كيان واحد أو أكثر، أو تعطيل خيار \"إنشاء الإعدادات الافتراضية للترجمة تلقائياً\"."

