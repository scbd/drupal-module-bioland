msgid "General Settings"
msgstr "الإعدادات العامة"

msgid "Countries"
msgstr "الدول"

msgid "Enter one country code per line."
msgstr "أدخل رمز دولة واحداً في كل سطر."

msgid "Region"
msgstr "المنطقة"

msgid "Select the geographical region."
msgstr "اختر المنطقة الجغرافية."

msgid "North America"
msgstr "أمريكا الشمالية"

msgid "South America"
msgstr "أمريكا الجنوبية"

msgid "Europe"
msgstr "أوروبا"

msgid "Asia"
msgstr "آسيا"

msgid "Africa"
msgstr "أفريقيا"

msgid "Oceania"
msgstr "أوقيانوسيا"

msgid "Is Biosafety Land?"
msgstr "هل هي أرض السلامة الأحيائية؟"

msgid "Indicates whether this is a Biosafety Land instance."
msgstr "يشير إلى ما إذا كانت هذه نسخة من أرض السلامة الأحيائية."

msgid "Field Behavior Settings"
msgstr "إعدادات سلوك الحقول"

msgid "Enable Field Visibility Control"
msgstr "تفعيل التحكم في رؤية الحقول"

msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "إظهار/إخفاء الحقول بناءً على نوع المحتوى المحدد. يتحكم في رؤية حقول الرابط والتاريخ والنشر."

msgid "Enable Additional Tags"
msgstr "تفعيل الحقول الإضافية"

msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "إضافة حقول إضافية خاصة بنوع المحتوى (حالات الأحداث، حالات المشاريع، وغيرها) بالاستناد إلى نوع محتوى المعجم."

msgid "Enable Auto Summary"
msgstr "تفعيل الملخص التلقائي"

msgid "Automatically generate summary from body content as user types."
msgstr "إنشاء ملخص تلقائياً من نص المحتوى أثناء كتابة المستخدم."

msgid "Enable Field Help Comments"
msgstr "تفعيل تعليقات المساعدة للحقول"

msgid "Display contextual help comments for fields based on content type."
msgstr "عرض تعليقات مساعدة سياقية للحقول بناءً على نوع المحتوى."

msgid "Field Visibility Rules"
msgstr "قواعد رؤية الحقول"

msgid "Define custom field visibility rules (JSON format)."
msgstr "تعريف قواعد مخصصة لرؤية الحقول (بتنسيق JSON)."

msgid "Translation Defaults"
msgstr "الإعدادات الافتراضية للترجمة"

msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "تهيئة إنشاء الإعدادات الافتراضية للترجمة (عناصر اللغة النائبة) للكيانات القابلة للترجمة."

msgid "Automatically create translation defaults"
msgstr "إنشاء الإعدادات الافتراضية للترجمة تلقائياً"

msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "عند التفعيل، تُنشأ الإعدادات الافتراضية للترجمة (العناصر النائبة) للغات الأخرى عند إنشاء الكيان أو تحديثه. لا تُستبدل الترجمات الموجودة التي تمتلك مصدراً صحيحاً."

msgid "Use all available languages"
msgstr "استخدام جميع اللغات المتاحة"

msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "عند التفعيل، تُنشأ الترجمات لجميع اللغات المثبتة على الموقع. عند التعطيل، ستُستخدم فقط اللغات المستهدفة المحددة أدناه."

msgid "Target languages for translation defaults"
msgstr "اللغات المستهدفة للإعدادات الافتراضية للترجمة"

msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "حدد اللغات التي سيتم إنشاء إعدادات الترجمة الافتراضية لها. يُستخدم فقط عند تعطيل خيار \"استخدام جميع اللغات المتاحة\"."

msgid "Copy source field values"
msgstr "نسخ قيم الحقول المصدرية"

msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "عند التفعيل، ستُنسخ قيم الحقول القابلة للترجمة من اللغة المصدر إلى الترجمات الجديدة."

msgid "Entity types"
msgstr "أنواع الكيانات"

msgid "Select which entity types should have translation defaults created."
msgstr "حدد أنواع الكيانات التي يجب إنشاء إعدادات الترجمة الافتراضية لها."

msgid "Batch Operations"
msgstr "العمليات الدفعية"

msgid "Process existing entities to create missing translation defaults."
msgstr "معالجة الكيانات الموجودة لإنشاء إعدادات الترجمة الافتراضية الناقصة."

msgid "Entity type to process"
msgstr "نوع الكيان المطلوب معالجته"

msgid "- Select -"
msgstr "- اختر -"

msgid "Select an entity type to create translations for existing entities."
msgstr "اختر نوع كيان لإنشاء ترجمات للكيانات الحالية."

msgid "Create translation defaults for existing entities"
msgstr "إنشاء إعدادات ترجمة افتراضية للكيانات الحالية"

msgid "Please select an entity type to process."
msgstr "يرجى اختيار نوع كيان لمعالجته."

