msgstr "Okeaniya"

#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Bioxavfsizlik Yeri-mi?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Bu Bioxavfsizlik Yeri nusxasi ekanligini bildiradi."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Maydon Xulq-atvori Sozlamalari"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Maydon Ko'rinishini Boshqarishni Yoqish"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Kontent turi tanloviga qarab maydonlarni ko'rsatish/yashirish. URL, sana va nashr etilgan maydonlar ko'rinishini boshqaradi."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Qo'shimcha Maydonlarni Yoqish"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Tezaurus kontent turiga asoslangan holda kontent turiga xos qo'shimcha maydonlarni (hodisa holatlari, loyiha holatlari va hokazo) qo'shing."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Avtomatik Xulosani Yoqish"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Foydalanuvchi yozayotganda asosiy kontentdan avtomatik ravishda xulosa yaratish."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Maydon Yordam Izohlarini Yoqish"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Kontent turiga qarab maydonlar uchun kontekstli yordam izohlarini ko'rsatish."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Maydon Ko'rinishi Qoidalari"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Maxsus maydon ko'rinishi qoidalarini belgilang (JSON formati)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Tarjima Standartlari"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Tarjima qilinadigan ob'ektlar uchun tarjima standartlarini (til o'rnini bosuvchilar) yaratishni sozlang."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Tarjima standartlarini avtomatik yaratish"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Yoqilganda, ob'ekt yaratish/yangilashda boshqa tillar uchun tarjima standartlari (o'rinbosarlar) yaratiladi. To'g'ri manbaga ega mavjud tarjimalar ustiga yozilmaydi."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Barcha mavjud tillardan foydalanish"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Yoqilganda, saytda o'rnatilgan barcha tillar uchun tarjimalar yaratiladi. O'chirilganda, faqat quyida tanlangan maqsadli tillar ishlatiladi."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Tarjima standartlari uchun maqsadli tillar"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Qaysi tillar uchun tarjima standartlarini yaratishni tanlang. Faqat \"Barcha mavjud tillardan foydalanish\" o'chirilganida ishlatiladi."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Manba maydon qiymatlarini nusxalash"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Yoqilganda, manba tilidagi tarjima qilinadigan maydon qiymatlari yangi tarjimalarga nusxalanadi."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Ob'ekt turlari"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Qaysi ob'ekt turlari uchun tarjima standartlari yaratilishi kerakligini tanlang."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Ommaviy Operatsiyalar"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Mavjud bo'lmagan tarjima standartlarini yaratish uchun mavjud ob'ektlarni qayta ishlash."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Qayta ishlash uchun ob'ekt turi"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Tanlang -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Mavjud ob'ektlar uchun tarjimalar yaratish uchun ob'ekt turini tanlang."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Mavjud ob'ektlar uchun tarjima standartlarini yaratish"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Iltimos, qayta ishlash uchun ob'ekt turini tanlang."

