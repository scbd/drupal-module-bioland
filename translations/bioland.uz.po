msgstr "Mamlakatlar"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Har bir qatorga bitta mamlakat kodini kiriting."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Mintaqa"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Geografik mintaqani tanlang."

