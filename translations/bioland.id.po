#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Apakah Lahan Keamanan Hayati?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Menunjukkan apakah ini adalah contoh Lahan Keamanan Hayati."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Pengaturan Perilaku Bidang"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Aktifkan Kontrol Visibilitas Bidang"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Tampilkan/sembunyikan bidang berdasarkan pilihan jenis konten. Mengontrol visibilitas URL, tanggal, dan bidang yang dipublikasikan."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "Aktifkan Bidang Tambahan"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Tambahkan bidang tambahan khusus jenis konten (status acara, status proyek, dll.) berdasarkan jenis konten tesaurus."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Aktifkan Ringkasan Otomatis"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Secara otomatis menghasilkan ringkasan dari konten isi saat pengguna mengetik."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Aktifkan Komentar Bantuan Bidang"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Tampilkan komentar bantuan kontekstual untuk bidang berdasarkan jenis konten."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Aturan Visibilitas Bidang"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Tentukan aturan visibilitas bidang khusus (format JSON)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Default Terjemahan"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Konfigurasikan pembuatan default terjemahan (placeholder bahasa) untuk entitas yang dapat diterjemahkan."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Buat default terjemahan secara otomatis"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Saat diaktifkan, default terjemahan (placeholder) dibuat untuk bahasa lain saat entitas dibuat/diperbarui. Terjemahan yang ada dengan sumber yang tepat tidak akan ditimpa."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Gunakan semua bahasa yang tersedia"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Saat diaktifkan, terjemahan akan dibuat untuk semua bahasa yang diinstal di situs. Saat dinonaktifkan, hanya bahasa target yang dipilih di bawah ini yang akan digunakan."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Bahasa target untuk default terjemahan"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Pilih bahasa mana yang akan dibuatkan default terjemahannya. Hanya digunakan saat \"Gunakan semua bahasa yang tersedia\" dinonaktifkan."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Salin nilai bidang sumber"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Saat diaktifkan, nilai bidang yang dapat diterjemahkan dari bahasa sumber akan disalin ke terjemahan baru."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Jenis entitas"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Pilih jenis entitas mana yang harus dibuatkan default terjemahannya."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Operasi Batch"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Proses entitas yang ada untuk membuat default terjemahan yang hilang."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Jenis entitas untuk diproses"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Pilih -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Pilih jenis entitas untuk membuat terjemahan bagi entitas yang ada."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Buat default terjemahan untuk entitas yang ada"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Silakan pilih jenis entitas untuk diproses."

