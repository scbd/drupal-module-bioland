#: src/Form/BiolandSettingsForm.php
msgid "Enable Menu Depth Restriction"
msgstr "Aktifkan Pembatasan Kedalaman Menu"

#: src/Form/BiolandSettingsForm.php
msgid "Restrict non-administrator users from creating second-level menu items and deeper. Only users with \"administer menu\" permission can create nested menu items."
msgstr "Batasi pengguna non-administrator untuk membuat item menu tingkat kedua dan lebih dalam. Hanya pengguna dengan izin “mengelola menu” yang dapat membuat item menu bersarang."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules (Advanced)"
msgstr "Aturan Visibilitas Lapangan (Lanjutan)"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules in JSON format. Leave empty to use the settings above."
msgstr "Tentukan aturan visibilitas bidang kustom dalam format JSON. Biarkan kosong untuk menggunakan pengaturan di atas."

#: src/Form/BiolandSettingsForm.php
msgid "(Required)"
msgstr "(Diperlukan)"

#: src/Form/BiolandSettingsForm.php
msgid "<strong>Required:</strong> Select which entity types should have translation defaults created. You must select at least one entity type for automatic translation defaults to work. Common choice: <em>Content (node)</em>."
msgstr "<strong>Wajib:</strong> Pilih tipe entitas mana yang harus membuat default terjemahan. Anda harus memilih setidaknya satu jenis entitas agar default terjemahan otomatis berfungsi. Pilihan umum: <em>Konten (node)</em>."

#: src/Form/BiolandSettingsForm.php
msgid "You must select at least one entity type for automatic translation defaults to work. Please select one or more entity types, or disable \"Automatically create translation defaults\"."
msgstr "Anda harus memilih setidaknya satu jenis entitas agar default terjemahan otomatis berfungsi. Pilih satu atau beberapa jenis entitas, atau nonaktifkan “Buat default terjemahan secara otomatis”."

