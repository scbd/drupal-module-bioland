#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "მიუთითებს, არის თუ არა ეს ბიოუსაფრთხოების მიწის ინსტანცია."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "ველის ქცევის პარამეტრები"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "ველის ხილვადობის კონტროლის ჩართვა"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "ველების ჩვენება/დამალვა კონტენტის ტიპის მიხედვით. აკონტროლებს URL-ის, თარიღისა და გამოქვეყნებული ველების ხილვადობას."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Fields"
msgstr "დამატებითი ველების ჩართვა"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional fields (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "დაამატეთ კონტენტის ტიპის სპეციფიკური დამატებითი ველები (ღონისძიების სტატუსები, პროექტის სტატუსები და ა.შ.) თეზაურუსის კონტენტის ტიპის მიხედვით."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "ავტომატური შეჯამების ჩართვა"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "ავტომატურად შექმენით შეჯამება ძირითადი ტექსტიდან მომხმარებლის აკრეფისას."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "ველის დახმარების კომენტარების ჩართვა"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "აჩვენეთ კონტექსტური დახმარების კომენტარები ველებისთვის კონტენტის ტიპის მიხედვით."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "ველის ხილვადობის წესები"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "განსაზღვრეთ ველის ხილვადობის მორგებული წესები (JSON ფორმატი)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "თარგმანის ნაგულისხმევი პარამეტრები"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "თარგმნადი ერთეულებისთვის თარგმანის ნაგულისხმევი პარამეტრების (ენის ჩამნაცვლებლების) შექმნის კონფიგურაცია."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "თარგმანის ნაგულისხმევი პარამეტრების ავტომატურად შექმნა"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "ჩართვისას, თარგმანის ნაგულისხმევი პარამეტრები (ჩამნაცვლებლები) იქმნება სხვა ენებისთვის ერთეულის შექმნის/განახლებისას. არსებული თარგმანები სათანადო წყაროთი არ გადაიწერება."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "ყველა ხელმისაწვდომი ენის გამოყენება"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "ჩართვისას, თარგმანები შეიქმნება საიტზე დაინსტალირებული ყველა ენისთვის. გამორთვისას, გამოყენებული იქნება მხოლოდ ქვემოთ არჩეული სამიზნე ენები."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "სამიზნე ენები თარგმანის ნაგულისხმევი პარამეტრებისთვის"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "აირჩიეთ, რომელი ენებისთვის შეიქმნას თარგმანის ნაგულისხმევი პარამეტრები. გამოიყენება მხოლოდ მაშინ, როდესაც \"ყველა ხელმისაწვდომი ენის გამოყენება\" გამორთულია."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "წყაროს ველის მნიშვნელობების კოპირება"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "ჩართვისას, თარგმნადი ველების მნიშვნელობები წყაროს ენიდან დაკოპირდება ახალ თარგმანებში."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "ერთეულის ტიპები"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "აირჩიეთ, რომელი ერთეულის ტიპებისთვის უნდა შეიქმნას თარგმანის ნაგულისხმევი პარამეტრები."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "ჯგუფური ოპერაციები"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "დაამუშავეთ არსებული ერთეულები გამოტოვებული თარგმანის ნაგულისხმევი პარამეტრების შესაქმნელად."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "დასამუშავებელი ერთეულის ტიპი"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- აირჩიეთ -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "აირჩიეთ ერთეულის ტიპი არსებული ერთეულებისთვის თარგმანების შესაქმნელად."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "თარგმანის ნაგულისხმევი პარამეტრების შექმნა არსებული ერთეულებისთვის"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "გთხოვთ, აირჩიოთ დასამუშავებელი ერთეულის ტიპი."

