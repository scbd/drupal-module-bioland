#: src/Form/BiolandSettingsForm.php
msgid "Is Biosafety Land?"
msgstr "Ar tai biologinės saugos žemė?"

#: src/Form/BiolandSettingsForm.php
msgid "Indicates whether this is a Biosafety Land instance."
msgstr "Nurodo, ar tai yra biologinės saugos žemės egzempliorius."

#: src/Form/BiolandSettingsForm.php
msgid "Field Behavior Settings"
msgstr "Laukų elgsenos nustatymai"

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Visibility Control"
msgstr "Įjungti laukų matomumo valdymą"

#: src/Form/BiolandSettingsForm.php
msgid "Show/hide fields based on content type selection. Controls URL, date, and published fields visibility."
msgstr "Rodyti/slėpti laukus pagal turinio tipo pasirinkimą. Valdo URL, datos ir paskelbtų laukų matomumą."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Additional Tags"
msgstr "Įjungti papildomus laukus"

#: src/Form/BiolandSettingsForm.php
msgid "Add content-type specific additional tags (event statuses, project statuses, etc.) based on thesaurus content type."
msgstr "Pridėti specifinius turinio tipui papildomus laukus (įvykių būsenos, projektų būsenos ir t. t.) pagal tezaurų turinio tipą."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Auto Summary"
msgstr "Įjungti automatinę santrauką"

#: src/Form/BiolandSettingsForm.php
msgid "Automatically generate summary from body content as user types."
msgstr "Automatiškai generuoti santrauką iš pagrindinio turinio, kai vartotojas rašo."

#: src/Form/BiolandSettingsForm.php
msgid "Enable Field Help Comments"
msgstr "Įjungti laukų pagalbos komentarus"

#: src/Form/BiolandSettingsForm.php
msgid "Display contextual help comments for fields based on content type."
msgstr "Rodyti kontekstinius pagalbos komentarus laukams pagal turinio tipą."

#: src/Form/BiolandSettingsForm.php
msgid "Field Visibility Rules"
msgstr "Laukų matomumo taisyklės"

#: src/Form/BiolandSettingsForm.php
msgid "Define custom field visibility rules (JSON format)."
msgstr "Apibrėžkite pasirinktines laukų matomumo taisykles (JSON formatu)."

#: src/Form/BiolandSettingsForm.php
msgid "Translation Defaults"
msgstr "Numatytieji vertimai"

#: src/Form/BiolandSettingsForm.php
msgid "Configure creation of translation defaults (language placeholders) for translatable entities."
msgstr "Konfigūruoti vertimų numatytųjų (kalbos vietos rezervavimo ženklų) kūrimą verčiamiems objektams."

#: src/Form/BiolandSettingsForm.php
msgid "Automatically create translation defaults"
msgstr "Automatiškai kurti numatytuosius vertimus"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translation defaults (placeholders) are created for other languages at entity create/update. Existing translations with proper source are not overwritten."
msgstr "Kai įjungta, numatytieji vertimai (vietos rezervavimo ženklai) sukuriami kitoms kalboms kuriant/atnaujinant objektą. Esami vertimai su tinkamu šaltiniu neperrašomi."

#: src/Form/BiolandSettingsForm.php
msgid "Use all available languages"
msgstr "Naudoti visas galimas kalbas"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translations will be created for all languages installed on the site. When disabled, only the selected target languages below will be used."
msgstr "Kai įjungta, vertimai bus kuriami visoms svetainėje įdiegtoms kalboms. Kai išjungta, bus naudojamos tik žemiau pasirinktos tikslinės kalbos."

#: src/Form/BiolandSettingsForm.php
msgid "Target languages for translation defaults"
msgstr "Tikslinės kalbos numatytiesiems vertimams"

#: src/Form/BiolandSettingsForm.php
msgid "Select which languages to create translation defaults for. Used only when \"Use all available languages\" is disabled."
msgstr "Pasirinkite, kurioms kalboms kurti numatytuosius vertimus. Naudojama tik tada, kai parinktis „Naudoti visas galimas kalbas“ yra išjungta."

#: src/Form/BiolandSettingsForm.php
msgid "Copy source field values"
msgstr "Kopijuoti šaltinio laukų reikšmes"

#: src/Form/BiolandSettingsForm.php
msgid "When enabled, translatable field values from the source language will be copied to new translations."
msgstr "Kai įjungta, verčiamų laukų reikšmės iš šaltinio kalbos bus nukopijuotos į naujus vertimus."

#: src/Form/BiolandSettingsForm.php
msgid "Entity types"
msgstr "Objektų tipai"

#: src/Form/BiolandSettingsForm.php
msgid "Select which entity types should have translation defaults created."
msgstr "Pasirinkite, kuriems objektų tipams turėtų būti kuriami numatytieji vertimai."

#: src/Form/BiolandSettingsForm.php
msgid "Batch Operations"
msgstr "Masinės operacijos"

#: src/Form/BiolandSettingsForm.php
msgid "Process existing entities to create missing translation defaults."
msgstr "Apdoroti esamus objektus, kad būtų sukurti trūkstami numatytieji vertimai."

#: src/Form/BiolandSettingsForm.php
msgid "Entity type to process"
msgstr "Apdorojamas objekto tipas"

#: src/Form/BiolandSettingsForm.php
msgid "- Select -"
msgstr "- Pasirinkite -"

#: src/Form/BiolandSettingsForm.php
msgid "Select an entity type to create translations for existing entities."
msgstr "Pasirinkite objekto tipą, kad sukurtumėte vertimus esamiems objektams."

#: src/Form/BiolandSettingsForm.php
msgid "Create translation defaults for existing entities"
msgstr "Sukurti numatytuosius vertimus esamiems objektams"

#: src/Form/BiolandSettingsForm.php
msgid "Please select an entity type to process."
msgstr "Prašome pasirinkti apdorojamą objekto tipą."

