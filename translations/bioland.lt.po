#: src/Form/BiolandSettingsForm.php
msgid "General Settings"
msgstr "Bendrieji nustatymai"

#: src/Form/BiolandSettingsForm.php
msgid "Countries"
msgstr "Šalys"

#: src/Form/BiolandSettingsForm.php
msgid "Enter one country code per line."
msgstr "Įveskite po vieną šalies kodą eilutėje."

#: src/Form/BiolandSettingsForm.php
msgid "Region"
msgstr "Regionas"

#: src/Form/BiolandSettingsForm.php
msgid "Select the geographical region."
msgstr "Pasirinkite geografinį regioną."

#: src/Form/BiolandSettingsForm.php
msgid "North America"
msgstr "Šiaurės Amerika"

#: src/Form/BiolandSettingsForm.php
msgid "South America"
