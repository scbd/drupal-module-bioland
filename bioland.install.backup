/**
 * Helper function to install custom user admin view.
 *
 * Modifies the views.view.user_admin_people configuration to show
 * email address as the first sortable column at /admin/people.
 *
 * @return string
 *   Status message.
 */
function _bioland_install_user_admin_view() {
  // Check if views module is enabled.
  if ($skip = _bioland_require_module('views', 'user admin view installation')) {
    return $skip;
  }

  $config = \Drupal::configFactory()->getEditable('views.view.administerusersbyrole_people');
  
  if ($config->isNew()) {
    return t('User admin people view (administerusersbyrole_people) not found.');
  }
  
  try {
    // Get existing fields.
    $fields = $config->get('display.default.display_options.fields') ?: [];
    
    // Add the mail field if it doesn't exist.
    if (!isset($fields['mail'])) {
      $fields['mail'] = [
        'id' => 'mail',
        'table' => 'users_field_data',
        'field' => 'mail',
        'relationship' => 'none',
        'group_type' => 'group',
        'admin_label' => '',
        'entity_type' => 'user',
        'entity_field' => 'mail',
        'plugin_id' => 'field',
        'label' => 'Email',
        'exclude' => FALSE,
        'type' => 'email_mailto',
        'alter' => [
          'alter_text' => FALSE,
          'text' => '',
          'make_link' => FALSE,
          'path' => '',
          'absolute' => FALSE,
          'external' => FALSE,
          'replace_spaces' => FALSE,
          'path_case' => 'none',
          'trim_whitespace' => FALSE,
          'alt' => '',
          'rel' => '',
          'link_class' => '',
          'prefix' => '',
          'suffix' => '',
          'target' => '',
          'nl2br' => FALSE,
          'max_length' => 0,
          'word_boundary' => TRUE,
          'ellipsis' => TRUE,
          'more_link' => FALSE,
          'more_link_text' => '',
          'more_link_path' => '',
          'strip_tags' => FALSE,
          'trim' => FALSE,
          'preserve_tags' => '',
          'html' => FALSE,
        ],
        'element_type' => '',
        'element_class' => '',
        'element_label_type' => '',
        'element_label_class' => '',
        'element_label_colon' => TRUE,
        'element_wrapper_type' => '',
        'element_wrapper_class' => '',
        'element_default_classes' => TRUE,
        'empty' => '',
        'hide_empty' => FALSE,
        'empty_zero' => FALSE,
        'hide_alter_empty' => TRUE,
      ];
    }
    else {
      // Update the existing mail field to be visible with label and use email formatter.
      $fields['mail']['exclude'] = FALSE;
      $fields['mail']['label'] = 'Email';
      $fields['mail']['element_label_colon'] = TRUE;
      $fields['mail']['type'] = 'email_mailto';
    }
    
    // Reorder fields to put email after bulk_form but before name.
    // Order: user_bulk_form, mail, name, status, roles_target_id, created, access, operations
    $reordered = [];
    if (isset($fields['user_bulk_form'])) {
      $reordered['user_bulk_form'] = $fields['user_bulk_form'];
      unset($fields['user_bulk_form']);
    }
    if (isset($fields['mail'])) {
      $reordered['mail'] = $fields['mail'];
      unset($fields['mail']);
    }
    // Add remaining fields in their original order.
    $reordered = array_merge($reordered, $fields);
    
    $config->set('display.default.display_options.fields', $reordered);
    
    // Also update the table style info to make mail sortable.
    $style_info = $config->get('display.default.display_options.style.options.info') ?: [];
    $style_info['mail'] = [
      'sortable' => TRUE,
      'default_sort_order' => 'asc',
      'align' => '',
      'separator' => '',
      'empty_column' => FALSE,
      'responsive' => '',
    ];
    $config->set('display.default.display_options.style.options.info', $style_info);
    
    // Add mail to columns.
    $columns = $config->get('display.default.display_options.style.options.columns') ?: [];
    $columns['mail'] = 'mail';
    $config->set('display.default.display_options.style.options.columns', $columns);
    
    $config->save();
    
    // Clear the views cache so the updated view is recognized.
    if (\Drupal::hasService('views.views_data')) {
      \Drupal::service('views.views_data')->clear();
    }
    
    // Clear local task cache so menu tabs are discovered.
    if (\Drupal::hasService('plugin.manager.menu.local_task')) {
      \Drupal::service('plugin.manager.menu.local_task')->clearCachedDefinitions();
    }
    
    \Drupal::logger('bioland')->notice('Updated user admin view with email as first sortable column.');
    return t('Added email column as first sortable column at /admin/people.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Failed to update user admin view: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error updating user admin view: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Helper function to install custom comment admin view.
 *
 * Installs the views.view.comment_admin configuration which overrides
 * the default comment admin pages to add topic/forum filter.
 *
 * @return string
 *   Status message.
 */
function _bioland_install_comment_admin_view() {
  // Check if views and comment modules are enabled.
  if ($skip = _bioland_require_module('views', 'comment admin view installation')) {
    return $skip;
  }
  if ($skip = _bioland_require_module('comment', 'comment admin view installation')) {
    return $skip;
  }

  $config = \Drupal::configFactory()->getEditable('views.view.comment');
  
  if ($config->isNew()) {
    return t('View comment not found.');
  }
  
  try {
    $view_data = $config->getRawData();
    $display = &$view_data['display']['default']['display_options'];
    
    // Remove exposed sort options.
    if (isset($display['exposed_form']['options'])) {
      $display['exposed_form']['options']['expose_sort_order'] = FALSE;
    }
    
    if (isset($display['sorts'])) {
      foreach ($display['sorts'] as $sort_id => &$sort) {
        $sort['exposed'] = FALSE;
      }
    }
    
    // Add the node relationship if not present (required for topic filter).
    // This joins comment_field_data to node_field_data via entity_id.
    if (!isset($display['relationships'])) {
      $display['relationships'] = [];
    }
    $display['relationships']['entity_id'] = [
      'id' => 'entity_id',
      'table' => 'comment_field_data',
      'field' => 'entity_id',
      'relationship' => 'none',
      'group_type' => 'group',
      'admin_label' => 'Content',
      'plugin_id' => 'standard',
      'required' => FALSE,
    ];
    
    // Add "Topic Filter" (node bundle/type dropdown) to filter by commented content type.
    if (!isset($display['filters'])) {
      $display['filters'] = [];
    }
    $display['filters']['type'] = [
      'id' => 'type',
      'table' => 'node_field_data',
      'field' => 'type',
      'relationship' => 'entity_id',
      'group_type' => 'group',
      'admin_label' => 'Topic Filter',
      'entity_type' => 'node',
      'entity_field' => 'type',
      'plugin_id' => 'bundle',
      'operator' => 'in',
      'value' => [],
      'group' => 1,
      'exposed' => TRUE,
      'expose' => [
        'operator_id' => 'type_op',
        'label' => 'Topic Filter',
        'description' => 'Filter comments by content type (e.g., forum)',
        'use_operator' => FALSE,
        'operator' => 'type_op',
        'identifier' => 'type',
        'required' => FALSE,
        'remember' => FALSE,
        'multiple' => FALSE,
        'reduce' => FALSE,
      ],
      'is_grouped' => FALSE,
    ];
    
    $config->setData($view_data)->save();
    
    // Clear the views cache so the updated view is recognized.
    if (\Drupal::hasService('views.views_data')) {
      \Drupal::service('views.views_data')->clear();
    }
    
    // Clear local task cache so menu tabs are discovered.
    if (\Drupal::hasService('plugin.manager.menu.local_task')) {
      \Drupal::service('plugin.manager.menu.local_task')->clearCachedDefinitions();
    }
    
    \Drupal::logger('bioland')->notice('Updated comment view: removed exposed sort, added Entity Filter.');
    return t('Updated comment view: removed exposed sort, added "Entity Filter" at /admin/content/comment.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Failed to update comment view: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error updating comment view: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Helper function to install custom media library view.
 *
 * Updates the views.view.media configuration to make columns sortable
 * and remove exposed sort dropdowns.
 *
 * @return string
 *   Status message.
 */
function _bioland_install_media_library_view() {
  // Check if views and media modules are enabled.
  if ($skip = _bioland_require_module('views', 'media library view installation')) {
    return $skip;
  }
  if ($skip = _bioland_require_module('media', 'media library view installation')) {
    return $skip;
  }

  $config = \Drupal::configFactory()->getEditable('views.view.media');
  
  if ($config->isNew()) {
    return t('View media not found.');
  }
  
  try {
    $view_data = $config->getRawData();
    $display = &$view_data['display']['default']['display_options'];
    
    // Fields to make sortable.
    $sortable_fields = ['name', 'bundle', 'status', 'changed', 'uid'];
    
    // Update table style info to enable sorting on column headers.
    if (isset($display['style']['options']['info'])) {
      foreach ($sortable_fields as $field_id) {
        if (isset($display['style']['options']['info'][$field_id])) {
          $display['style']['options']['info'][$field_id]['sortable'] = TRUE;
          if (!isset($display['style']['options']['info'][$field_id]['default_sort_order'])) {
            $display['style']['options']['info'][$field_id]['default_sort_order'] = 'asc';
          }
        }
      }
    }
    
    // Remove exposed "Sort by" and "Order" dropdowns.
    if (isset($display['exposed_form']['options'])) {
      $display['exposed_form']['options']['expose_sort_order'] = FALSE;
    }
    
    // Un-expose all sort criteria.
    if (isset($display['sorts'])) {
      foreach ($display['sorts'] as $sort_id => &$sort) {
        $sort['exposed'] = FALSE;
      }
    }
    
    $config->setData($view_data)->save();
    
    // Clear the views cache so the updated view is recognized.
    if (\Drupal::hasService('views.views_data')) {
      \Drupal::service('views.views_data')->clear();
    }
    
    // Clear local task cache so menu tabs are discovered.
    if (\Drupal::hasService('plugin.manager.menu.local_task')) {
      \Drupal::service('plugin.manager.menu.local_task')->clearCachedDefinitions();
    }
    
    \Drupal::logger('bioland')->notice('Updated media view: enabled column sorting and removed Sort by/Order dropdowns.');
    return t('Updated media view: enabled column sorting and removed Sort by/Order dropdowns.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Failed to update media view: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error updating media view: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Helper function to install optional field configurations.
 *
 * Installs field storage and field configs from config/optional that may not
 * be auto-imported due to dependency resolution timing.
 *
 * @return string
 *   Status messages about configuration.
 */
function _bioland_install_optional_field_configs() {
  $messages = [];
  $config_path = \Drupal::service('extension.list.module')->getPath('bioland') . '/config/optional';
  $source = new \Drupal\Core\Config\FileStorage($config_path);

  // List of optional field storage configs to install (in dependency order).
  $field_storages = [
    'field.storage.node.field_order',
  ];

  // List of optional field instance configs to install.
  $field_configs = [
    'field.field.node.content.field_order',
    'field.field.node.content.field_url',
  ];

  // Install field storages first using entity API (creates database tables).
  foreach ($field_storages as $config_name) {
    try {
      // Extract field name from config name (e.g., 'field.storage.node.field_order' -> 'field_order').
      $parts = explode('.', $config_name);
      $field_name = end($parts);
      $entity_type = $parts[2]; // 'node'

      // Check if field storage already exists.
      $existing_storage = \Drupal\field\Entity\FieldStorageConfig::loadByName($entity_type, $field_name);
      if (!$existing_storage) {
        $config_data = $source->read($config_name);
        if ($config_data) {
          // Create field storage entity (this creates the database table).
          $field_storage = \Drupal\field\Entity\FieldStorageConfig::create($config_data);
          $field_storage->save();
          $messages[] = t('Created field storage @config.', ['@config' => $config_name]);
        }
      }
      else {
        $messages[] = t('Field storage @config already exists.', ['@config' => $config_name]);
      }
    }
    catch (\Exception $e) {
      \Drupal::logger('bioland')->warning('Could not install field storage @config: @message', [
        '@config' => $config_name,
        '@message' => $e->getMessage(),
      ]);
    }
  }

  // Install field instance configs using entity API.
  foreach ($field_configs as $config_name) {
    try {
      // Extract field name and bundle from config name.
      // e.g., 'field.field.node.content.field_order' -> entity_type='node', bundle='content', field_name='field_order'
      $parts = explode('.', $config_name);
      $entity_type = $parts[2]; // 'node'
      $bundle = $parts[3]; // 'content'
      $field_name = $parts[4]; // 'field_order'

      // Check if field config already exists.
      $existing_field = \Drupal\field\Entity\FieldConfig::loadByName($entity_type, $bundle, $field_name);
      if (!$existing_field) {
        $config_data = $source->read($config_name);
        if ($config_data) {
          // Create field config entity.
          $field_config = \Drupal\field\Entity\FieldConfig::create($config_data);
          $field_config->save();
          $messages[] = t('Created field config @config.', ['@config' => $config_name]);
        }
      }
      else {
        $messages[] = t('Field config @config already exists.', ['@config' => $config_name]);
      }
    }
    catch (\Exception $e) {
      \Drupal::logger('bioland')->warning('Could not install field config @config: @message', [
        '@config' => $config_name,
        '@message' => $e->getMessage(),
      ]);
    }
  }

  // Clear field cache to pick up changes.
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();

  if (!empty($messages)) {
    \Drupal::logger('bioland')->notice('Installed optional field configs: @configs', [
      '@configs' => implode(', ', array_merge($field_storages, $field_configs)),
    ]);
  }

  return implode("\n", $messages);
}

/**
 * Create 'Content' menu link programmatically.
 */
function bioland_update_9048() {
  return _bioland_create_content_menu_link();
}

/**
 * Helper function to create the Content menu link.
 *
 * Creates a menu link for quickly adding Content nodes.
 *
 * @return string
 *   Status message.
 */
function _bioland_create_content_menu_link() {
  // Check if MenuLinkContent entity type exists.
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('menu_link_content')) {
    return t('MenuLinkContent entity type not available; skipping menu link creation.');
  }

  // Check if a menu link already exists to avoid duplicates.
  $existing_links = $entity_type_manager
    ->getStorage('menu_link_content')
    ->loadByProperties([
      'title' => 'Content',
      'link__uri' => 'internal:/node/add/content',
    ]);

  if (!empty($existing_links)) {
    // Menu link exists, but let's make sure it's enabled and properly configured.
    foreach ($existing_links as $link) {
      if (!$link->isEnabled()) {
        $link->set('enabled', TRUE);
        $link->save();
      }
    }
    return t('Content menu link already exists; verified enabled status.');
  }

  // Use the known "Add content" parent menu link UUID.
  $parent_plugin_id = 'menu_link_content:60d958d0-9261-4161-95a9-2ee1970c38c0';

  // Create the menu link in the admin toolbar under "Add content".
  $menu_link = $entity_type_manager
    ->getStorage('menu_link_content')
    ->create([
      'title' => 'Content',
      'link' => ['uri' => 'internal:/node/add/content'],
      'menu_name' => 'admin',
      'parent' => $parent_plugin_id,
      'weight' => -100,
      'expanded' => FALSE,
      'enabled' => TRUE,
    ]);
  
  try {
    $menu_link->save();
    
    // Rebuild the menu router to pick up the new link.
    \Drupal::service('router.builder')->rebuild();
    
    // Clear menu caches.
    \Drupal::cache('menu')->invalidateAll();
    
    // Also clear the menu tree cache.
    if (\Drupal::hasService('menu.link_tree')) {
      \Drupal::service('menu.link_tree')->rebuild();
    }
    
    return t('Created "Content" menu link pointing to /node/add/content (parent: @parent).', [
      '@parent' => $parent_plugin_id,
    ]);
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Failed to create Content menu link: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error creating Content menu link: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Fix comment admin view topic filter configuration.
 *
 * Fixes the Bundle filter that was causing InvalidArgumentException
 * by correcting the relationship and filter configuration.
 */
function bioland_update_9049() {
  return _bioland_fix_comment_admin_view_filter();
}

/**
 * Helper function to fix the comment admin view topic filter.
 *
 * Removes the broken 'type' filter and 'node' relationship, then re-adds
 * them with the correct configuration.
 *
 * @return string
 *   Status message.
 */
function _bioland_fix_comment_admin_view_filter() {
  // Check if views and comment modules are enabled.
  if ($skip = _bioland_require_module('views', 'comment admin view fix')) {
    return $skip;
  }
  if ($skip = _bioland_require_module('comment', 'comment admin view fix')) {
    return $skip;
  }

  $config = \Drupal::configFactory()->getEditable('views.view.comment');
  
  if ($config->isNew()) {
    return t('View comment not found.');
  }
  
  try {
    $view_data = $config->getRawData();
    $display = &$view_data['display']['default']['display_options'];
    
    // Remove the broken 'node' relationship if it exists.
    if (isset($display['relationships']['node'])) {
      unset($display['relationships']['node']);
    }
    
    // Remove the broken 'type' filter if it exists.
    if (isset($display['filters']['type'])) {
      unset($display['filters']['type']);
    }
    
    // Add the correct node relationship using entity_id.
    if (!isset($display['relationships'])) {
      $display['relationships'] = [];
    }
    $display['relationships']['entity_id'] = [
      'id' => 'entity_id',
      'table' => 'comment_field_data',
      'field' => 'entity_id',
      'relationship' => 'none',
      'group_type' => 'group',
      'admin_label' => 'Content',
      'plugin_id' => 'standard',
      'required' => FALSE,
    ];
    
    // Add the corrected "Topic Filter" using the entity_id relationship.
    if (!isset($display['filters'])) {
      $display['filters'] = [];
    }
    $display['filters']['type'] = [
      'id' => 'type',
      'table' => 'node_field_data',
      'field' => 'type',
      'relationship' => 'entity_id',
      'group_type' => 'group',
      'admin_label' => 'Topic Filter',
      'entity_type' => 'node',
      'entity_field' => 'type',
      'plugin_id' => 'bundle',
      'operator' => 'in',
      'value' => [],
      'group' => 1,
      'exposed' => TRUE,
      'expose' => [
        'operator_id' => 'type_op',
        'label' => 'Topic Filter',
        'description' => 'Filter comments by content type (e.g., forum)',
        'use_operator' => FALSE,
        'operator' => 'type_op',
        'identifier' => 'type',
        'required' => FALSE,
        'remember' => FALSE,
        'multiple' => FALSE,
        'reduce' => FALSE,
      ],
      'is_grouped' => FALSE,
    ];
    
    $config->setData($view_data)->save();
    
    // Clear the views cache so the updated view is recognized.
    if (\Drupal::hasService('views.views_data')) {
      \Drupal::service('views.views_data')->clear();
    }
    
    // Clear local task cache.
    if (\Drupal::hasService('plugin.manager.menu.local_task')) {
      \Drupal::service('plugin.manager.menu.local_task')->clearCachedDefinitions();
    }
    
    \Drupal::logger('bioland')->notice('Fixed comment view: corrected topic filter configuration.');
    return t('Fixed comment view topic filter configuration at /admin/content/comment.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Failed to fix comment view: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error fixing comment view: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Fix email field formatter in user admin view to use clickable mailto links.
 */
function bioland_update_9050() {
  return _bioland_fix_user_admin_email_formatter();
}

/**
 * Helper function to fix the email field formatter.
 *
 * Updates the mail field to use email_mailto type for clickable links.
 *
 * @return string
 *   Status message.
 */
function _bioland_fix_user_admin_email_formatter() {
  // Check if views module is enabled.
  if ($skip = _bioland_require_module('views', 'user admin email formatter fix')) {
    return $skip;
  }

  $config = \Drupal::configFactory()->getEditable('views.view.administerusersbyrole_people');
  
  if ($config->isNew()) {
    return t('User admin people view (administerusersbyrole_people) not found.');
  }
  
  try {
    $fields = $config->get('display.default.display_options.fields') ?: [];
    
    if (isset($fields['mail'])) {
      // Set the type to email_mailto for clickable mailto links.
      $fields['mail']['type'] = 'email_mailto';
      $config->set('display.default.display_options.fields', $fields);
      $config->save();
      
      // Clear the views cache.
      if (\Drupal::hasService('views.views_data')) {
        \Drupal::service('views.views_data')->clear();
      }
      
      \Drupal::logger('bioland')->notice('Fixed email field formatter to use mailto links.');
      return t('Updated email field to use clickable mailto links at /admin/people.');
    }
    
    return t('Email field not found in user admin view; running full install.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Failed to fix email formatter: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error fixing email formatter: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Recreate Content menu link with correct parent discovery.
 */
function bioland_update_9051() {
  // First, delete any existing broken menu links.
  $entity_type_manager = \Drupal::entityTypeManager();
  if ($entity_type_manager->hasDefinition('menu_link_content')) {
    $existing_links = $entity_type_manager
      ->getStorage('menu_link_content')
      ->loadByProperties([
        'title' => 'Content',
        'link__uri' => 'internal:/node/add/content',
      ]);
    
    foreach ($existing_links as $link) {
      $link->delete();
    }
  }
  
  // Now create fresh with proper parent discovery.
  return _bioland_create_content_menu_link();
}

/**
 * Update menu item ID 139 URL to /admin/content/media.
 */
function bioland_update_9052() {
  $result = _bioland_update_menu_item_139();
  
  // Rebuild router after menu URL change (not done in helper to avoid double-rebuild during install).
  if (\Drupal::hasService('router.builder')) {
    \Drupal::service('router.builder')->rebuild();
  }
  
  return $result;
}

/**
 * Helper function to update menu item 139 URL.
 *
 * Changes the URL of menu_link_content entity with ID 139 to /admin/content/media.
 *
 * @return string
 *   Status message.
 */
function _bioland_update_menu_item_139() {
  $entity_type_manager = \Drupal::entityTypeManager();
  
  if (!$entity_type_manager->hasDefinition('menu_link_content')) {
    return t('MenuLinkContent entity type not available; skipping menu item update.');
  }
  
  try {
    $menu_link = $entity_type_manager
      ->getStorage('menu_link_content')
      ->load(139);
    
    if (!$menu_link) {
      return t('Menu item with ID 139 not found.');
    }
    
    $old_url = $menu_link->get('link')->uri ?? 'unknown';
    $menu_link->set('link', ['uri' => 'internal:/admin/content/media']);
    $menu_link->save();
    
    // Clear menu caches only - router rebuild happens at end of install.
    \Drupal::cache('menu')->invalidateAll();
    
    \Drupal::logger('bioland')->notice('Updated menu item 139 URL from @old to /admin/content/media.', [
      '@old' => $old_url,
    ]);
    return t('Updated menu item 139 URL from @old to /admin/content/media.', [
      '@old' => $old_url,
    ]);
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Failed to update menu item 139: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error updating menu item 139: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Hide menu parent field on menu link translation forms.
 *
 * This update hook is a no-op (cache clear only) since the functionality
 * is implemented via hook_form_alter() in bioland.module.
 * The menu_parent field will now be hidden when editing translations
 * of menu links (non-source language), ensuring menu structure is only
 * managed from the source language.
 */
function bioland_update_9053() {
  // Clear form caches to ensure the form alter takes effect.
  \Drupal::service('cache.render')->invalidateAll();
  
  return t('Menu parent field will now be hidden on menu link translation forms. Menu structure should be managed from the source language only.');
}

