<?php

use Drupal\Core\StringTranslation\StringTranslationTrait;
use Drupal\Core\Extension\ModuleHandlerInterface;
use Drupal\Core\Site\Settings;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\user\Entity\Role;

/**
 * @file
 * Install, update and uninstall functions for the Bioland module.
 */

/*
 * =============================================================================
 * HELPER FUNCTIONS - Consolidated utilities to reduce code duplication
 * =============================================================================
 */

/**
 * Check if a module is enabled, returning skip message if not.
 *
 * @param string $module
 *   The module name to check.
 * @param string $feature
 *   Description of the feature being skipped.
 *
 * @return string|null
 *   Skip message if module not enabled, NULL if module is available.
 */
function _bioland_require_module($module, $feature = 'operation') {
  if (!\Drupal::moduleHandler()->moduleExists($module)) {
    return t('@module module is not enabled; skipping @feature.', [
      '@module' => $module,
      '@feature' => $feature,
    ]);
  }
  return NULL;
}

/**
 * Ensure custom roles exist, creating them if missing.
 *
 * @param array $roles
 *   Associative array of role_id => role_label.
 *
 * @return array
 *   Array of status messages.
 */
function _bioland_ensure_roles_exist(array $roles) {
  $messages = [];
  foreach ($roles as $rid => $label) {
    if (!Role::load($rid)) {
      $role = Role::create([
        'id' => $rid,
        'label' => $label,
      ]);
      $role->save();
      $messages[] = t('Created role: @role', ['@role' => $label]);
    }
  }
  return $messages;
}

/**
 * Grant permissions to roles based on a permission matrix.
 *
 * @param array $permission_matrix
 *   Associative array of role_id => [permission1, permission2, ...].
 *
 * @return array
 *   Array of status messages.
 */
function _bioland_grant_role_permissions(array $permission_matrix) {
  $messages = [];
  foreach ($permission_matrix as $rid => $permissions) {
    $role = Role::load($rid);
    if ($role) {
      $changed = FALSE;
      foreach ($permissions as $permission) {
        if (!$role->hasPermission($permission)) {
          $role->grantPermission($permission);
          $changed = TRUE;
        }
      }
      if ($changed) {
        $role->save();
        $messages[] = t('Granted bioland permissions to @role.', ['@role' => $rid]);
      }
    }
  }
  return $messages;
}

/**
 * Manage user account: create, update, or block.
 *
 * @param \Drupal\Core\Entity\EntityStorageInterface $user_storage
 *   The user entity storage.
 * @param string $email
 *   The user email (also used as username).
 * @param array $roles
 *   Array of role IDs to assign.
 * @param string $password
 *   The password to set.
 * @param string $action
 *   One of: 'create_only', 'create_or_update', 'block'.
 *
 * @return string|null
 *   Status message or NULL if no action taken.
 */
function _bioland_manage_user($user_storage, $email, array $roles, $password, $action = 'create_or_update') {
  // Find existing user by email or name.
  $existing = $user_storage->loadByProperties(['mail' => $email]);
  if (empty($existing)) {
    $existing = $user_storage->loadByProperties(['name' => $email]);
  }
  $user = !empty($existing) ? reset($existing) : NULL;

  // Handle block action.
  if ($action === 'block') {
    if (!$user) {
      return NULL;
    }
    // Remove all roles except authenticated.
    $current_roles = $user->getRoles(TRUE);
    foreach ($current_roles as $role_id) {
      $user->removeRole($role_id);
    }
    // Add system role.
    if (Role::load('system')) {
      $user->addRole('system');
    }
    $user->block();
    $user->save();
    return t('Blocked user @email and set to system role only.', ['@email' => $email]);
  }

  // Handle create_only action.
  if ($action === 'create_only' && $user) {
    return NULL;
  }

  // Create or update user.
  if ($user) {
    // Remove current roles.
    $current_roles = $user->getRoles(TRUE);
    foreach ($current_roles as $role_id) {
      $user->removeRole($role_id);
    }
    // Add new roles.
    foreach ($roles as $role_id) {
      if (Role::load($role_id)) {
        $user->addRole($role_id);
      }
    }
    $user->setPassword($password);
    $user->set('mail', $email);
    $user->activate();
    $user->save();
    return t('Updated user @email with roles: @roles.', [
      '@email' => $email,
      '@roles' => implode(', ', $roles),
    ]);
  }

  // Create new user.
  $user = $user_storage->create([
    'name' => $email,
    'mail' => $email,
    'pass' => $password,
    'status' => 1,
  ]);
  foreach ($roles as $role_id) {
    if (Role::load($role_id)) {
      $user->addRole($role_id);
    }
  }
  $user->save();
  return t('Created user @email with roles: @roles.', [
    '@email' => $email,
    '@roles' => implode(', ', $roles),
  ]);
}

/**
 * Get the standard Bioland roles definition.
 *
 * @return array
 *   Associative array of role_id => role_label.
 */
function _bioland_get_standard_roles() {
  return [
    'scbd_staff' => 'SCBD Staff',
    'site_manager' => 'Site Manager',
    'content_manager' => 'Content Manager',
    'contributor' => 'Contributor',
    'system' => 'System',
  ];
}

/**
 * Get the standard Bioland permission matrix.
 *
 * @return array
 *   Associative array of role_id => [permissions].
 */
function _bioland_get_standard_permission_matrix() {
  $permissions = [
    'administer bioland settings',
    'administer bioland field settings',
    'administer bioland translation settings',
    'access administration pages',
    'view the administration theme',
    'access site reports',
  ];
  return [
    'administrator' => $permissions,
    'site_manager' => $permissions,
    'content_manager' => $permissions,
    'scbd_staff' => $permissions,
  ];
}

/**
 * Configure maintenance mode access permissions.
 *
 * Grants 'access site in maintenance mode' to administrator and scbd_staff only.
 * Revokes the permission from other roles.
 *
 * @return array
 *   Array of status messages.
 */
function _bioland_configure_maintenance_mode_access() {
  $messages = [];
  
  // Grant permission to administrator and scbd_staff.
  $permission_matrix = [
    'administrator' => ['access site in maintenance mode'],
    'scbd_staff' => ['access site in maintenance mode'],
  ];
  
  $perm_messages = _bioland_grant_role_permissions($permission_matrix);
  $messages = array_merge($messages, $perm_messages);
  
  // Revoke permission from other roles if they have it.
  $roles_to_revoke = ['site_manager', 'content_manager', 'contributor', 'system', 'authenticated'];
  foreach ($roles_to_revoke as $rid) {
    $role = Role::load($rid);
    if ($role && $role->hasPermission('access site in maintenance mode')) {
      $role->revokePermission('access site in maintenance mode');
      $role->save();
      $messages[] = t('Revoked maintenance mode access from @role.', ['@role' => $rid]);
    }
  }
  
  return $messages;
}

