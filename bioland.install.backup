      ],
      'weight' => 0,
    ],
  ];
}

/**
 * Fetch and update countries from DMSM API based on hostname.
 *
 * @param string|null $hostname
 *   Optional hostname to parse. If NULL, uses current request host.
 *
 * @return string|null
 *   Status message about the operation, or NULL on success.
 */
function _bioland_update_countries_from_dmsm($hostname = null) {
  try {
    $dmsm_service = \Drupal::service('bioland.dmsm_config');
    $result = $dmsm_service->updateCountriesFromDmsm($hostname);
    
    if ($result['success']) {
      return NULL; // Success
    } else {
      return t('Failed to fetch countries from DMSM API: @message', ['@message' => $result['message']]);
    }
  }
  catch (\Exception $e) {
    return t('Error fetching countries from DMSM API: @message', ['@message' => $e->getMessage()]);
  }
}

/*
 * =============================================================================
 * HOOK IMPLEMENTATIONS
 * =============================================================================
 */

/**
 * Implements hook_install().
 */
function bioland_install() {
  // Disable search index at start to prevent indexing during install.
  // It will be re-enabled and reindexed at the very end via _bioland_final_reindex().
  _bioland_disable_search_index();

  // Validate required system roles exist before proceeding.
  $required_system_roles = ['anonymous', 'authenticated', 'administrator'];
  foreach ($required_system_roles as $rid) {
    if (!Role::load($rid)) {
      throw new \RuntimeException(sprintf('Required system role "%s" is missing. Please ensure core roles Anonymous, Authenticated, and Administrator exist before installing Bioland.', $rid));
    }
  }

  // Ensure custom roles exist or create them if missing.
  _bioland_ensure_roles_exist(_bioland_get_standard_roles());

  // Ensure required content type with machine name 'content' exists.
  if (\Drupal::moduleHandler()->moduleExists('node')) {
    $type = NodeType::load('content');
    if (!$type) {
      $type = NodeType::create([
        'type' => 'content',
        'name' => 'Content',
      ]);
      $type->save();
    }
  }

  // Install optional field configs early (creates database tables via entity API).
  // This MUST happen before any code that references field_order or other optional fields.
  _bioland_install_optional_field_configs();

  // Grant permissions to roles.
  _bioland_grant_role_permissions(_bioland_get_standard_permission_matrix());

  // Configure maintenance mode access (administrator and scbd_staff only).
  _bioland_configure_maintenance_mode_access();

  // Initialize configuration defaults, optionally sourcing from settings.php.
  try {
    $config_factory = \Drupal::configFactory();
    $editable = $config_factory->getEditable('bioland.settings');

    // Read settings under $settings['scbd_field'].
    $scbd = Settings::get('scbd_field') ?: [];

    // Default countries from settings.scbd_field.countries.
    $countries = $editable->get('countries') ?: ['lk'];
    if (isset($scbd['countries'])) {
      $countries = is_array($scbd['countries']) ? $scbd['countries'] : [$scbd['countries']];
    }

    $editable
  ->set('countries', array_values(array_filter($countries)))
      ->save();
  }
  catch (\Throwable $e) {
    // Swallow errors to avoid failing installation; values will remain defaults.
  }

  // Fetch and update countries from DMSM API based on hostname.
  try {
    _bioland_update_countries_from_dmsm();
  }
  catch (\Throwable $e) {
    // Log but don't fail installation if DMSM API is unavailable.
    \Drupal::logger('bioland')->warning('Could not fetch countries from DMSM API during install: @message', ['@message' => $e->getMessage()]);
  }

  // Import translations from PO files.
  _bioland_import_translations();

  // Ensure the new field is visible in the form display.
  $entity_form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.content.default');

  if ($entity_form_display) {
    $entity_form_display->setComponent('field_order', [
      'type' => 'number',
      'weight' => 10,
    ]);
    $entity_form_display->save();
  }

  // Add field_order to Search API "content" index if it exists.
  _bioland_add_field_order_to_search_index();

  // Ensure help text is cleared for specific fields on the Content type.
  _bioland_clear_field_help_text('node', 'content', ['body', 'field_attachments']);

  // Set text fields to only allow full_html format.
  _bioland_set_full_html_only_format();

  // Update existing content to use full_html format.
  _bioland_update_content_to_full_html();

  // Configure the default Linkit profile.
  _bioland_configure_linkit_profile();

  // Configure content fields: non-translatable, remove defaults, Linkit widget.
  _bioland_configure_content_fields();

  // Configure full_html format with Linkit and disable basic_html.
  _bioland_configure_full_html_format();

  // Sync scbd_staff permissions with site_manager.
  _bioland_sync_scbd_staff_permissions();

  // Block legacy @cbd.int users.
  _bioland_block_cbd_int_users();

  // Configure Search API index and facets.
  _bioland_configure_search_api_index();
  _bioland_configure_facets();

  // Add langcode field to content form sidebar.
  _bioland_configure_langcode_form_display();

  // Configure available menus for content type.
  _bioland_configure_content_type_available_menus();

  // Configure content type taxonomy terms.
  _bioland_configure_content_types();

  // Configure content type status based on site type (BL2 vs Biosafety Land).
  _bioland_configure_content_type_status_by_site_type();

  // Configure system_pages search terms.
  _bioland_configure_system_pages_search_terms();

  // Disable unused JSON API resource endpoints.
  _bioland_disable_jsonapi_resources();

  // Enable Main Menu Lock and remove permissions from specific roles.
  _bioland_enable_main_menu_lock();

  // Set content type weights for /node/add page ordering.
  _bioland_configure_content_type_weights();

  // Install custom views with enhanced functionality.
  _bioland_install_user_admin_view();
 // _bioland_install_comment_admin_view();
  _bioland_install_media_library_view();

  // Update menu item 139 URL to /admin/content/media.
  _bioland_update_menu_item_139();

  // Configure full_html editor toolbar and image upload settings.
  _bioland_configure_full_html_editor_toolbar();

  // Provision test, training, and staff user accounts.
  _bioland_provision_users();

  // Rebuild router to register view routes and local tasks.
  \Drupal::service('router.builder')->rebuild();

  // FINAL STEP: Rebuild search index tracking and trigger reindex.
  // This MUST be the last operation to ensure all configuration changes
  // are captured in the index.
  _bioland_final_reindex();
}

/**
 * Helper function to set text fields to only allow 'full_html' format.
 *
 * Updates field configuration for body (node), field_description (media),
 * and comment_body (comment) to restrict allowed text formats to only 'full_html'.
 *
 * @return array
 *   An array of status messages.
 */
function _bioland_set_full_html_only_format() {
  $messages = [];
  $updated_count = 0;

  // Define field configurations to update.
  $fields_to_update = [
    'node' => [
      'body' => [],
    ],
    'media' => [
      'field_description' => [],
    ],
    'comment' => [
      'comment_body' => [],
    ],
  ];

  $entity_type_manager = \Drupal::entityTypeManager();

  foreach ($fields_to_update as $entity_type => $fields) {
    foreach ($fields as $field_name => $bundles) {
      // If no bundles specified, get all bundles that have this field.
      if (empty($bundles)) {
        $field_storage = FieldStorageConfig::loadByName($entity_type, $field_name);
        if (!$field_storage) {
          $messages[] = "Field storage {$entity_type}.{$field_name} does not exist.";
          continue;
        }

        // Find all bundles using this field.
        $field_configs = $entity_type_manager
          ->getStorage('field_config')
          ->loadByProperties([
            'entity_type' => $entity_type,
            'field_name' => $field_name,
          ]);

        foreach ($field_configs as $field_config) {
          $bundle = $field_config->getTargetBundle();
          $bundles[] = $bundle;
        }
      }

      // Update each bundle's field configuration.
      foreach ($bundles as $bundle) {
        $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);
        if (!$field) {
          continue;
        }

        $settings = $field->getSettings();
        
        // Set allowed_formats to only include 'full_html'.
        $settings['allowed_formats'] = ['full_html'];
        $field->setSettings($settings);
        $field->save();
        $updated_count++;
        
        $messages[] = "Set {$entity_type}.{$bundle}.{$field_name} to only allow full_html format.";
      }
    }
  }

  if ($updated_count > 0) {
    \Drupal::logger('bioland')->notice('Updated @count field configuration(s) to only allow full_html format.', [
      '@count' => $updated_count,
    ]);
  }

  return $messages;
}

/**
 * Helper function to update existing content to use 'full_html' format.
 *
 * Updates body (node), field_description (media), and comment_body (comment)
 * field values to use 'full_html' format.
 *
 * @return array
 *   An array with counts of updated and errored entities.
 */
function _bioland_update_content_to_full_html() {
  $updated = 0;
  $errors = 0;
  $messages = [];
  $database = \Drupal::database();

  \Drupal::logger('bioland')->notice('Starting full_html update using DIRECT DATABASE QUERIES (no entity saves).');

  // Use direct database queries to update text format without triggering
  // entity saves, which can cause issues with translations that have NULL titles.

  // Update node body field format.
  try {
    // Update node__body table (current data).
    $node_updated = $database->update('node__body')
      ->fields(['body_format' => 'full_html'])
      ->condition('body_format', 'full_html', '!=')
      ->execute();

    // Update node_revision__body table (revision data).
    $node_rev_updated = $database->update('node_revision__body')
      ->fields(['body_format' => 'full_html'])
      ->condition('body_format', 'full_html', '!=')
      ->execute();

    if ($node_updated > 0 || $node_rev_updated > 0) {
      $updated += $node_updated;
      $messages[] = t('Updated @count node body fields (@rev revisions).', [
        '@count' => $node_updated,
        '@rev' => $node_rev_updated,
      ]);
    }
  }
  catch (\Exception $e) {
    $errors++;
    \Drupal::logger('bioland')->error('Error updating node body format: @message', [
      '@message' => $e->getMessage(),
    ]);
  }

  // Update media field_description format.
  if (\Drupal::moduleHandler()->moduleExists('media')) {
    try {
      // Check if table exists.
      if ($database->schema()->tableExists('media__field_description')) {
        $media_updated = $database->update('media__field_description')
          ->fields(['field_description_format' => 'full_html'])
          ->condition('field_description_format', 'full_html', '!=')
          ->execute();

        if ($media_updated > 0) {
          $updated += $media_updated;
          $messages[] = t('Updated @count media description fields.', ['@count' => $media_updated]);
        }
      }

      // Update revision table if exists.
      if ($database->schema()->tableExists('media_revision__field_description')) {
        $database->update('media_revision__field_description')
          ->fields(['field_description_format' => 'full_html'])
          ->condition('field_description_format', 'full_html', '!=')
          ->execute();
      }
    }
    catch (\Exception $e) {
      $errors++;
      \Drupal::logger('bioland')->error('Error updating media description format: @message', [
        '@message' => $e->getMessage(),
      ]);
    }
  }

  // Update comment_body format.
  if (\Drupal::moduleHandler()->moduleExists('comment')) {
    try {
      // Check if table exists.
      if ($database->schema()->tableExists('comment__comment_body')) {
        $comment_updated = $database->update('comment__comment_body')
          ->fields(['comment_body_format' => 'full_html'])
          ->condition('comment_body_format', 'full_html', '!=')
          ->execute();

        if ($comment_updated > 0) {
          $updated += $comment_updated;
          $messages[] = t('Updated @count comment body fields.', ['@count' => $comment_updated]);
        }
      }
    }
    catch (\Exception $e) {
      $errors++;
      \Drupal::logger('bioland')->error('Error updating comment body format: @message', [
        '@message' => $e->getMessage(),
      ]);
    }
  }

  // Clear entity caches so entities reflect the database changes.
  \Drupal::entityTypeManager()->getStorage('node')->resetCache();
  if (\Drupal::moduleHandler()->moduleExists('media')) {
    \Drupal::entityTypeManager()->getStorage('media')->resetCache();
  }
  if (\Drupal::moduleHandler()->moduleExists('comment')) {
    \Drupal::entityTypeManager()->getStorage('comment')->resetCache();
  }

  $summary = t('Updated @updated text format fields to full_html. Errors: @errors.', [
    '@updated' => $updated,
    '@errors' => $errors,
  ]);

  if (!empty($messages)) {
    \Drupal::logger('bioland')->notice($summary . ' ' . implode(' ', $messages));
  }

  return [
    'updated' => $updated,
    'errors' => $errors,
  ];
}

/**
 * Helper function to import translation files.
 */
function _bioland_import_translations() {
  // Only import if locale module is enabled.
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    \Drupal::logger('bioland')->notice('Skipping translation import: locale module is not enabled.');
    return;
  }

  // Check if the locale.translation service is available.
  if (!\Drupal::hasService('locale.translation')) {
    \Drupal::logger('bioland')->warning('Skipping translation import: locale.translation service is not available.');
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('bioland');
  $translations_path = $module_path . '/translations';

  // Check if translations directory exists.
  if (!is_dir($translations_path)) {
    \Drupal::logger('bioland')->notice('Skipping translation import: translations directory not found.');
    return;
  }

  // Get list of PO files.
  $files = \Drupal::service('file_system')->scanDirectory($translations_path, '/\.po$/');

  if (empty($files)) {
    \Drupal::logger('bioland')->notice('No translation files found to import.');
    return;
  }

  $imported_count = 0;
  $skipped_count = 0;

  foreach ($files as $file) {
    // Extract language code from filename (e.g., bioland.fr.po -> fr).
    if (preg_match('/bioland\.([a-z]{2})\.po$/', $file->filename, $matches)) {
      $langcode = $matches[1];

      // Check if language is enabled.
      $language = \Drupal::languageManager()->getLanguage($langcode);
      if (!$language) {
        \Drupal::logger('bioland')->notice('Skipping translation file @file: language @lang is not enabled.', [
          '@file' => $file->filename,
          '@lang' => $langcode,
        ]);
        $skipped_count++;
        continue;
      }

      // Import the PO file.
      try {
        $options = [
          'langcode' => $langcode,
          'overwrite_options' => [
            'customized' => TRUE,
            'not_customized' => TRUE,
          ],
          'customized' => TRUE,
        ];

        \Drupal::service('locale.translation')->importTranslationFile(
          $file->uri,
          $options
        );
        $imported_count++;
        \Drupal::logger('bioland')->notice('Successfully imported translation file @file.', [
          '@file' => $file->filename,
        ]);
      }
      catch (\Exception $e) {
        \Drupal::logger('bioland')->error('Failed to import translation file @file: @message', [
          '@file' => $file->filename,
          '@message' => $e->getMessage(),
        ]);
        $skipped_count++;
      }
    }
  }

  if ($imported_count > 0) {
    \Drupal::logger('bioland')->notice('Imported @count translation file(s).', [
      '@count' => $imported_count,
    ]);
  }
  if ($skipped_count > 0) {
    \Drupal::logger('bioland')->notice('Skipped @count translation file(s).', [
      '@count' => $skipped_count,
    ]);
  }
}

/**
 * Helper to clear field help text (description) for a bundle.
 *
 * This is used on install and in update hooks to ensure that specific fields
 * (e.g. body, field_attachments) on the `content` node type do not display
 * any help text on the node edit form.
 *
 * @param string $entity_type
 *   The entity type ID (e.g. 'node').
 * @param string $bundle
 *   The bundle machine name (e.g. 'content').
 * @param array $field_names
 *   A list of field machine names whose descriptions should be cleared.
 *
 * @return int
 *   The number of fields whose description was updated.
 */
function _bioland_clear_field_help_text($entity_type, $bundle, array $field_names) {
  $updated = 0;

  foreach ($field_names as $field_name) {
    /** @var \Drupal\field\Entity\FieldConfig|null $field */
    $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);
    if ($field && $field->getDescription() !== '') {
      $field->setDescription('');
      $field->save();
      $updated++;
    }
  }

  return $updated;
}

/**
 * Implements hook_requirements().
 */
function bioland_requirements($phase) {
  $requirements = [];

  if ($phase === 'install' || $phase === 'runtime') {
    // Verify contrib modules are available (composer) and enabled (Drupal).
    $contrib_modules = [
      'fontawesome' => 'drupal/fontawesome',
      'linkit' => 'drupal/linkit',
    ];

    $module_handler = \Drupal::moduleHandler();
    foreach ($contrib_modules as $machine_name => $composer_pkg) {
      $enabled = $module_handler->moduleExists($machine_name);
      if (!$enabled) {
        $requirements['bioland_dep_' . $machine_name] = [
          'title' => t('Required module: @module', ['@module' => $machine_name]),
          'value' => t('Missing or disabled'),
          'description' => t('Install and enable the module via Composer: composer require "@pkg" --with-all-dependencies', ['@pkg' => $composer_pkg]),
          'severity' => ($phase === 'install') ? REQUIREMENT_ERROR : REQUIREMENT_ERROR,
        ];
      }
    }

    $has_type = FALSE;
    if (\Drupal::moduleHandler()->moduleExists('node')) {
      $has_type = (bool) NodeType::load('content');
    }

    if (!$has_type) {
      $severity = ($phase === 'install') ? REQUIREMENT_WARNING : REQUIREMENT_ERROR;
      $requirements['bioland_node_content'] = [
        'title' => t('Bioland required content type'),
        'value' => t('Missing node type with machine name "content" (form id: node_content_form).'),
        'description' => t('Bioland requires a content type named "Content" with machine name "content". It will be created automatically on install; if still missing at runtime, please create it.'),
        'severity' => $severity,
      ];
    }
  }

  return $requirements;
}

/**
 * Migrate single 'country' config to 'countries' array.
 */
function bioland_update_9001() {
  $config_factory = \Drupal::configFactory();
  $editable = $config_factory->getEditable('bioland.settings');
  $old = $editable->get('country');
  $new = $editable->get('countries');
  if ($old && empty($new)) {
    $editable->set('countries', [$old]);
    $editable->clear('country');
    $editable->save();
  }
}

/**
 * Import Bioland translation files.
 */
function bioland_update_9002() {
  // Check if locale module and service are available.
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return t('Skipped translation import: locale module is not enabled.');
  }
  
  if (!\Drupal::hasService('locale.translation')) {
    return t('Skipped translation import: locale.translation service is not available. Enable the Interface Translation module.');
  }

  _bioland_import_translations();
  return t('Bioland translation import process completed. Check logs for details.');
}

/**
 * Set default entity type (node) for translation defaults if not configured.
 */
function bioland_update_9003() {
  $config_factory = \Drupal::configFactory();
  $editable = $config_factory->getEditable('bioland.settings');
  
  // Check if entity_types is empty or not set
  $entity_types = $editable->get('translation.entity_types');
  if (empty($entity_types)) {
    // Set node as the default entity type for translation defaults
    $editable->set('translation.entity_types', ['node']);
    $editable->save();
    return t('Set "node" as default entity type for translation defaults. Translation defaults will now be created automatically for nodes.');
  }
  
  return t('Entity types for translation defaults already configured.');
}

/**
 * Add the field_order field on existing installs.
 */
function bioland_update_9004() {
  // Ensure the node module and required content type exist.
  if (!\Drupal::moduleHandler()->moduleExists('node')) {
    return t('Skipped field_order creation: Node module is not enabled.');
  }

  $content_type = NodeType::load('content');
  if (!$content_type) {
    return t('Skipped field_order creation: Content type "content" does not exist.');
  }

  // Create field storage if it does not exist.
  $field_storage = FieldStorageConfig::loadByName('node', 'field_order');
  if (!$field_storage) {
    $field_storage = FieldStorageConfig::create([
      'field_name' => 'field_order',
      'entity_type' => 'node',
      'type' => 'integer',
      'settings' => [
        'unsigned' => FALSE,
        'size' => 'normal',
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ]);
    $field_storage->save();
  }

  // Create field instance on the "content" bundle if it does not exist.
  $field = FieldConfig::loadByName('node', 'content', 'field_order');
  if (!$field) {
    $field = FieldConfig::create([
      'field_name' => 'field_order',
      'entity_type' => 'node',
      'bundle' => 'content',
      'label' => 'Order',
      'description' => '',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'min' => NULL,
        'max' => NULL,
        'prefix' => '',
        'suffix' => '',
      ],
    ]);
    $field->save();
  }

  // Ensure the field is visible in the default form display.
  $entity_form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.content.default');

  if ($entity_form_display && !$entity_form_display->getComponent('field_order')) {
    $entity_form_display->setComponent('field_order', [
      'type' => 'number',
      'weight' => 10,
    ]);
    $entity_form_display->save();
  }

  return t('Ensured field_order field exists on the Content content type and is visible on the form display.');
}

/**
 * Clear help text on body and field_attachments fields for Content nodes.
 */
function bioland_update_9005() {
  $updated = _bioland_clear_field_help_text('node', 'content', ['body', 'field_attachments']);

  if ($updated > 0) {
    return t('Cleared help text on @count field(s) (body, field_attachments) for the Content content type.', ['@count' => $updated]);
  }

  return t('No help text found to clear on body or field_attachments for the Content content type.');
}

/**
 * Ensure SCBD Staff role exists on existing installs.
 */
function bioland_update_9006() {
  $messages = _bioland_ensure_roles_exist(['scbd_staff' => 'SCBD Staff']);
  return empty($messages) ? t('SCBD Staff role (scbd_staff) already exists; no changes made.') : implode(' ', $messages);
}

/**
 * Set max limit of 10000 on field_order field.
 */
function bioland_update_9007() {
  $field = FieldConfig::loadByName('node', 'content', 'field_order');

  if (!$field) {
    return t('field_order field does not exist; skipping max limit update.');
  }

  $settings = $field->getSettings();
  $settings['max'] = 10000;
  $field->setSettings($settings);
  $field->save();

  return t('Set max limit of 10000 on field_order field.');
}

/**
 * Remove deprecated enable_menu_depth_restriction config setting.
 */
function bioland_update_9008() {
  $config_factory = \Drupal::configFactory();
  $editable = $config_factory->getEditable('bioland.settings');

  // Check if the setting exists before clearing it.
  if ($editable->get('enable_menu_depth_restriction') !== NULL) {
    $editable->clear('enable_menu_depth_restriction');
    $editable->save();
    return t('Removed deprecated enable_menu_depth_restriction setting.');
  }

  return t('No enable_menu_depth_restriction setting found to remove.');
}

/**
 * Remove deprecated default_locale and enabled_locales config keys.
 */
function bioland_update_9009() {
  $config_factory = \Drupal::configFactory();
  $editable = $config_factory->getEditable('bioland.settings');

  $cleared = [];
  if ($editable->get('default_locale') !== NULL) {
    $editable->clear('default_locale');
    $cleared[] = 'default_locale';
  }
  if ($editable->get('enabled_locales') !== NULL) {
    $editable->clear('enabled_locales');
    $cleared[] = 'enabled_locales';
  }

  if (!empty($cleared)) {
    $editable->save();
    return t('Removed deprecated config keys: @keys.', ['@keys' => implode(', ', $cleared)]);
  }

  return t('No deprecated locale config keys found to remove.');
}

/**
 * Add help_comments configuration for editable help text.
 */
function bioland_update_9010() {
  $config_factory = \Drupal::configFactory();
  $editable = $config_factory->getEditable('bioland.settings');

  // Check if help_comments is already set
  if ($editable->get('help_comments') !== NULL) {
    return t('Help comments configuration already exists; no changes made.');
  }

  // Get all available languages (excluding Lolspeak)
  $language_manager = \Drupal::languageManager();
  $languages = $language_manager->getLanguages();
  $default_langcode = $language_manager->getDefaultLanguage()->getId();
  
  // Initialize translation arrays for all languages
  $body_text_translations = [];
  $attachments_images_translations = [];
  $attachments_heroes_translations = [];
  
  foreach ($languages as $langcode => $language) {
    // Skip default language and Lolspeak
    if ($langcode === $default_langcode || $langcode === 'en-x-lolspeak') {
      continue;
    }
    $body_text_translations[$langcode] = '';
    $attachments_images_translations[$langcode] = '';
    $attachments_heroes_translations[$langcode] = '';
  }

  // Set default help comment texts
  $help_comments = [
    'body_text' => 'This will be the main content of your new site content. The summary can be used to display a brief concise description of your content. Further, the summary will be displayed in list and card views of your record on the website. Alternatively, the first few sentences from the main content will be used.',
    'body_text_translations' => $body_text_translations,
    'attachments_images_text' => 'The first image in order of left to right here, will be the main image of your record displayed on the page and in thumbnails in list and card views. All other images will be displayed below the main content.',
    'attachments_images_translations' => $attachments_images_translations,
    'attachments_heroes_text' => 'Any page/content type can have multiple hero banners. If there is more than one they will be rotated on an hourly basis.',
    'attachments_heroes_translations' => $attachments_heroes_translations,
  ];

  $editable->set('help_comments', $help_comments);
  $editable->save();

  $language_count = count($body_text_translations);
  return t('Added help_comments configuration with default help text values for @count languages.', ['@count' => $language_count]);
}

/**
 * Add field_order to the Search API "content" index.
 */
function bioland_update_9011() {
  // Check if Search API module is enabled.
  if (!\Drupal::moduleHandler()->moduleExists('search_api')) {
    return t('Search API module is not enabled; skipping field_order index addition.');
  }

  // Load the "content" index.
  $index_storage = \Drupal::entityTypeManager()->getStorage('search_api_index');
  $index = $index_storage->load('content');

  if (!$index) {
    return t('Search API index "content" not found; skipping field_order addition.');
  }

  // Check if field_order already exists in the index.
  if ($index->getField('field_order')) {
    return t('field_order already exists in the "content" index.');
  }

  // Add field_order to the index.
  $field = \Drupal::getContainer()
    ->get('search_api.fields_helper')
    ->createField($index, 'field_order', [
      'label' => 'Order',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_order',
      'type' => 'integer',
    ]);

  $index->addField($field);
  $index->save();

  // Note: Reindexing is deferred. Run 'drush sapi-rt content && drush sapi-i content'
  // after all update hooks complete, or it will occur automatically at end of install.

  return t('Added field_order to the Search API "content" index. Run "drush sapi-rt content && drush sapi-i content" to reindex.');
}

/**
 * Helper function to add field_order to the Search API "content" index.
 */
function _bioland_add_field_order_to_search_index() {
  if (_bioland_require_module('search_api', 'field_order index addition')) {
    \Drupal::logger('bioland')->notice('Search API module is not enabled; skipping field_order index addition.');
    return;
  }

  try {
    // Load the "content" index.
    $index_storage = \Drupal::entityTypeManager()->getStorage('search_api_index');
    $index = $index_storage->load('content');

    if (!$index) {
      \Drupal::logger('bioland')->notice('Search API index "content" not found; skipping field_order addition.');
      return;
    }

    // Check if field_order already exists in the index.
    if ($index->getField('field_order')) {
      \Drupal::logger('bioland')->notice('field_order already exists in the "content" index.');
      return;
    }

    // Add field_order to the index.
    $field = \Drupal::getContainer()
      ->get('search_api.fields_helper')
      ->createField($index, 'field_order', [
        'label' => 'Order',
        'datasource_id' => 'entity:node',
        'property_path' => 'field_order',
        'type' => 'integer',
      ]);

    $index->addField($field);
    $index->save();

    // Note: Reindexing is NOT done here - it will be performed as the final
    // step of installation via _bioland_final_reindex() to avoid multiple
    // reindex operations during install.

    \Drupal::logger('bioland')->notice('Added field_order to the Search API "content" index. Reindex will occur at end of install.');
  }
  catch (\Throwable $e) {
    \Drupal::logger('bioland')->error('Failed to add field_order to Search API index: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Create translation defaults for all existing content nodes.
 */
 function bioland_update_9012(&$sandbox) {
  // Check if translation defaults are enabled.
  $config = \Drupal::config('bioland.settings');
  if (!$config->get('translation.auto_create_enabled')) {
    return t('Translation auto-create is not enabled; skipping batch processing.');
  }

  // Initialize sandbox on first run.
  if (!isset($sandbox['progress'])) {
    // Get all content node IDs.
    $query = \Drupal::entityQuery('node')
      ->condition('type', 'content')
      ->accessCheck(FALSE);
    $sandbox['nids'] = $query->execute();
    $sandbox['total'] = count($sandbox['nids']);
    $sandbox['progress'] = 0;
    $sandbox['created'] = 0;
    $sandbox['errors'] = 0;

    if ($sandbox['total'] === 0) {
      $sandbox['#finished'] = 1;
      return t('No content nodes found to process.');
    }
  }

  // Process nodes in batches of 20.
  $batch_size = 20;
  $nids_to_process = array_slice($sandbox['nids'], $sandbox['progress'], $batch_size);

  $translation_manager = \Drupal::service('bioland.translation_manager');
  $storage = \Drupal::entityTypeManager()->getStorage('node');

  foreach ($nids_to_process as $nid) {
    try {
      $node = $storage->load($nid);
      if ($node) {
        $created = $translation_manager->createTranslations($node, 'batch');
        if ($created) {
          $sandbox['created']++;
        }
      }
    }
    catch (\Exception $e) {
      $sandbox['errors']++;
      \Drupal::logger('bioland')->error('Update 9012: Error processing node @nid: @message', [
        '@nid' => $nid,
        '@message' => $e->getMessage(),
      ]);
    }
    $sandbox['progress']++;
  }

  // Calculate progress.
  $sandbox['#finished'] = $sandbox['progress'] / $sandbox['total'];

  // Return status message.
  if ($sandbox['#finished'] >= 1) {
    return t('Processed @total content nodes. Created @created translation defaults. Errors: @errors.', [
      '@total' => $sandbox['total'],
      '@created' => $sandbox['created'],
      '@errors' => $sandbox['errors'],
    ]);
  }

  return t('Processed @progress of @total content nodes...', [
    '@progress' => $sandbox['progress'],
    '@total' => $sandbox['total'],
  ]);
}

/**
 * Configure URL field to use Linkit widget and show language selector.
 *
 * 1. Configure field_url to use linkit_field_widget for URL autocomplete.
 * 2. Show langcode field in the meta sidebar (advanced settings).
 */
function bioland_update_9013() {
  $messages = [];

  // Load the content node form display.
  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.content.default');

  if (!$form_display) {
    return t('Form display node.content.default not found; skipping configuration.');
  }

  $changed = FALSE;

  // 1. Configure field_url to use Linkit widget if Linkit module is enabled.
  if (\Drupal::moduleHandler()->moduleExists('linkit')) {
    $url_component = $form_display->getComponent('field_url');
    if ($url_component) {
      // Use linkit widget with autocomplete for internal/external URLs.
      $form_display->setComponent('field_url', [
        'type' => 'linkit',
        'weight' => $url_component['weight'] ?? 0,
        'settings' => [
          'linkit_profile' => 'default',
          'linkit_auto_link_text' => FALSE,
          'placeholder_url' => '',
          'placeholder_title' => '',
        ],
        'third_party_settings' => [],
      ]);
      $changed = TRUE;
      $messages[] = t('Configured field_url to use Linkit widget.');
    }
    else {
      $messages[] = t('field_url not found in form display; skipping Linkit configuration.');
    }
  }
  else {
    $messages[] = t('Linkit module not enabled; skipping field_url widget configuration.');
  }

  // 2. Show language selector in the meta/sidebar area.
  // The langcode field needs to be visible and in the 'meta' group.
  $langcode_component = $form_display->getComponent('langcode');

  // Set langcode to be visible in the advanced/meta sidebar.
  $form_display->setComponent('langcode', [
    'type' => 'language_select',
    'weight' => $langcode_component['weight'] ?? 5,
    'settings' => [
      'include_locked' => FALSE,
    ],
    'region' => 'content',
    'third_party_settings' => [],
  ]);
  $changed = TRUE;
  $messages[] = t('Language selector is now visible on the form.');

  // Try to add langcode to the meta group if field_group module is available.
  if (\Drupal::moduleHandler()->moduleExists('field_group')) {
    $third_party = $form_display->getThirdPartySettings('field_group');
    
    // Check if there's a meta or advanced group we can add langcode to.
    foreach (['group_meta', 'group_advanced', 'group_sidebar'] as $group_name) {
      if (isset($third_party[$group_name])) {
        $group = $third_party[$group_name];
        if (!in_array('langcode', $group['children'] ?? [])) {
          $group['children'][] = 'langcode';
          $form_display->setThirdPartySetting('field_group', $group_name, $group);
          $messages[] = t('Added langcode to @group.', ['@group' => $group_name]);
          break;
        }
      }
    }
  }

  if ($changed) {
    $form_display->save();
  }

  return implode(' ', $messages);
}

/**
 * Add Promotion Options help message configuration.
 */
function bioland_update_9014() {
  $config_factory = \Drupal::configFactory();
  $editable = $config_factory->getEditable('bioland.settings');

  // Check if promotion_text is already set
  if ($editable->get('help_comments.promotion_text') !== NULL) {
    return t('Promotion options help text already exists; no changes made.');
  }

  // Get all available languages
  $language_manager = \Drupal::languageManager();
  $languages = $language_manager->getLanguages();
  $default_langcode = $language_manager->getDefaultLanguage()->getId();
  
  // Initialize translation array
  $promotion_translations = [];
  foreach ($languages as $langcode => $language) {
    if ($langcode === $default_langcode || $langcode === 'en-x-lolspeak') {
      continue;
    }
    $promotion_translations[$langcode] = '';
  }

  // Set default promotion help text (HTML allowed)
  $promotion_text = '<b>Promoted to front page:</b>
<ul>
<li>Content appears in featured listings, homepage blocks, or "promoted" views</li>
<li>Useful for highlighting important or timely content</li>
<li>Multiple items can be promoted simultaneously</li>
</ul>

<b>Sticky at top of lists:</b>
<ul>
<li>Content stays pinned at the top of content listings</li>
<li>Remains at top regardless of publication date</li>
<li>Multiple sticky items appear before non-sticky content</li>
</ul>

<b>Using both:</b> Content can be both promoted AND sticky for maximum visibility.';

  $editable->set('help_comments.promotion_text', $promotion_text);
  $editable->set('help_comments.promotion_translations', $promotion_translations);
  $editable->save();

  return t('Added Promotion Options help message configuration.');
}

/**
 * Add additional_tags configuration with default content type mappings.
 */
function bioland_update_9015() {
  $config_factory = \Drupal::configFactory();
  $editable = $config_factory->getEditable('bioland.settings');

  // Check if additional_tags is already set
  if ($editable->get('additional_tags.event_status_content_types') !== NULL) {
    return t('Additional tags configuration already exists; no changes made.');
  }

  // Set default additional tags content type mappings
  $editable->set('additional_tags.event_status_content_types', [3]);
  $editable->set('additional_tags.project_status_content_types', [5]);
  $editable->set('additional_tags.organization_types_content_types', [8]);
  $editable->set('additional_tags.ecosystem_types_content_types', [9]);
  $editable->set('additional_tags.document_types_content_types', [12]);
  $editable->save();

  return t('Added additional tags configuration with default content type mappings.');
}

/**
 * Set field format settings to only allow 'full_html' for body, field_description, comment_body.
 *
 * Updates field configuration to restrict allowed text formats to only 'full_html'.
 */
function bioland_update_9016() {
  $messages = _bioland_set_full_html_only_format();
  
  if (!empty($messages)) {
    return t('Updated field configurations to only allow full_html format: @details', [
      '@details' => implode(' ', $messages),
    ]);
  }

  return t('No field configurations were updated.');
}

/**
 * Update existing content to use 'full_html' format for body, field_description, comment_body.
 *
 * Uses direct database queries to avoid entity save issues with translations
 * that have NULL titles.
 */
function bioland_update_9017(&$sandbox) {
  // This update now uses direct database queries via _bioland_update_content_to_full_html()
  // to avoid issues with translations that have NULL titles.
  // The entity-based approach was causing IntegrityConstraintViolation errors
  // when saving nodes with translations that were created without proper title values.
  
  if (!isset($sandbox['#finished'])) {
    $result = _bioland_update_content_to_full_html();
    $sandbox['#finished'] = 1;
    
    return t('Updated @updated text format fields to full_html using direct database queries. Errors: @errors.', [
      '@updated' => $result['updated'],
      '@errors' => $result['errors'],
    ]);
  }
  
  return t('Update already completed.');
}

/**
 * Configure the default Linkit profile on install or update.
 *
 * @version 1.0.30
 */
function bioland_update_9018() {
  if ($skip = _bioland_require_module('linkit', 'profile configuration')) {
    return $skip;
  }

  $result = _bioland_configure_linkit_profile();
  
  if ($result['status'] === 'created') {
    return t('Created and configured default Linkit profile with all matchers.');
  }
  elseif ($result['status'] === 'updated') {
    return t('Updated existing default Linkit profile with Bioland matchers configuration.');
  }
  
  return t('Linkit profile configuration completed: @message', ['@message' => $result['message'] ?? 'No changes needed.']);
}

/**
 * Helper function to configure the default Linkit profile.
 *
 * Creates or updates the default Linkit profile with matchers for:
 * - entity:node (content bundle)
 * - entity:taxonomy_term (system_pages, tags bundles)
 * - entity:media (document, image, remote_video bundles)
 * - external links
 * - email links
 * - entity:comment (comment, comment_media, comment_taxonomy bundles)
 *
 * @return array
 *   Status array with 'status' key ('created', 'updated', or 'error') and optional 'message'.
 */
function _bioland_configure_linkit_profile() {
  if ($skip = _bioland_require_module('linkit', 'Linkit profile configuration')) {
    return ['status' => 'error', 'message' => $skip];
  }

  $config_factory = \Drupal::configFactory();
  $linkit_config = $config_factory->getEditable('linkit.linkit_profile.default');

  // Build matchers from data-driven definition.
  $matchers_config = [];
  foreach (_bioland_get_linkit_matchers() as $matcher) {
    $uuid = \Drupal::service('uuid')->generate();
    $matchers_config[$uuid] = [
      'id' => $matcher['id'],
      'uuid' => $uuid,
      'settings' => $matcher['settings'],
      'weight' => $matcher['weight'],
    ];
  }

  // Check if profile already exists.
  $existing_uuid = $linkit_config->get('uuid');
  $status = 'updated';

  if (empty($existing_uuid)) {
    // Create new profile.
    $status = 'created';
    $linkit_config
      ->set('uuid', \Drupal::service('uuid')->generate())
      ->set('langcode', 'en')
      ->set('status', TRUE)
      ->set('dependencies', ['module' => ['node', 'taxonomy']])
      ->set('label', 'Default')
      ->set('id', 'default')
      ->set('description', 'A default Linkit profile');
  }

  // Set the matchers configuration.
  $linkit_config->set('matchers', $matchers_config);
  $linkit_config->save(TRUE);

  // Configure the editor and filter for Linkit integration.
  _bioland_configure_linkit_editor();

  \Drupal::logger('bioland')->notice('Linkit default profile @status with Bioland matchers configuration.', [
    '@status' => $status,
  ]);

  return ['status' => $status];
}

/**
 * Configure the Full HTML editor and filter to use Linkit.
 *
 * Updates:
 * - editor.editor.full_html: Enables linkit_extension with default profile
 * - filter.format.full_html: Adds linkit filter with title and media_substitution
 *
 * @return array
 *   Status array with 'editor' and 'filter' keys indicating what was configured.
 */
function _bioland_configure_linkit_editor() {
  $config_factory = \Drupal::configFactory();
  $result = ['editor' => FALSE, 'filter' => FALSE];

  // Configure editor.editor.full_html with Linkit extension.
  if (\Drupal::moduleHandler()->moduleExists('editor')) {
    $editor_config = $config_factory->getEditable('editor.editor.full_html');
    
    if ($editor_config->get('editor')) {
      // Get existing settings or create new ones.
      $settings = $editor_config->get('settings') ?: [];
      
      // Add or update the linkit_extension in plugins.
      if (!isset($settings['plugins'])) {
        $settings['plugins'] = [];
      }
      
      $settings['plugins']['linkit_extension'] = [
        'linkit_enabled' => TRUE,
        'linkit_profile' => 'default',
      ];
      
      $editor_config->set('settings', $settings);
      
      // Add linkit to dependencies if not already present.
      $dependencies = $editor_config->get('dependencies') ?: [];
      if (!isset($dependencies['module'])) {
        $dependencies['module'] = [];
      }
      if (!in_array('linkit', $dependencies['module'])) {
        $dependencies['module'][] = 'linkit';
        sort($dependencies['module']);
        $editor_config->set('dependencies', $dependencies);
      }
      
      $editor_config->save(TRUE);
      $result['editor'] = TRUE;
      
      \Drupal::logger('bioland')->notice('Configured editor.editor.full_html with Linkit extension.');
    }
    else {
      \Drupal::logger('bioland')->notice('Editor full_html not found; skipping Linkit editor configuration.');
    }
  }

  // Configure filter.format.full_html with Linkit filter.
  $filter_config = $config_factory->getEditable('filter.format.full_html');
  
  if ($filter_config->get('format')) {
    // Get existing filters or create new array.
    $filters = $filter_config->get('filters') ?: [];
    
    // Add or update the linkit filter.
    $filters['linkit'] = [
      'id' => 'linkit',
      'provider' => 'linkit',
      'status' => TRUE,
      'weight' => 0,
      'settings' => [
        'title' => TRUE,
        'media_substitution' => 'metadata',
      ],
    ];
    
    $filter_config->set('filters', $filters);
    
    // Add linkit to dependencies if not already present.
    $dependencies = $filter_config->get('dependencies') ?: [];
    if (!isset($dependencies['module'])) {
      $dependencies['module'] = [];
    }
    if (!in_array('linkit', $dependencies['module'])) {
      $dependencies['module'][] = 'linkit';
      sort($dependencies['module']);
      $filter_config->set('dependencies', $dependencies);
    }
    
    $filter_config->save(TRUE);
    $result['filter'] = TRUE;
    
    \Drupal::logger('bioland')->notice('Configured filter.format.full_html with Linkit filter.');
  }
  else {
    \Drupal::logger('bioland')->notice('Filter format full_html not found; skipping Linkit filter configuration.');
  }

  return $result;
}

/**
 * Generate a UUID for Linkit matchers.
/**
 * Configure Content type fields: disable translation, remove default dates, configure Linkit widget.
 *
 * 1. Set field_attachments, field_components, field_type_placement, field_tags as non-translatable.
 * 2. Remove default value (today's date) from field_published.
 * 3. Configure field_url to use Linkit widget with auto-populate link text enabled.
 *
 * @version 1.0.30
 */
function bioland_update_9019() {
  $messages = _bioland_configure_content_fields();
  return empty($messages) ? t('Content fields already configured.') : implode(' ', $messages);
}

/**
 * Helper function to configure content fields on install.
 *
 * Sets specific fields as non-translatable, removes field_published default,
 * and configures field_url Linkit widget. Called during install and updates.
 *
 * @return array
 *   Array of status messages.
 */
function _bioland_configure_content_fields() {
  $messages = [];

  // 1. Set specific fields as non-translatable.
  $non_translatable_fields = [
    'field_attachments',
    'field_components',
    'field_type_placement',
    'field_tags',
  ];

  foreach ($non_translatable_fields as $field_name) {
    $field = FieldConfig::loadByName('node', 'content', $field_name);
    if ($field && $field->isTranslatable()) {
      $field->setTranslatable(FALSE);
      $field->save();
      $messages[] = t('Set @field as non-translatable.', ['@field' => $field_name]);
    }
  }

  // 2. Remove default value from field_published.
  $field_published = FieldConfig::loadByName('node', 'content', 'field_published');
  if ($field_published) {
    $default_value = $field_published->getDefaultValueLiteral();
    if (!empty($default_value)) {
      $field_published->setDefaultValue([]);
      $field_published->save();
      $messages[] = t('Removed default value from field_published.');
    }
  }

  // 3. Configure field_url to use Linkit widget with auto-populate link text.
  if (\Drupal::moduleHandler()->moduleExists('linkit')) {
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.content.default');

    if ($form_display) {
      $url_component = $form_display->getComponent('field_url');
      if ($url_component) {
        $form_display->setComponent('field_url', [
          'type' => 'linkit',
          'weight' => $url_component['weight'] ?? 0,
          'settings' => [
            'linkit_profile' => 'default',
            'linkit_auto_link_text' => TRUE,
            'placeholder_url' => '',
            'placeholder_title' => '',
          ],
          'third_party_settings' => $url_component['third_party_settings'] ?? [],
        ]);
        $form_display->save();
        $messages[] = t('Configured field_url with Linkit widget (auto-populate link text enabled).');
      }
    }
  }

  if (!empty($messages)) {
    \Drupal::logger('bioland')->notice('Content field configuration: @messages', [
      '@messages' => implode(' ', $messages),
    ]);
  }

  return $messages;
}

/**
 * Ensure custom roles exist and permissions are granted on existing installations.
 *
 * Creates roles: scbd_staff, site_manager, content_manager, contributor, system.
 * Grants bioland permissions to administrator, site_manager, content_manager, scbd_staff.
 *
 * @version 1.0.30
 */
function bioland_update_9020() {
  $messages = [];

  // Ensure custom roles exist.
  $role_messages = _bioland_ensure_roles_exist(_bioland_get_standard_roles());
  $messages = array_merge($messages, $role_messages);

  // Grant permissions.
  $perm_messages = _bioland_grant_role_permissions(_bioland_get_standard_permission_matrix());
  $messages = array_merge($messages, $perm_messages);

  return empty($messages) ? t('All roles and permissions already configured.') : implode(' ', $messages);
}

