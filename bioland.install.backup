/**
 * Helper function to disable unused JSON API resource endpoints.
 *
 * Disables sensitive configuration and user-related JSON:API endpoints
 * via the jsonapi_extras module to prevent unauthorized access.
 *
 * Disabled endpoints:
 * - facets_facet_source--facets_facet_source: Facets module config entities
 * - facets_facet--facets_facet: Individual facet configurations
 * - jsonapi--jsonapi: Core JSON:API metadata endpoint
 * - jsonapi--jsonapi_index: JSON:API resource listing
 * - language_content_settings--language_content_settings: Translation settings
 * - linkit_profile--linkit_profile: Linkit autocomplete profiles
 * - view--view: Views configurations
 * - search_api_index--search_api_index: Search API index definitions
 * - search_api_task--search_api_task: Search API pending tasks
 * - search_api_server--search_api_server: Search API server connections
 * - mailer_policy--mailer_policy: Symfony Mailer policies
 * - mailer_transport--mailer_transport: Symfony Mailer transports
 * - user_role--user_role: User role definitions
 * - menu--menu: Menu definitions
 * - user--user: User accounts (security-sensitive)
 *
 * @return string
 *   Status message about disabled resources.
 */
function _bioland_disable_jsonapi_resources() {
  // Check if jsonapi_extras module is enabled.
  if ($skip = _bioland_require_module('jsonapi_extras', 'JSON API resource disabling')) {
    return $skip;
  }

  // List of resource types to disable (format: entity_type--bundle).
  $resources_to_disable = [
    'facets_facet_source--facets_facet_source',
    'facets_facet--facets_facet',
    'jsonapi--jsonapi',
    'jsonapi--jsonapi_index',
    'language_content_settings--language_content_settings',
    'linkit_profile--linkit_profile',
    'view--view',
    'search_api_index--search_api_index',
    'search_api_task--search_api_task',
    'search_api_server--search_api_server',
    'mailer_policy--mailer_policy',
    'mailer_transport--mailer_transport',
    'user_role--user_role',
    'menu--menu',
    'user--user',
  ];

  $messages = [];
  $config_factory = \Drupal::configFactory();

  foreach ($resources_to_disable as $resource_type) {
    // Config name format: jsonapi_extras.jsonapi_resource_config.{resource_type}
    $config_id = $resource_type;
    $config_name = 'jsonapi_extras.jsonapi_resource_config.' . $config_id;

    $config = $config_factory->getEditable($config_name);

    // Check if already disabled.
    if ($config->get('disabled') === TRUE) {
      continue;
    }

    // Set the resource as disabled.
    $config->set('id', $config_id);
    $config->set('disabled', TRUE);
    $config->set('path', FALSE);
    $config->set('resourceType', $resource_type);
    $config->set('resourceFields', []);
    $config->save(TRUE);

    $messages[] = t('Disabled JSON API resource: @resource', ['@resource' => $resource_type]);
  }

  if (empty($messages)) {
    return t('All specified JSON API resources were already disabled.');
  }

  return implode("\n", $messages);
}

/**
 * Helper function to configure full_html editor toolbar and image upload.
 *
 * Updates:
 * - image_upload.max_size = 50kb
 * - settings.toolbar.items with comprehensive toolbar configuration
 *
 * @return string
 *   Status messages about configuration.
 */
function _bioland_configure_full_html_editor_toolbar() {
  $messages = [];
  $config_factory = \Drupal::configFactory();

  $editor_config = $config_factory->getEditable('editor.editor.full_html');
  if (!$editor_config || $editor_config->isNew()) {
    return t('editor.editor.full_html not found; skipping editor configuration.');
  }

  try {
    // Get current values for debugging
    $current_max_size = $editor_config->get('image_upload.max_size');
    $current_toolbar = $editor_config->get('settings.toolbar.items');
    
    // Update image upload max size to 50kb.
    $editor_config->set('image_upload.max_size', '50kb');
    $messages[] = t('Set image upload max size to 50kb (was: @old).', [
      '@old' => $current_max_size ?: 'not set',
    ]);

    // Define the new toolbar items.
    $toolbar_items = [
      'bold',
      'underline',
      'italic',
      'link',
      'icon',
      '|',
      'numberedList',
      'bulletedList',
      '|',
      'alignment',
      'indent',
      'outdent',
      '|',
      'insertTable',
      'bootstrapGrid',
      '|',
      'drupalMedia',
      'drupalInsertImage',
      'heading',
      '|',
      'Fullscreen',
      'undo',
      'redo',
      'showBlocks',
      '|',
      'horizontalLine',
      'blockQuote',
      'specialCharacters',
      'code',
      'codeBlock',
      '|',
      'strikethrough',
      'superscript',
      'subscript',
      'removeFormat',
      '|',
      'sourceEditing'
    ];

    $editor_config->set('settings.toolbar.items', $toolbar_items);
    $messages[] = t('Updated full_html editor toolbar configuration with @count items (was: @old).', [
      '@count' => count($toolbar_items),
      '@old' => is_array($current_toolbar) ? count($current_toolbar) : 'not set',
    ]);

    // Save with TRUE to rebuild cache
    $editor_config->save(TRUE);
    
    // Clear render cache and plugin cache to ensure changes take effect
    \Drupal::service('plugin.manager.ckeditor5.plugin')->clearCachedDefinitions();
    \Drupal::cache('render')->invalidateAll();
    
    // Verify the save worked by reloading
    $editor_config_verify = $config_factory->get('editor.editor.full_html');
    $saved_max_size = $editor_config_verify->get('image_upload.max_size');
    $saved_toolbar = $editor_config_verify->get('settings.toolbar.items');
    
    if ($saved_max_size === '50kb' && is_array($saved_toolbar) && count($saved_toolbar) === count($toolbar_items)) {
      $messages[] = t('✓ Verified: Changes saved successfully.');
      \Drupal::logger('bioland')->notice('Updated editor.editor.full_html with new toolbar and 50kb image limit - VERIFIED.');
    }
    else {
      $messages[] = t('⚠ Warning: Save verification failed. Max size: @size, Toolbar items: @items', [
        '@size' => $saved_max_size ?: 'not saved',
        '@items' => is_array($saved_toolbar) ? count($saved_toolbar) : 'not saved',
      ]);
      \Drupal::logger('bioland')->warning('editor.editor.full_html changes may not have persisted. Max size: @size, Toolbar: @toolbar', [
        '@size' => $saved_max_size,
        '@toolbar' => is_array($saved_toolbar) ? count($saved_toolbar) : 'null',
      ]);
    }
  }
  catch (\Exception $e) {
    $error_msg = t('Error saving editor configuration: @message', ['@message' => $e->getMessage()]);
    $messages[] = $error_msg;
    \Drupal::logger('bioland')->error('Failed to configure editor.editor.full_html: @message', [
      '@message' => $e->getMessage(),
    ]);
  }

  return implode("\n", $messages);
}

/**
 * Helper function to enable Main Menu Lock and remove permissions.
 *
 * Sets main_menu_lock to TRUE and removes "administer main menu items"
 * permission from scbd_staff and site_manager roles.
 *
 * @return string
 *   Status message.
 */
function _bioland_enable_main_menu_lock() {
  $messages = [];
  
  // Set main_menu_lock to TRUE in config.
  $config = \Drupal::configFactory()->getEditable('bioland.settings');
  $config->set('main_menu_lock', TRUE);
  $config->save(TRUE);
  $messages[] = t('Enabled Main Menu Lock in configuration.');
  
  // Remove "administer main menu items" permission from specific roles.
  $permission = 'administer main menu items';
  $roles_to_lock = ['scbd_staff', 'site_manager'];
  
  try {
    $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');
    
    foreach ($roles_to_lock as $role_id) {
      $role = $role_storage->load($role_id);
      
      if ($role) {
        if ($role->hasPermission($permission)) {
          $role->revokePermission($permission);
          $role->save();
          $messages[] = t('Removed "@permission" permission from @role role.', [
            '@permission' => $permission,
            '@role' => $role_id,
          ]);
          \Drupal::logger('bioland')->info('Main Menu Lock: Removed "@permission" from @role.', [
            '@permission' => $permission,
            '@role' => $role_id,
          ]);
        }
        else {
          $messages[] = t('Role @role does not have "@permission" permission (already removed).', [
            '@role' => $role_id,
            '@permission' => $permission,
          ]);
        }
      }
      else {
        $messages[] = t('Role @role not found, skipping permission removal.', [
          '@role' => $role_id,
        ]);
        \Drupal::logger('bioland')->warning('Main Menu Lock: Role @role not found.', [
          '@role' => $role_id,
        ]);
      }
    }
  }
  catch (\Exception $e) {
    $messages[] = t('Error managing Main Menu Lock permissions: @message', [
      '@message' => $e->getMessage(),
    ]);
    \Drupal::logger('bioland')->error('Main Menu Lock error: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
  
  return implode("\n", $messages);
}

/**
 * Enable Main Menu Lock feature and remove main menu permissions from specific roles.
 */
function bioland_update_9040() {
  return _bioland_enable_main_menu_lock();
}

/**
 * Helper function to configure content type weights for /node/add page ordering.
 *
 * Sets weight values to control the order of content types on the /node/add page.
 * Lower weight values appear first.
 *
 * @return string
 *   Status message.
 */
function _bioland_configure_content_type_weights() {
  $messages = [];
  $config_factory = \Drupal::configFactory();

  // Define content type weights (lower = appears first on /node/add)
  $weights = [
    'content' => -10,  // Site Content - appears first
    'forum' => 0,      // Forum topic - appears second
  ];

  foreach ($weights as $type => $weight) {
    $config = $config_factory->getEditable('node.type.' . $type);
    
    if (!$config->isNew()) {
      $config->set('weight', $weight);
      $config->save(TRUE);
      $messages[] = t('Set weight @weight for @type content type.', [
        '@weight' => $weight,
        '@type' => $type,
      ]);
    }
    else {
      $messages[] = t('Content type @type not found, skipping weight configuration.', [
        '@type' => $type,
      ]);
    }
  }

  if (empty($messages)) {
    return t('No content type weights configured.');
  }

  return implode("\n", $messages);
}

/**
 * Configure content type weights for /node/add page ordering.
 */
function bioland_update_9041() {
  return _bioland_configure_content_type_weights();
}

