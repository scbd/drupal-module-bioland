    ],
  ]);

  // Get all installed languages on the site.
  $languages = \Drupal::languageManager()->getLanguages();
  $language_ids = array_keys($languages);

  // Set datasource settings.
  $config->set('datasource_settings', [
    'entity:node' => [
      'bundles' => [
        'default' => FALSE,
        'selected' => ['content'],
      ],
      'languages' => [
        'default' => FALSE,
        'selected' => array_values($language_ids),
      ],
    ],
  ]);

  // Set processor settings.
  $config->set('processor_settings', [
    'add_url' => [],
    'aggregated_field' => [],
    'content_access' => [
      'weights' => ['preprocess_query' => -30],
    ],
    'custom_value' => [],
    'entity_type' => [],
    'html_filter' => [
      'weights' => [
        'preprocess_index' => -15,
        'preprocess_query' => -15,
      ],
      'all_fields' => FALSE,
      'fields' => ['body'],
      'title' => FALSE,
      'alt' => FALSE,
      'tags' => [
        'b' => 2.0,
        'h1' => 5.0,
        'h2' => 3.0,
        'h3' => 2.0,
        'strong' => 2.0,
      ],
    ],
    'ignorecase' => [
      'weights' => [
        'preprocess_index' => -20,
        'preprocess_query' => -20,
      ],
      'all_fields' => TRUE,
      'fields' => ['body', 'field_tags', 'language', 'title'],
    ],
    'language_with_fallback' => [],
    'rendered_item' => [],
    'reverse_entity_references' => [],
    'role_access' => [
      'weights' => ['preprocess_query' => -30],
    ],
    'stemmer' => [
      'weights' => [
        'preprocess_index' => 0,
        'preprocess_query' => 0,
      ],
      'all_fields' => TRUE,
      'fields' => ['body', 'field_tags', 'title'],
      'exceptions' => [
        'mexican' => 'mexic',
        'texan' => 'texa',
      ],
    ],
    'stopwords' => [
      'weights' => [
        'preprocess_index' => -5,
        'preprocess_query' => -2,
      ],
      'all_fields' => TRUE,
      'fields' => ['body', 'field_tags', 'title'],
      'stopwords' => [
        'a', 'an', 'and', 'are', 'as', 'at', 'be', 'but', 'by', 'for',
        'if', 'in', 'into', 'is', 'it', 'no', 'not', 'of', 'on', 'or',
        's', 'such', 't', 'that', 'the', 'their', 'then', 'there',
        'these', 'they', 'this', 'to', 'was', 'will', 'with',
      ],
    ],
    'tokenizer' => [
      'weights' => [
        'preprocess_index' => -6,
        'preprocess_query' => -6,
      ],
      'all_fields' => TRUE,
      'fields' => ['body', 'field_tags', 'title'],
      'spaces' => '',
      'ignored' => '._-',
      'overlap_cjk' => 1,
      'minimum_word_size' => '2',
    ],
    'transliteration' => [
      'weights' => [
        'preprocess_index' => -20,
        'preprocess_query' => -20,
      ],
      'all_fields' => TRUE,
