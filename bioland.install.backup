/**
 * Helper function to provision users from environment variables.
 *
 * Handles creation and management of:
 * - E2E test users (env var: E2E_USERS)
 * - Bioland training users (env var: BIOLAND_USERS)
 * - Training users (env var: TRAINING_USERS)
 * - Legacy users to block
 * - SCBD staff users (individual env vars: AR, FV, DM, AP)
 * - Administrator users (individual env vars: RG, RH, RE, BF, VG, SB, API_USER)
 *
 * @return string
 *   Status messages about user provisioning.
 */
function _bioland_provision_users() {
  $messages = [];
  $user_storage = \Drupal::entityTypeManager()->getStorage('user');

  // 1. E2E test users - create or update with E2E_USERS password.
  $e2e_password = getenv('E2E_USERS');
  if ($e2e_password) {
    $e2e_users = [
      'e2e-authenticated@chm-cbd.net' => ['system'],
      'e2e-contributor@chm-cbd.net' => ['system', 'contributor'],
      'e2e-content-manager@chm-cbd.net' => ['system', 'content_manager'],
      'e2e-site-manager@chm-cbd.net' => ['system', 'site_manager'],
      'e2e-scbd-staff@chm-cbd.net' => ['system', 'scbd_staff'],
    ];

    foreach ($e2e_users as $email => $roles) {
      $result = _bioland_create_or_update_user($user_storage, $email, $roles, $e2e_password);
      if ($result) {
        $messages[] = $result;
      }
    }
  }
  else {
    $messages[] = t('E2E_USERS env var not set; skipping E2E user creation.');
  }

  // 2. Bioland users - create or update with BIOLAND_USERS password.
  $bioland_password = getenv('BIOLAND_USERS');
  if ($bioland_password) {
    $bioland_users = [
      'bioland-contributor@chm-cbd.net' => ['system', 'contributor'],
      'bioland-cm@chm-cbd.net' => ['system', 'content_manager'],
      'bioland-sm@chm-cbd.net' => ['system', 'site_manager'],
      'bioland-scbd@chm-cbd.net' => ['system', 'scbd_staff'],
      'bioland@chm-cbd.net' => ['system'],
    ];

    foreach ($bioland_users as $email => $roles) {
      $result = _bioland_create_or_update_user($user_storage, $email, $roles, $bioland_password);
      if ($result) {
        $messages[] = $result;
      }
    }
  }
  else {
    $messages[] = t('BIOLAND_USERS env var not set; skipping Bioland user creation.');
  }

  // 3. Training users - create or update with TRAINING_USERS password.
  $training_password = getenv('TRAINING_USERS');
  if ($training_password) {
    $training_users = [
      'training-contributor@chm-cbd.net' => ['system', 'contributor'],
      'training-cm@chm-cbd.net' => ['system', 'content_manager'],
      'training-sm@chm-cbd.net' => ['system', 'site_manager'],
      'training@chm-cbd.net' => ['system'],
    ];

    foreach ($training_users as $email => $roles) {
      $result = _bioland_create_or_update_user($user_storage, $email, $roles, $training_password);
      if ($result) {
        $messages[] = $result;
      }
    }
  }
  else {
    $messages[] = t('TRAINING_USERS env var not set; skipping training user creation.');
  }

  // 4. Legacy users to block - if exists, set to system role only and block.
  $legacy_users_to_block = [
    'anastasia_yb@hotmail.com',
    'randy@houlahan.ca',
    'support@chm-cbd.net',
    'arafalov+cm@gmail.com',
    'alexandre.rafalovitch@cbd.int',
    'it@cbd.int',
    'ray.goh@cbd.int',
  ];

  foreach ($legacy_users_to_block as $email) {
    $result = _bioland_block_legacy_user($user_storage, $email);
    if ($result) {
      $messages[] = $result;
    }
  }

  // 5. SCBD staff users - create or update with scbd_staff role.
  $scbd_staff_users = [
    'alexandre.rafalovitch@un.org' => 'AR',
    'frederic.vogel@un.org' => 'FV',
    'djessy.monnier@un.org' => 'DM',
    'abhinav.prakash@un.org' => 'AP',
  ];

  foreach ($scbd_staff_users as $email => $env_var) {
    $password = getenv($env_var);
    if ($password) {
      $result = _bioland_create_or_update_user($user_storage, $email, ['scbd_staff'], $password);
      if ($result) {
        $messages[] = $result;
      }
    }
    else {
      $messages[] = t('@env_var env var not set; skipping @email.', [
        '@env_var' => $env_var,
        '@email' => $email,
      ]);
    }
  }

  // 6. Administrator users - create or update with administrator role.
  $admin_users = [
    'ray.goh@un.org' => 'RG',
    'randy.houlahan@un.org' => 'RH',
    'rodrigo.elias@un.org' => 'RE',
    'blaise.fonseca@un.org' => 'BF',
    'vince.gopez@un.org' => 'VG',
    'stephane.bilodeau@un.org' => 'SB',
    'api-user@chm-cbd.net' => 'API_USER',
  ];

  foreach ($admin_users as $email => $env_var) {
    $password = getenv($env_var);
    if ($password) {
      $result = _bioland_create_or_update_user($user_storage, $email, ['administrator'], $password);
      if ($result) {
        $messages[] = $result;
      }
    }
    else {
      $messages[] = t('@env_var env var not set; skipping @email.', [
        '@env_var' => $env_var,
        '@email' => $email,
      ]);
    }
  }

  // 7. Grant scbd_staff role to all @un.org users.
  $un_org_result = _bioland_grant_scbd_staff_to_un_org_users($user_storage);
  if ($un_org_result) {
    $messages[] = $un_org_result;
  }

  if (empty($messages)) {
    return t('No user provisioning actions taken.');
  }

  \Drupal::logger('bioland')->notice('User provisioning: @messages', [
    '@messages' => implode(' ', $messages),
  ]);

  return implode(' ', $messages);
}

/**
 * Create a user if they don't exist.
 *
 * @param \Drupal\Core\Entity\EntityStorageInterface $user_storage
 *   The user entity storage.
 * @param string $email
 *   The user email (also used as username and name).
 * @param array $roles
 *   Array of role IDs to assign.
 * @param string $password
 *   The password to set.
 *
 * @return string|null
 *   Status message or NULL if user already exists.
 */
function _bioland_create_user_if_not_exists($user_storage, $email, array $roles, $password) {
  return _bioland_manage_user($user_storage, $email, $roles, $password, 'create_only');
}

/**
 * Grant scbd_staff role to all users with @un.org email addresses.
 *
 * @param \Drupal\user\UserStorageInterface $user_storage
 *   The user storage service.
 *
 * @return string|null
 *   Status message or NULL if no actions taken.
 */
function _bioland_grant_scbd_staff_to_un_org_users($user_storage) {
  // Check if scbd_staff role exists.
  if (!Role::load('scbd_staff')) {
    return NULL;
  }

  $count = 0;
  $updated_users = [];

  // Load all active users.
  $query = $user_storage->getQuery()
    ->condition('status', 1)
    ->accessCheck(FALSE);
  $uids = $query->execute();

  foreach ($user_storage->loadMultiple($uids) as $user) {
    $email = $user->getEmail();
    
    // Check if email ends with @un.org.
    if ($email && preg_match('/@un\.org$/i', $email)) {
      if (!$user->hasRole('scbd_staff')) {
        $user->addRole('scbd_staff');
        $user->save();
        $updated_users[] = $email;
        $count++;
      }
    }
  }

  if ($count > 0) {
    return t('Granted scbd_staff role to @count @un.org user(s): @users', [
      '@count' => $count,
      '@users' => implode(', ', $updated_users),
    ]);
  }

  return NULL;
}

/**
 * Block a legacy user and set to system role only.
 *
 * @param \Drupal\Core\Entity\EntityStorageInterface $user_storage
 *   The user entity storage.
 * @param string $email
 *   The user email to block.
 *
 * @return string|null
 *   Status message or NULL if user doesn't exist.
 */
function _bioland_block_legacy_user($user_storage, $email) {
  return _bioland_manage_user($user_storage, $email, [], '', 'block');
}

/**
 * Create or update a user with specific roles and password.
 *
 * @param \Drupal\Core\Entity\EntityStorageInterface $user_storage
 *   The user entity storage.
 * @param string $email
 *   The user email (also used as username and name).
 * @param array $roles
 *   Array of role IDs to assign (replaces existing roles).
 * @param string $password
 *   The password to set.
 *
 * @return string
 *   Status message.
 */
function _bioland_create_or_update_user($user_storage, $email, array $roles, $password) {
  return _bioland_manage_user($user_storage, $email, $roles, $password, 'create_or_update');
}

/**
 * Configure full_html text format with Linkit integration and disable basic_html.
 *
 * @version 1.0.30
 */
function bioland_update_9022() {
  return _bioland_configure_full_html_format();
}

/**
 * Helper function to configure full_html text format.
 *
 * - Adds Linkit extension to editor.editor.full_html
 * - Sets image upload max size to 250kb
 * - Adds Linkit filter to filter.format.full_html
 * - Grants scbd_staff access to full_html format
 * - Disables basic_html editor
 *
 * @return string
 *   Status messages about configuration.
 */
function _bioland_configure_full_html_format() {
  if ($skip = _bioland_require_module('linkit', 'full_html configuration')) {
    return $skip;
  }

  $messages = [];
  $config_factory = \Drupal::configFactory();

  // 1. Configure editor.editor.full_html - Add Linkit extension and update image upload.
  $editor_config = $config_factory->getEditable('editor.editor.full_html');
  if ($editor_config && !$editor_config->isNew()) {
    $settings = $editor_config->get('settings') ?: [];

    // Add linkit_extension to plugins.
    if (!isset($settings['plugins']['linkit_extension'])) {
      $settings['plugins']['linkit_extension'] = [
        'linkit_enabled' => TRUE,
        'linkit_profile' => 'default',
      ];
      $messages[] = t('Added Linkit extension to full_html editor.');
    }

    // Update image upload max size.
    if (!isset($settings['plugins']['ckeditor5_imageUpload'])) {
      $settings['plugins']['ckeditor5_imageUpload'] = [];
    }
    $settings['plugins']['ckeditor5_imageUpload']['max_size'] = '250kb';
    $messages[] = t('Set image upload max size to 250kb.');

    $editor_config->set('settings', $settings);
    $editor_config->save(TRUE);
  }
  else {
    $messages[] = t('editor.editor.full_html not found; skipping editor configuration.');
  }

  // 2. Configure filter.format.full_html - Add Linkit filter and dependencies.
  $filter_config = $config_factory->getEditable('filter.format.full_html');
  if ($filter_config && !$filter_config->isNew()) {
    // Add linkit to module dependencies.
    $dependencies = $filter_config->get('dependencies') ?: [];
    $modules = $dependencies['module'] ?? [];
    
    $required_modules = ['editor', 'linkit', 'media'];
    $changed = FALSE;
    foreach ($required_modules as $module) {
      if (!in_array($module, $modules)) {
        $modules[] = $module;
        $changed = TRUE;
      }
    }
    
    if ($changed) {
      sort($modules);
      $dependencies['module'] = array_values($modules);
      $filter_config->set('dependencies', $dependencies);
      $messages[] = t('Added linkit and media to full_html dependencies.');
    }

    // Add linkit filter.
    $filters = $filter_config->get('filters') ?: [];
    if (!isset($filters['linkit'])) {
      $filters['linkit'] = [
        'id' => 'linkit',
        'provider' => 'linkit',
        'status' => TRUE,
        'weight' => 0,
        'settings' => [
          'title' => TRUE,
        ],
      ];
      $filter_config->set('filters', $filters);
      $messages[] = t('Added Linkit filter to full_html format.');
    }

    // Add scbd_staff role permission.
    $roles = $filter_config->get('roles') ?: [];
    if (!in_array('scbd_staff', $roles)) {
      $roles[] = 'scbd_staff';
      $filter_config->set('roles', $roles);
      $messages[] = t('Granted scbd_staff access to full_html format.');
    }

    $filter_config->save(TRUE);
  }
  else {
    $messages[] = t('filter.format.full_html not found; skipping filter configuration.');
  }

  // 3. Also grant permission via role entity for use text format.
  $scbd_staff = Role::load('scbd_staff');
  if ($scbd_staff) {
    if (!$scbd_staff->hasPermission('use text format full_html')) {
      $scbd_staff->grantPermission('use text format full_html');
      $scbd_staff->save();
      $messages[] = t('Granted "use text format full_html" permission to scbd_staff role.');
    }
  }

  // 4. Disable basic_html editor.
  $basic_editor = $config_factory->getEditable('editor.editor.basic_html');
  if ($basic_editor && !$basic_editor->isNew()) {
    $status = $basic_editor->get('status');
    if ($status !== FALSE) {
      $basic_editor->set('status', FALSE);
      $basic_editor->save();
      $messages[] = t('Disabled basic_html editor.');
    }
  }
  else {
    $messages[] = t('editor.editor.basic_html not found; skipping disable.');
  }

  if (empty($messages)) {
    return t('full_html format already configured.');
  }

  \Drupal::logger('bioland')->notice('full_html configuration: @messages', [
    '@messages' => implode(' ', $messages),
  ]);

  return implode(' ', $messages);
}

/**
 * Sync scbd_staff permissions with site_manager role.
 *
 * @version 1.0.30
 */
function bioland_update_9045() {
  return _bioland_sync_scbd_staff_permissions();
}

/**
 * Helper function to sync scbd_staff permissions with site_manager.
 *
 * Copies all permissions from site_manager role to scbd_staff role,
 * ensuring scbd_staff has equivalent access.
 *
 * @return string
 *   Status message about permissions sync.
 */
function _bioland_sync_scbd_staff_permissions() {
  $site_manager = Role::load('site_manager');
  $scbd_staff = Role::load('scbd_staff');

  if (!$site_manager) {
    return t('site_manager role not found; cannot sync permissions.');
  }

  if (!$scbd_staff) {
    return t('scbd_staff role not found; cannot sync permissions.');
  }

  $site_manager_permissions = $site_manager->getPermissions();
  $scbd_staff_permissions = $scbd_staff->getPermissions();

  $added_count = 0;
  foreach ($site_manager_permissions as $permission) {
    if (!in_array($permission, $scbd_staff_permissions)) {
      $scbd_staff->grantPermission($permission);
      $added_count++;
    }
  }

  if ($added_count > 0) {
    $scbd_staff->save();
    \Drupal::logger('bioland')->notice('Synced @count permissions from site_manager to scbd_staff.', [
      '@count' => $added_count,
    ]);
    return t('Added @count permissions to scbd_staff (synced with site_manager).', ['@count' => $added_count]);
  }

  return t('scbd_staff already has all site_manager permissions.');
}

/**
 * Update region and continent from DMSM API.
 *
 * Fetches and populates region and continent config values from DMSM API
 * based on the current hostname.
 *
 * @version 1.0.36
 */
function bioland_update_9046() {
  try {
    // Use the existing helper function to update from DMSM API.
    $result = _bioland_update_countries_from_dmsm();
    
    if ($result) {
      // If there was an error message, return it.
      return $result;
    }
    
    // Get the config to check what was populated.
    $config = \Drupal::config('bioland.settings');
    $region = $config->get('region');
    $continent = $config->get('continent');
    
    $updates = [];
    if ($region) {
      $updates[] = t('region: @region', ['@region' => $region]);
    }
    if ($continent) {
      $updates[] = t('continent: @continent', ['@continent' => $continent]);
    }
    
    if (!empty($updates)) {
      return t('Successfully updated from DMSM API: @updates', ['@updates' => implode(', ', $updates)]);
    }
    
    return t('DMSM API call succeeded but region/continent not found in response.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->warning('Could not update region/continent from DMSM API: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Could not fetch region/continent from DMSM API: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Block legacy @cbd.int users and configure Search API index and facets.
 *
 * @version 1.0.30
 */
function bioland_update_9025() {
  $messages = [];

  // 1. Block @cbd.int users (except randy.houlahan@cbd.int).
  $result = _bioland_block_cbd_int_users();
  if ($result) {
    $messages[] = $result;
  }

  // 2. Configure Search API content index.
  $result = _bioland_configure_search_api_index();
  if ($result) {
    $messages[] = $result;
  }

  // 3. Configure facets.
  $result = _bioland_configure_facets();
  if ($result) {
    $messages[] = $result;
  }

  return implode(' ', $messages);
}

/**
 * Helper function to block @cbd.int users except excluded ones.
 *
 * Finds all users with @cbd.int email domain (except randy.houlahan@cbd.int),
 * assigns them the system role, removes other roles, and blocks them.
 *
 * @return string
 *   Status message.
 */
function _bioland_block_cbd_int_users() {
  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  $excluded_emails = ['randy.houlahan@cbd.int'];

  // Find all users with @cbd.int email.
  $query = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('mail', '%@cbd.int', 'LIKE');
  $uids = $query->execute();

  if (empty($uids)) {
    return t('No @cbd.int users found.');
  }

  $blocked_count = 0;
  $users = $user_storage->loadMultiple($uids);

  foreach ($users as $user) {
    $email = $user->getEmail();

    // Skip excluded emails.
    if (in_array($email, $excluded_emails)) {
      continue;
    }

    // Skip user 1 (super admin).
    if ((int) $user->id() === 1) {
      continue;
    }

    // Remove all roles except authenticated.
    $current_roles = $user->getRoles(TRUE);
    foreach ($current_roles as $role_id) {
      $user->removeRole($role_id);
    }

    // Add system role.
    if (Role::load('system')) {
      $user->addRole('system');
    }

    // Block the user.
    $user->block();
    $user->save();
    $blocked_count++;
  }

  if ($blocked_count > 0) {
    \Drupal::logger('bioland')->notice('Blocked @count @cbd.int users.', ['@count' => $blocked_count]);
    return t('Blocked @count @cbd.int users (set to system role).', ['@count' => $blocked_count]);
  }

  return t('No @cbd.int users needed blocking.');
}

/**
 * Helper function to configure Search API content index.
 *
 * @return string
 *   Status message.
 */
function _bioland_configure_search_api_index() {
  if ($skip = _bioland_require_module('search_api', 'index configuration')) {
    return $skip;
  }

  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('search_api.index.content');

  if ($config->isNew()) {
    return t('search_api.index.content not found; skipping.');
  }

  // Load the index entity to check and control its state.
  $index_storage = \Drupal::entityTypeManager()->getStorage('search_api_index');
  $index = $index_storage->load('content');

  // Track whether we set read_only to avoid issues on restore.
  $set_read_only = FALSE;
  $original_read_only = FALSE;

  if ($index) {
    // Store original read_only state.
    $original_read_only = $index->isReadOnly();

    // Temporarily set index to read_only to prevent backend fieldsUpdated()
    // calls during config save. This avoids TRUNCATE errors on non-existent
    // tables when adding fields like langcode.
    if (!$original_read_only) {
      $index->set('read_only', TRUE);
      // Save without triggering hooks to minimize side effects.
      $index->save();
      $set_read_only = TRUE;
    }
  }

  // Get the site's default language.
  $default_langcode = \Drupal::languageManager()->getDefaultLanguage()->getId();

  // Set langcode to default.
  $config->set('langcode', $default_langcode);
  $config->set('status', TRUE);

  // Set dependencies.
  $config->set('dependencies', [
    'config' => [
      'field.storage.node.body',
      'field.storage.node.field_end_date',
      'field.storage.node.field_order',
      'field.storage.node.field_published',
      'field.storage.node.field_start_date',
      'field.storage.node.field_tags',
      'field.storage.node.field_type_placement',
      'search_api.server.file_index',
    ],
    'module' => ['node'],
  ]);

  // Set field settings.
  $config->set('field_settings', [
    'body' => [
      'label' => 'Body',
      'datasource_id' => 'entity:node',
      'property_path' => 'body',
      'type' => 'text',
      'boost' => 13.0,
      'dependencies' => [
        'config' => ['field.storage.node.body'],
      ],
    ],
    'changed' => [
      'label' => 'Changed',
      'datasource_id' => 'entity:node',
      'property_path' => 'changed',
      'type' => 'date',
      'dependencies' => [
        'module' => ['node'],
      ],
    ],
    'field_end_date' => [
      'label' => 'End Date',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_end_date',
      'type' => 'date',
      'dependencies' => [
        'config' => ['field.storage.node.field_end_date'],
      ],
    ],
    'field_order' => [
      'label' => 'Order',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_order',
      'type' => 'integer',
      'dependencies' => [
        'config' => ['field.storage.node.field_order'],
      ],
    ],
    'field_published' => [
      'label' => 'Published Date',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_published',
      'type' => 'date',
      'dependencies' => [
        'config' => ['field.storage.node.field_published'],
      ],
    ],
    'field_start_date' => [
      'label' => 'Start Date',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_start_date',
      'type' => 'date',
      'dependencies' => [
        'config' => ['field.storage.node.field_start_date'],
      ],
    ],
    'field_tags' => [
      'label' => 'Tags',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_tags',
      'type' => 'text',
      'dependencies' => [
        'config' => ['field.storage.node.field_tags'],
      ],
    ],
    'language' => [
      'label' => 'Language (with fallback)',
      'property_path' => 'language_with_fallback',
      'type' => 'string',
    ],
    'node_grants' => [
      'label' => 'Node access information',
      'property_path' => 'search_api_node_grants',
      'type' => 'string',
      'indexed_locked' => TRUE,
      'type_locked' => TRUE,
      'hidden' => TRUE,
    ],
    'promote' => [
      'label' => 'Promoted to front page',
      'datasource_id' => 'entity:node',
      'property_path' => 'promote',
      'type' => 'boolean',
      'dependencies' => [
        'module' => ['node'],
      ],
    ],
    'role_access' => [
      'label' => 'Role-based access information',
      'property_path' => 'search_api_role_access',
      'type' => 'string',
      'indexed_locked' => TRUE,
      'type_locked' => TRUE,
      'hidden' => TRUE,
    ],
    'status' => [
      'label' => 'Boolean',
      'datasource_id' => 'entity:node',
      'property_path' => 'status',
      'type' => 'boolean',
      'indexed_locked' => TRUE,
      'type_locked' => TRUE,
      'dependencies' => [
        'module' => ['node'],
      ],
    ],
    'sticky' => [
      'label' => 'Sticky at top of lists',
      'datasource_id' => 'entity:node',
      'property_path' => 'sticky',
      'type' => 'boolean',
      'dependencies' => [
        'module' => ['node'],
      ],
    ],
    'tid' => [
      'label' => 'Content Type',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_type_placement',
      'type' => 'integer',
      'dependencies' => [
        'config' => ['field.storage.node.field_type_placement'],
      ],
    ],
    'title' => [
      'label' => 'Title',
      'datasource_id' => 'entity:node',
      'property_path' => 'title',
      'type' => 'text',
      'boost' => 21.0,
      'dependencies' => [
        'module' => ['node'],
      ],
    ],
    'uid' => [
      'label' => 'Entity reference',
      'datasource_id' => 'entity:node',
      'property_path' => 'uid',
      'type' => 'integer',
      'indexed_locked' => TRUE,
      'type_locked' => TRUE,
