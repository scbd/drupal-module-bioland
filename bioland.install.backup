}

/**
 * Ensure Search API database tables exist before performing operations.
 *
 * Checks if required Search API DB backend tables exist and creates them
 * if missing. This prevents errors when field configuration changes trigger
 * TRUNCATE operations on non-existent tables.
 *
 * @param \Drupal\search_api\IndexInterface $index
 *   The search index to check.
 *
 * @return bool
 *   TRUE if all required tables exist or were created, FALSE on failure.
 */
function _bioland_ensure_search_api_tables_exist($index) {
  if (!$index) {
    return FALSE;
  }

  try {
    $database = \Drupal::database();
    $schema = $database->schema();
    
    // Check if the main index table exists.
    $index_table = 'search_api_db_content';
    if (!$schema->tableExists($index_table)) {
      \Drupal::logger('bioland')->notice('Search API table @table does not exist yet; will be created on first index.', [
        '@table' => $index_table,
      ]);
      // This is expected for fresh installs - tables are created when the
      // server's fieldsUpdated() method is called. We return TRUE because
      // this is not an error condition.
      return TRUE;
    }

    // Check for common field tables that might be referenced.
    $field_tables = [
      'search_api_db_content_langcode',
      'search_api_db_content_field_tags',
      'search_api_db_content_title',
      'search_api_db_content_body',
    ];

    $missing_tables = [];
    foreach ($field_tables as $table) {
      if (!$schema->tableExists($table)) {
        $missing_tables[] = $table;
      }
    }

    if (!empty($missing_tables)) {
      \Drupal::logger('bioland')->notice('Some Search API field tables do not exist: @tables. They will be created during indexing.', [
        '@tables' => implode(', ', $missing_tables),
      ]);
      // Return TRUE as tables will be created by the backend when needed.
      return TRUE;
    }

    return TRUE;
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Error checking Search API tables: @message', [
      '@message' => $e->getMessage(),
    ]);
    return FALSE;
  }
}

/**
 * Clear all pending Search API server tasks without executing them.
 *
 * This is used before restoring an index to prevent fieldsUpdated() calls
 * that would fail on non-existent tables. The field tables will be properly
 * created during the subsequent reindex operation.
 *
 * @return string
 *   Status message.
 */
function _bioland_clear_pending_search_api_tasks() {
  if ($skip = _bioland_require_module('search_api', 'clear pending tasks')) {
    return $skip;
  }

  try {
    // Get the task manager service.
    if (!\Drupal::hasService('search_api.server_task_manager')) {
      return t('Search API task manager service not available.');
    }

    $task_manager = \Drupal::service('search_api.server_task_manager');

    // Load the server.
    $server_storage = \Drupal::entityTypeManager()->getStorage('search_api_server');
    $server = $server_storage->load('file_index');

    if (!$server) {
      return t('Search API server "file_index" not found.');
    }

    // Check for and delete pending tasks.
    $pending_count = $task_manager->getCount($server);

    if ($pending_count > 0) {
      $task_manager->delete($server);
      \Drupal::logger('bioland')->notice('Cleared @count pending Search API tasks to allow clean reindex.', [
        '@count' => $pending_count,
      ]);
      return t('Cleared @count pending Search API tasks.', ['@count' => $pending_count]);
    }

    return t('No pending Search API tasks to clear.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->warning('Error clearing Search API tasks: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Warning: Error clearing Search API tasks: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Execute any pending Search API server tasks.
 *
 * Clears pending tasks that might cause errors when executed during
 * install/update operations (like truncating non-existent tables).
 *
 * @return string
 *   Status message.
 */
function _bioland_execute_pending_search_api_tasks() {
  if ($skip = _bioland_require_module('search_api', 'pending tasks')) {
    return $skip;
  }

  try {
    $database = \Drupal::database();
    $schema = $database->schema();
    
    // Check if search_api_task table exists.
    if (!$schema->tableExists('search_api_task')) {
      return t('Search API task table does not exist; no pending tasks.');
    }

    // Get the task manager service.
    if (!\Drupal::hasService('search_api.server_task_manager')) {
      return t('Search API task manager service not available.');
    }

    $task_manager = \Drupal::service('search_api.server_task_manager');
    
    // Load the server.
    $server_storage = \Drupal::entityTypeManager()->getStorage('search_api_server');
    $server = $server_storage->load('file_index');
    
    if (!$server) {
      return t('Search API server "file_index" not found.');
    }

    // Check for pending tasks and handle them safely.
    $pending_count = $task_manager->getCount($server);
    
    if ($pending_count > 0) {
      \Drupal::logger('bioland')->notice('Found @count pending Search API tasks.', [
        '@count' => $pending_count,
      ]);
      
      // Try to execute tasks, but catch errors for missing tables.
      try {
        $task_manager->execute($server);
        \Drupal::logger('bioland')->notice('Executed @count pending Search API tasks.', [
          '@count' => $pending_count,
        ]);
      }
      catch (\Exception $task_error) {
        // If task execution fails due to missing tables, delete the tasks
        // instead of leaving them to cause repeated errors.
        $error_message = $task_error->getMessage();
        if (strpos($error_message, 'Base table or view not found') !== FALSE) {
          $task_manager->delete($server);
          \Drupal::logger('bioland')->warning('Cleared @count pending Search API tasks due to missing tables: @message', [
            '@count' => $pending_count,
            '@message' => $error_message,
          ]);
        }
        else {
          throw $task_error;
        }
      }
    }

    return t('Processed Search API pending tasks.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->warning('Error processing Search API tasks: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Warning: Error processing Search API tasks: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Pause immediate indexing on the Search API content index.
 *
 * Called at the start of install to prevent indexing during configuration.
 * Sets index_directly to FALSE so content changes don't trigger immediate indexing.
 * The option will be restored by _bioland_final_reindex() at the end.
 *
 * @return string
 *   Status message.
 */
function _bioland_disable_search_index() {
  if ($skip = _bioland_require_module('search_api', 'pause indexing')) {
    return $skip;
  }

  try {
    $index_storage = \Drupal::entityTypeManager()->getStorage('search_api_index');
    $index = $index_storage->load('content');

    if (!$index) {
      return t('Search API index "content" not found; skipping pause.');
    }

    // Turn off immediate indexing instead of disabling the index entirely.
    // This avoids entity state issues when re-enabling.
    $index->setOption('index_directly', FALSE);
    $index->save();
    \Drupal::logger('bioland')->notice('Paused immediate indexing on Search API content index during install.');

    return t('Search API content index: immediate indexing paused.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->warning('Could not pause Search API indexing: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Warning: Could not pause indexing: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Final reindex step - MUST be called at the end of install/update.
 *
 * Restores immediate indexing, rebuilds tracking information,
 * and indexes all items. This is the ONLY place where reindexing should be
 * triggered during install to avoid multiple redundant reindex operations.
 *
 * @return string
 *   Status message.
 */
function _bioland_final_reindex() {
  if ($skip = _bioland_require_module('search_api', 'final reindex')) {
    return $skip;
  }

  try {
    // Clear caches to ensure all field definitions are loaded.
    // This is critical when fields were just created during install.
    \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
    drupal_flush_all_caches();

    $index_storage = \Drupal::entityTypeManager()->getStorage('search_api_index');
    $index = $index_storage->load('content');

    if (!$index) {
      \Drupal::logger('bioland')->notice('Search API index "content" not found; skipping final reindex.');
      return t('Search API index "content" not found; skipping final reindex.');
    }

    // Ensure Search API database tables exist before operations.
    // This prevents errors when truncating tables that don't exist yet.
    $tables_ready = _bioland_ensure_search_api_tables_exist($index);
    if (!$tables_ready) {
      \Drupal::logger('bioland')->warning('Search API tables not ready; skipping reindex.');
      return t('Search API tables not ready; skipping reindex.');
    }

    // Clear pending server tasks BEFORE restoring the index.
    // This prevents $index->save() from triggering fieldsUpdated() on
    // non-existent tables. The tables will be created properly during reindex.
    _bioland_clear_pending_search_api_tasks();

    // Restore immediate indexing (was paused at start of install).
    $index->setOption('index_directly', TRUE);
    $index->save();
    \Drupal::logger('bioland')->notice('Restored immediate indexing on Search API content index.');

    // Rebuild tracking information.
    $index->rebuildTracker();

    // Mark all items for reindexing.
    $index->reindex();

    // Perform the actual indexing (-1 means no limit).
    $indexed = $index->indexItems(-1);

    $message = t('Final reindex complete: restored immediate indexing, rebuilt tracking, and indexed @count items.', [
      '@count' => $indexed,
    ]);
    \Drupal::logger('bioland')->notice($message);
    return $message;
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Error during final reindex: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error during final reindex: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Helper function to rebuild Search API index tracking.
 *
 * Clears and rebuilds tracking information for the content index,
 * marking all items for re-indexing.
 *
 * @return string
 *   Status message.
 */
function _bioland_rebuild_search_index_tracking() {
  if ($skip = _bioland_require_module('search_api', 'tracking rebuild')) {
    return $skip;
  }

  try {
    $index_storage = \Drupal::entityTypeManager()->getStorage('search_api_index');
    $index = $index_storage->load('content');

    if (!$index) {
      return t('Search API index "content" not found; skipping tracking rebuild.');
    }

    // Clear all tracking data and rebuild.
    $index->rebuildTracker();

    \Drupal::logger('bioland')->notice('Rebuilt tracking information for Search API content index.');
    return t('Rebuilt tracking information for Search API content index.');
  }
  catch (\Exception $e) {
    \Drupal::logger('bioland')->error('Error rebuilding Search API tracking: @message', [
      '@message' => $e->getMessage(),
    ]);
    return t('Error rebuilding tracking: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Helper function to configure facets.
 *
 * Configures facet source and content_type/language facets, removes others.
 *
 * @return string
 *   Status message.
 */
function _bioland_configure_facets() {
  if ($skip = _bioland_require_module('facets', 'facet configuration')) {
    return $skip;
  }

  $config_factory = \Drupal::configFactory();
  $messages = [];
  $default_langcode = \Drupal::languageManager()->getDefaultLanguage()->getId();

  // 1. Configure facet source.
  $facet_source = $config_factory->getEditable('facets.facet_source.jsonapi_search_api_facets__content');
  if (!$facet_source->isNew()) {
    $facet_source->set('langcode', $default_langcode);
    $facet_source->set('status', TRUE);
    $facet_source->set('id', 'jsonapi_search_api_facets__content');
    $facet_source->set('name', 'jsonapi_search_api_facets:content');
    $facet_source->set('filter_key', 'filter');
    $facet_source->set('url_processor', 'json_api');
    $facet_source->set('breadcrumb', [
      'active' => FALSE,
      'before' => TRUE,
      'group' => FALSE,
    ]);
    $facet_source->save(TRUE);
    $messages[] = t('Configured facet source.');
  }

  // Get shared processor configs used by all facets.
  $processor_configs = _bioland_get_facet_processor_configs();

  // Define facet configurations.
  $facets = [
    'content_type' => [
      'name' => 'Content Type',
      'field_identifier' => 'tid',
      'only_visible_when_facet_source_is_visible' => FALSE,
    ],
    'language' => [
      'name' => 'Language',
      'field_identifier' => 'language',
      'only_visible_when_facet_source_is_visible' => TRUE,
    ],
  ];

  // Configure each facet.
  foreach ($facets as $facet_id => $facet_settings) {
    $facet_config = $config_factory->getEditable('facets.facet.' . $facet_id);
    $facet_config->set('langcode', $default_langcode);
    $facet_config->set('status', TRUE);
    $facet_config->set('dependencies', ['module' => ['jsonapi_search_api_facets']]);
    $facet_config->set('id', $facet_id);
    $facet_config->set('name', $facet_settings['name']);
    $facet_config->set('weight', 0);
    $facet_config->set('min_count', 1);
    $facet_config->set('missing', FALSE);
    $facet_config->set('missing_label', 'others');
    $facet_config->set('url_alias', $facet_id);
    $facet_config->set('facet_source_id', 'jsonapi_search_api_facets:content');
    $facet_config->set('field_identifier', $facet_settings['field_identifier']);
    $facet_config->set('query_operator', 'or');
    $facet_config->set('hard_limit', 0);
    $facet_config->set('exclude', FALSE);
    $facet_config->set('use_hierarchy', FALSE);
    $facet_config->set('keep_hierarchy_parents_active', FALSE);
    $facet_config->set('hierarchy', ['type' => 'taxonomy', 'config' => []]);
    $facet_config->set('expand_hierarchy', FALSE);
    $facet_config->set('enable_parent_when_child_gets_disabled', TRUE);
    $facet_config->set('widget', ['type' => 'jsonapi_search_api', 'config' => ['show_numbers' => TRUE]]);
    $facet_config->set('empty_behavior', ['behavior' => 'none']);
    $facet_config->set('only_visible_when_facet_source_is_visible', $facet_settings['only_visible_when_facet_source_is_visible']);
    $facet_config->set('show_only_one_result', FALSE);
    $facet_config->set('show_title', FALSE);
    $facet_config->set('processor_configs', $processor_configs);
    $facet_config->save(TRUE);
    $messages[] = t('Configured @name facet.', ['@name' => $facet_settings['name']]);
  }

  // 4. Remove other facets (keep only content_type and language).
  $allowed_facets = array_keys($facets);
  $facet_configs = $config_factory->listAll('facets.facet.');

  foreach ($facet_configs as $config_name) {
    $facet_id = str_replace('facets.facet.', '', $config_name);
    if (!in_array($facet_id, $allowed_facets)) {
      $config_factory->getEditable($config_name)->delete();
      $messages[] = t('Removed facet: @id.', ['@id' => $facet_id]);
    }
  }

  return implode(' ', $messages);
}

/**
 * Get shared processor configs for facets.
 *
 * @return array
 *   Processor configuration array.
 */
function _bioland_get_facet_processor_configs() {
  return [
    'active_widget_order' => [
      'processor_id' => 'active_widget_order',
      'weights' => ['sort' => 20],
      'settings' => ['sort' => 'DESC'],
    ],
    'count_widget_order' => [
      'processor_id' => 'count_widget_order',
      'weights' => ['sort' => 30],
      'settings' => ['sort' => 'DESC'],
    ],
    'display_value_widget_order' => [
      'processor_id' => 'display_value_widget_order',
      'weights' => ['sort' => 40],
      'settings' => ['sort' => 'ASC'],
    ],
    'hierarchy_processor' => [
      'processor_id' => 'hierarchy_processor',
      'weights' => ['build' => 100],
      'settings' => [],
    ],
    'url_processor_handler' => [
      'processor_id' => 'url_processor_handler',
      'weights' => ['pre_query' => 50, 'build' => 15],
      'settings' => [],
    ],
  ];
}

/**
 * Add langcode field to content form sidebar.
 *
 * @version 1.0.30
 */
function bioland_update_9026() {
  return _bioland_configure_langcode_form_display();
}

/**
 * Helper function to configure langcode field on content form display.
 *
 * Adds the langcode field to the content node form with label "Language",
 * placed in the sidebar (advanced group) and collapsed by default.
 * Also enables language_alterable setting for the content node type.
 *
 * @return string
 *   Status message.
 */
function _bioland_configure_langcode_form_display() {
  $messages = [];
  
  // First, enable language_alterable for content node type.
  $config_factory = \Drupal::configFactory();
  $language_config = $config_factory->getEditable('language.content_settings.node.content');
  
  if (!$language_config->isNew()) {
    $language_config->set('language_alterable', TRUE);
    $language_config->save(TRUE);
    $messages[] = 'Enabled language_alterable for content node type.';
    \Drupal::logger('bioland')->notice('Enabled language_alterable for content node type.');
  }
  
  $entity_form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('node.content.default');

  if (!$entity_form_display) {
    return t('Form display node.content.default not found; skipping langcode configuration.');
  }

  // Add langcode field to the form display.
  // Use the language_select widget which is the standard for langcode fields.
  $entity_form_display->setComponent('langcode', [
    'type' => 'language_select',
    'weight' => 11, // After field_order (weight 10)
    'region' => 'content',
    'settings' => [
      'include_locked' => TRUE,
    ],
    'third_party_settings' => [],
  ]);

  $entity_form_display->save();
  $messages[] = 'Added langcode field to content form display.';

  // Now configure the field_group if the module is available.
  // The langcode field should be in a collapsible group in the sidebar.
  if (\Drupal::moduleHandler()->moduleExists('field_group')) {
    $form_display_config = $config_factory->getEditable('core.entity_form_display.node.content.default');

    if (!$form_display_config->isNew()) {
      $third_party = $form_display_config->get('third_party_settings') ?: [];

      // Create a language group if it doesn't exist.
      if (!isset($third_party['field_group']['group_language'])) {
        $third_party['field_group']['group_language'] = [
          'label' => 'Language',
          'children' => ['langcode'],
          'parent_name' => '',
          'weight' => 99, // Near the end of sidebar
          'format_type' => 'details_sidebar',
          'format_settings' => [
            'classes' => '',
            'show_empty_fields' => FALSE,
            'id' => '',
            'open' => FALSE, // Collapsed by default
            'description' => '',
            'required_fields' => FALSE,
            'weight' => 0,
          ],
          'region' => 'content',
        ];

        $form_display_config->set('third_party_settings', $third_party);
        $form_display_config->save(TRUE);
        $messages[] = 'Added langcode field to content form in collapsible Language group.';
        \Drupal::logger('bioland')->notice('Added langcode field to content form in collapsible Language group.');
      }
      else {
        // Ensure langcode is in the group.
        $children = $third_party['field_group']['group_language']['children'] ?? [];
        if (!in_array('langcode', $children)) {
          $third_party['field_group']['group_language']['children'][] = 'langcode';
          $form_display_config->set('third_party_settings', $third_party);
          $form_display_config->save(TRUE);
          $messages[] = 'Added langcode to existing Language group.';
        }
        else {
          $messages[] = 'Langcode already in Language group.';
        }
      }
    }
  }
  else {
    $messages[] = 'Field_group module not available for sidebar placement.';
  }

  return implode(' ', $messages);
}

/**
 * Enable language alterable for content node type.
 */
function bioland_update_9027() {
  return _bioland_configure_langcode_form_display();
}

/**
 * Configure available menus for content type.
 */
function bioland_update_9028() {
  return _bioland_configure_content_type_available_menus();
}

/**
 * Configure content type taxonomy terms.
 */
function bioland_update_9029() {
  return _bioland_configure_content_types();
}

/**
 * Helper function to configure available menus for content type.
 *
 * Sets the available menus for the 'content' node type.
 * Only applies to BL2 sites (where is_biosafety_land = false).
 *
 * @return string
 *   Status message.
 */
function _bioland_configure_content_type_available_menus() {
  // Only configure menus for BL2 sites (is_biosafety_land = false).
  $config_factory = \Drupal::configFactory();
  $bioland_config = $config_factory->get('bioland.settings');
  $is_biosafety_land = $bioland_config->get('is_biosafety_land');
  
  if ($is_biosafety_land !== FALSE) {
    return t('Skipping menu configuration - not a BL2 site.');
  }
  
  $node_type_config = $config_factory->getEditable('node.type.content');
  
  if ($node_type_config->isNew()) {
    return t('Content node type not found; skipping menu configuration.');
  }
  
  // Available menus for BL2 sites.
  $available_menus = [
    'biodiversity-facts',
    'convention-protocols',
    'cooperation',
    'footer',
    'footer-credits',
    'implementation',
    'news-updates',
    'resources',
    'our-targets',
  ];
  
  // Set the available menus in third_party_settings.
  $node_type_config->set('third_party_settings.menu_ui.available_menus', $available_menus);
  $node_type_config->save(TRUE);
  
  $menu_list = implode(', ', $available_menus);
  \Drupal::logger('bioland')->notice('Configured available menus for content type (BL2): @menus', [
    '@menus' => $menu_list,
  ]);
  
  return t('Configured @count available menus for content type (BL2): @menus', [
    '@count' => count($available_menus),
    '@menus' => $menu_list,
  ]);
}

/**
 * Helper function to configure content type taxonomy terms.
 *
 * Creates or updates taxonomy terms in the 'tags' vocabulary to match
 * the predefined content types. Preserves term IDs and marks new terms as disabled.
 *
 * @return string
 *   Status message.
 */
function _bioland_configure_content_types() {
  $content_types = [
    ['tid' => 2, 'name' => 'News', 'field_plural' => 'News', 'icon' => '📰'],
    ['tid' => 3, 'name' => 'Event', 'field_plural' => 'Events', 'icon' => '📅'],
    ['tid' => 4, 'name' => 'Learning Resource', 'field_plural' => 'Learning Resources', 'icon' => '🎓'],
    ['tid' => 5, 'name' => 'Project', 'field_plural' => 'Projects', 'icon' => '📊'],
    ['tid' => 6, 'name' => 'Basic Page', 'field_plural' => 'Basic Pages', 'icon' => '📄'],
    ['tid' => 54, 'name' => 'Article', 'field_plural' => 'Articles', 'icon' => '📄'],
    ['tid' => 8, 'name' => 'Government Ministry or Institute', 'field_plural' => 'Government Ministries or Institutes', 'icon' => '🏛️'],
    ['tid' => 9, 'name' => 'Ecosystem', 'field_plural' => 'Ecosystems', 'icon' => '🌍'],
    ['tid' => 10, 'name' => 'Protected Area', 'field_plural' => 'Protected Areas', 'icon' => '🏞️'],
    ['tid' => 11, 'name' => 'Biodiversity Data', 'field_plural' => 'Biodiversity Data', 'icon' => '📈'],
    ['tid' => 12, 'name' => 'Document', 'field_plural' => 'Documents', 'icon' => '📋'],
    ['tid' => 13, 'name' => 'Related Website', 'field_plural' => 'Related Websites', 'icon' => '🔗'],
    ['tid' => 15, 'name' => 'Other', 'field_plural' => 'Others', 'icon' => '⚙️'],
    ['tid' => 16, 'name' => 'Image or Video', 'field_plural' => 'Images or Videos', 'icon' => '🎬'],
    ['tid' => 55, 'name' => 'Other Resource', 'field_plural' => 'Other Resources', 'icon' => '⚙️'],
    ['tid' => 43, 'name' => 'FAQ', 'field_plural' => 'FAQs', 'icon' => '❓'],
    ['tid' => 44, 'name' => 'National Information', 'field_plural' => 'National Informations', 'icon' => '🏴'],
    ['tid' => 45, 'name' => 'Status of LMO', 'field_plural' => 'Status of LMOs', 'icon' => '🧬'],
    ['tid' => 46, 'name' => 'Field Trial', 'field_plural' => 'Field Trials', 'icon' => '🌱'],
    ['tid' => 47, 'name' => 'National Mainstreaming Strategy', 'field_plural' => 'National Mainstreaming Strategies', 'icon' => '🗂️'],
    ['tid' => 48, 'name' => 'Capacity Building', 'field_plural' => 'Capacity Building', 'icon' => '🔧'],
    ['tid' => 49, 'name' => 'Announcement', 'field_plural' => 'Announcements', 'icon' => '📢'],
    ['tid' => 50, 'name' => 'Contact', 'field_plural' => 'Contacts', 'icon' => '📞'],
  ];

  $created = 0;
  $updated = 0;
  $errors = 0;

  foreach ($content_types as $content_type) {
    try {
      // Try to load existing term by tid.
      $term = \Drupal::entityTypeManager()
        ->getStorage('taxonomy_term')
        ->load($content_type['tid']);

      $is_new = FALSE;
      
      if (!$term) {
        // Create new term with specific tid.
        $term = \Drupal::entityTypeManager()
          ->getStorage('taxonomy_term')
          ->create([
            'vid' => 'tags',
            'tid' => $content_type['tid'],
            'status' => 0, // Mark new terms as disabled.
          ]);
        $is_new = TRUE;
      }

      // Update term fields.
      $term->setName($content_type['name']);
      
      // Set custom fields if they exist.
      if ($term->hasField('field_plural')) {
        $term->set('field_plural', $content_type['field_plural']);
      }
      
      if ($term->hasField('field_icon')) {
        $term->set('field_icon', $content_type['icon']);
      }
      
      // Ensure new terms are ALWAYS disabled (status = 0).
      // This applies to newly created terms only - existing terms keep their
      // current status to preserve admin-enabled content types.
      if ($is_new) {
        $term->set('status', 0);
        \Drupal::logger('bioland')->notice('Setting new term @tid (@name) to disabled status.', [
          '@tid' => $content_type['tid'],
          '@name' => $content_type['name'],
        ]);
      }
      
      $term->save();
      
      if ($is_new) {
        $created++;
        \Drupal::logger('bioland')->notice('Created taxonomy term @tid: @name (disabled)', [
          '@tid' => $content_type['tid'],
          '@name' => $content_type['name'],
        ]);
      }
      else {
        $updated++;
      }
    }
    catch (\Exception $e) {
      $errors++;
      \Drupal::logger('bioland')->error('Error configuring taxonomy term @tid (@name): @message', [
        '@tid' => $content_type['tid'],
        '@name' => $content_type['name'],
        '@message' => $e->getMessage(),
      ]);
    }
  }

  $message = t('Configured content type taxonomy terms: @created created (disabled), @updated updated, @errors errors.', [
    '@created' => $created,
    '@updated' => $updated,
    '@errors' => $errors,
  ]);
  
  \Drupal::logger('bioland')->notice($message);
  
  return $message;
}

/**
 * Configure content type taxonomy term status based on site type.
 *
 * Enables/disables taxonomy terms in the 'tags' vocabulary based on whether
 * the site is a Biosafety Land instance or a BL2 (Bioland) instance.
 *
 * - Biosafety Land sites: Disable BL2-specific terms (4, 6, 8, 9, 10, 11, 15)
 * - BL2 sites: Disable Biosafety-specific terms (55, 43, 44, 45, 46, 47, 48, 49, 50)
 *
 * @return string
 *   Status message.
 */
function _bioland_configure_content_type_status_by_site_type() {
  // Get the is_biosafety_land setting.
  $config = \Drupal::config('bioland.settings');
  $is_biosafety_land = $config->get('is_biosafety_land') ?: FALSE;

  // BL2-specific content types (disable on Biosafety Land sites).
  $bl2_content_types = [
    4,  // Learning Resource
    6,  // Basic Page
    8,  // Government Ministry or Institute
    9,  // Ecosystem
    10, // Protected Area
    11, // Biodiversity Data
    15, // Other
  ];

  // Biosafety-specific content types (disable on BL2 sites).
  $biosafety_content_types = [
    55, // Other Resource
    43, // FAQ
    44, // National Information
    45, // Status of LMO
    46, // Field Trial
    47, // National Mainstreaming Strategy
    48, // Capacity Building
    49, // Announcement
    50, // Contact
  ];

  // Determine which terms to enable and disable.
  if ($is_biosafety_land) {
    $terms_to_disable = $bl2_content_types;
    $terms_to_enable = $biosafety_content_types;
    $site_type = 'Biosafety Land';
  }
  else {
    $terms_to_disable = $biosafety_content_types;
    $terms_to_enable = $bl2_content_types;
    $site_type = 'BL2 (Bioland)';
  }

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $disabled_count = 0;
  $enabled_count = 0;
  $errors = 0;

  // Disable terms not applicable to this site type.
  foreach ($terms_to_disable as $tid) {
    try {
      $term = $term_storage->load($tid);
      if ($term && $term->get('status')->value != 0) {
        $term->set('status', 0);
        $term->save();
        $disabled_count++;
        \Drupal::logger('bioland')->notice('Disabled content type term @tid (@name) for @site_type site.', [
          '@tid' => $tid,
          '@name' => $term->label(),
          '@site_type' => $site_type,
        ]);
      }
    }
    catch (\Exception $e) {
      $errors++;
      \Drupal::logger('bioland')->error('Error disabling term @tid: @message', [
        '@tid' => $tid,
        '@message' => $e->getMessage(),
      ]);
    }
  }

  // Enable terms applicable to this site type.
  foreach ($terms_to_enable as $tid) {
    try {
      $term = $term_storage->load($tid);
      if ($term && $term->get('status')->value != 1) {
        $term->set('status', 1);
        $term->save();
        $enabled_count++;
        \Drupal::logger('bioland')->notice('Enabled content type term @tid (@name) for @site_type site.', [
          '@tid' => $tid,
          '@name' => $term->label(),
          '@site_type' => $site_type,
        ]);
      }
    }
    catch (\Exception $e) {
      $errors++;
      \Drupal::logger('bioland')->error('Error enabling term @tid: @message', [
        '@tid' => $tid,
        '@message' => $e->getMessage(),
      ]);
    }
  }

  $message = t('Configured content type terms for @site_type: @enabled enabled, @disabled disabled, @errors errors.', [
    '@site_type' => $site_type,
    '@enabled' => $enabled_count,
    '@disabled' => $disabled_count,
    '@errors' => $errors,
  ]);

  \Drupal::logger('bioland')->notice($message);

  return $message;
}

/**
 * Configure system_pages search taxonomy terms.
 *
 * Creates "Biosafety Clearing-House Search" and "Access And Benefit-sharing
 * Clearing-house Search" terms with proper parent relationships.
 *
 * @return string
 *   Status message.
 */
function _bioland_configure_system_pages_search_terms() {
  $messages = [];
  $created = 0;
  $updated = 0;
  $errors = 0;
  
  // First ensure parent term exists (tid 23 should exist).
  $parent_term = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->load(23);
  
  if (!$parent_term) {
    return t('Parent term tid 23 not found. Cannot create search terms.');
  }
  
  // Define the search terms with their parent relationships.
  $search_terms = [
    [
      'tid' => 52,
      'name' => 'Biosafety Clearing-House Search',
      'parent' => 23,
    ],
    [
      'tid' => 53,
      'name' => 'Access And Benefit-sharing Clearing-house Search',
      'parent' => 52, // Parent is the BCH Search term
    ],
  ];
  
  foreach ($search_terms as $term_data) {
    try {
      // Try to load existing term by tid.
      $term = \Drupal::entityTypeManager()
        ->getStorage('taxonomy_term')
        ->load($term_data['tid']);
      
      $is_new = FALSE;
      
      if (!$term) {
        // Create new term with specific tid.
        $term = \Drupal::entityTypeManager()
          ->getStorage('taxonomy_term')
          ->create([
            'vid' => 'system_pages',
            'tid' => $term_data['tid'],
            'status' => 1, // Published
          ]);
        $is_new = TRUE;
      }
      
      // Update term fields.
      $term->setName($term_data['name']);
      
      // Set parent relationship.
      if (isset($term_data['parent'])) {
        // Load parent to verify it exists.
        $parent = \Drupal::entityTypeManager()
          ->getStorage('taxonomy_term')
          ->load($term_data['parent']);
        
        if ($parent) {
          $term->set('parent', [['target_id' => $term_data['parent']]]);
        }
      }
      
      $term->save();
      
      if ($is_new) {
        $created++;
        $messages[] = t('Created system_pages term @tid: @name', [
          '@tid' => $term_data['tid'],
          '@name' => $term_data['name'],
        ]);
      }
      else {
        $updated++;
        $messages[] = t('Updated system_pages term @tid: @name', [
          '@tid' => $term_data['tid'],
          '@name' => $term_data['name'],
        ]);
      }
    }
    catch (\Exception $e) {
      $errors++;
      $messages[] = t('Error configuring system_pages term @tid (@name): @message', [
        '@tid' => $term_data['tid'],
        '@name' => $term_data['name'],
        '@message' => $e->getMessage(),
      ]);
      \Drupal::logger('bioland')->error('Error configuring system_pages term @tid: @message', [
        '@tid' => $term_data['tid'],
        '@message' => $e->getMessage(),
      ]);
    }
  }
  
  $summary = t('System pages search terms: @created created, @updated updated, @errors errors.', [
    '@created' => $created,
    '@updated' => $updated,
    '@errors' => $errors,
  ]);
  
  if (!empty($messages)) {
    \Drupal::logger('bioland')->notice($summary . ' ' . implode(' ', $messages));
  }
  
  return $summary;
}

/**
 * Ensure all bioland users have the system role.
 */
function bioland_update_9030() {
  $messages = [];
  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  
  // Define bioland users that should have the system role.
  $bioland_users = [
    'bioland-contributor@chm-cbd.net' => ['system', 'contributor'],
    'bioland-cm@chm-cbd.net' => ['system', 'content_manager'],
    'bioland-sm@chm-cbd.net' => ['system', 'site_manager'],
    'bioland-scbd@chm-cbd.net' => ['system', 'scbd_staff'],
    'bioland@chm-cbd.net' => ['system'],
  ];
  
  foreach ($bioland_users as $email => $expected_roles) {
    $users = $user_storage->loadByProperties(['mail' => $email]);
    if ($user = reset($users)) {
      $changed = FALSE;
      foreach ($expected_roles as $role) {
        if (!$user->hasRole($role)) {
          $user->addRole($role);
          $changed = TRUE;
        }
      }
      
      if ($changed) {
        $user->save();
        $messages[] = t('Added missing roles to user @email', ['@email' => $email]);
      }
      else {
        $messages[] = t('User @email already has all required roles', ['@email' => $email]);
      }
    }
    else {
      $messages[] = t('User @email does not exist (skipped)', ['@email' => $email]);
    }
  }
  
  return implode("\n", $messages);
}

